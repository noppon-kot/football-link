<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DERNSAI.com – รวบรวมรายการฟุตบอล ช่วยจัดตารางแข่งขัน และตารางคะแนน" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% share_title = if defined?(@tournament) && @tournament.present?
                      @tournament.title
                    else
                      "DERNSAI"
                    end %>
    <% share_description = if defined?(@tournament) && @tournament.present?
                            parts = []
                            parts << tournament_competition_date_label(@tournament) if respond_to?(:tournament_competition_date_label)
                            parts << @tournament.location_name if @tournament.respond_to?(:location_name)
                            parts << truncate(strip_tags(@tournament.description.to_s), length: 140) if @tournament.respond_to?(:description)
                            parts.compact.reject(&:blank?).join(" · ")
                          else
                            "รวมรายการฟุตบอล ช่วยจัดตารางแข่งขัน และตารางคะแนน"
                          end %>
    <% share_url = request.original_url %>
    <% share_image_url = begin
        if defined?(@tournament) && @tournament.present? && @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="DERNSAI">
    <meta property="og:title" content="<%= share_title %>">
    <meta property="og:description" content="<%= share_description %>">
    <meta property="og:url" content="<%= share_url %>">
    <meta property="og:image" content="<%= share_image_url %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= share_title %>">
    <meta name="twitter:description" content="<%= share_description %>">
    <meta name="twitter:image" content="<%= share_image_url %>">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%= asset_path "dernsai_icon.png" %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path "dernsai_icon.png" %>">

    <!-- Bootstrap 5 CSS via CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Bootstrap 5 JS bundle (for navbar toggle) -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"></script>
  </head>

  <body class="theme-green">
    <div style="max-width:960px;margin:0 auto;">
      <div class="ls-topbar">
        <button type="button" class="ls-icon-btn ls-icon-btn--left" data-bs-toggle="offcanvas" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-label="เมนู">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <%= link_to root_path, class: "ls-brand", style: "text-decoration:none;" do %>
          <%= image_tag "dernsai_ban.png", alt: "DERNSAI", class: "ls-brand-img" %>
        <% end %>

        <button type="button" class="ls-icon-btn ls-icon-btn--search" data-bs-toggle="offcanvas" data-bs-target="#searchDrawer" aria-controls="searchDrawer" aria-label="ค้นหา">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M10.5 3a7.5 7.5 0 105.2 12.9l3.4 3.4 1.4-1.4-3.4-3.4A7.5 7.5 0 0010.5 3zm0 2a5.5 5.5 0 110 11 5.5 5.5 0 010-11z" fill="currentColor"/>
          </svg>
        </button>
      </div>

      <% if defined?(@tournament) && @tournament.present? && @tournament.persisted? %>
        <% can_manage_tournament = can_edit_tournament?(@tournament) %>
        <% pro_enabled = admin? || @tournament.pro? || @tournament.competition_data_present? %>
        <% has_teams = @tournament.team_registrations.exists? %>
        <% has_groups = Group.joins(:tournament_division).where(tournament_divisions: { tournament_id: @tournament.id }).exists? %>
        <% has_matches = Match.joins(:tournament_division).where(tournament_divisions: { tournament_id: @tournament.id }).exists? %>

        <nav class="ls-subnav" aria-label="Tournament navigation">
          <div class="ls-subnav-scroll">
            <%= link_to "Info", tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(tournament_path(@tournament))}" %>

            <% if can_manage_tournament || @tournament.free? || has_teams %>
              <%= link_to "Team", teams_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(teams_tournament_path(@tournament))}" %>
            <% end %>

            <% if can_manage_tournament %>
              <% if pro_enabled %>
                <%= link_to "Group", groups_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(groups_tournament_path(@tournament))}" %>
                <%= link_to "Fixtures", fixture_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(fixture_tournament_path(@tournament))}" %>
                <%= link_to "Table", table_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(table_tournament_path(@tournament))}" %>
              <% else %>
                <a class="ls-subnav-link is-disabled" href="#" data-bs-toggle="modal" data-bs-target="#planUpgradeModal">Group</a>
                <a class="ls-subnav-link is-disabled" href="#" data-bs-toggle="modal" data-bs-target="#planUpgradeModal">Fixtures</a>
                <a class="ls-subnav-link is-disabled" href="#" data-bs-toggle="modal" data-bs-target="#planUpgradeModal">Table</a>
              <% end %>
            <% else %>
              <% if has_groups %>
                <%= link_to "Group", groups_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(groups_tournament_path(@tournament))}" %>
              <% end %>
              <% if has_matches %>
                <%= link_to "Fixtures", fixture_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(fixture_tournament_path(@tournament))}" %>
                <%= link_to "Table", table_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(table_tournament_path(@tournament))}" %>
              <% end %>
            <% end %>
          </div>
        </nav>

        <% if can_manage_tournament && !pro_enabled %>
          <div class="modal fade" id="planUpgradeModal" tabindex="-1" aria-labelledby="planUpgradeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content" style="background:#111315;color:#ffffff;border:1px solid rgba(255,255,255,0.10);">
                <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.10);">
                  <h5 class="modal-title" id="planUpgradeModalLabel" style="font-size:16px;">ฟีเจอร์สำหรับแพ็กเกจ Pro</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="font-size:14px;">
                  แพ็กเกจฟรีใช้งานได้เฉพาะ <strong>Info</strong> และ <strong>Team</strong> เท่านั้น
                  <div class="text-muted" style="font-size:12px;margin-top:6px;">
                    ต้องการใช้งาน Group / Fixtures / Table กรุณาอัปเกรดเป็นแพ็กเกจ Pro
                  </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.10);">
                  <%= link_to "ดูรายละเอียดแพ็กเกจ", package_tournament_path(@tournament), class: "btn btn-light" %>
                  <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">ปิด</button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="offcanvas offcanvas-start" tabindex="-1" id="mainMenu" aria-labelledby="mainMenuLabel" style="width:320px;">
        <div class="offcanvas-header" style="background:#111315;color:#ffffff;">
          <h5 class="offcanvas-title" id="mainMenuLabel" style="font-size:16px;">เมนู</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" style="background:#0f1113;color:#ffffff;">
          <div class="d-flex flex-column" style="gap:10px;">
            <%= link_to "รายการแข่งขันทั้งหมด", root_path, class: "ls-drawer-link" %>

            <% if can_create_tournaments? %>
              <%= link_to "รายการของฉัน", mytournaments_path, class: "ls-drawer-link" %>
            <% end %>

            <%= link_to "เพิ่มรายการแข่ง", new_tournament_path, class: "ls-drawer-link" %>

            <% if defined?(@tournament) && @tournament.present? && @tournament.persisted? %>
              <div style="height:1px;background:rgba(255,255,255,0.08);"></div>

              <% show_my_tab = current_user.present? && (
                TeamRegistrationManager.joins(:team_registration).where(team_registrations: { tournament_id: @tournament.id }, user_id: current_user.id).exists? ||
                @tournament.team_registrations.where(manager_user_id: current_user.id).exists?
              ) %>
            <% end %>

            <div style="height:1px;background:rgba(255,255,255,0.08);"></div>

            <% if current_user %>
              <div class="ls-user-name" style="font-size:12px;"> <%= current_user.name %> </div>
              <%= button_to "ออกจากระบบ", logout_path,
                    method: :delete,
                    form: { style: "margin:0;" },
                    class: "ls-drawer-button" %>
            <% else %>
              <%= link_to "เข้าสู่ระบบ", login_path, class: "ls-drawer-button", style: "text-decoration:none;" %>
              <%= link_to "เข้าสู่ระบบด้วย LINE", line_login_path, class: "ls-drawer-button ls-drawer-button--line", style: "text-decoration:none;" %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="offcanvas offcanvas-end" tabindex="-1" id="searchDrawer" aria-labelledby="searchDrawerLabel" style="width:360px;">
        <div class="offcanvas-header" style="background:#111315;color:#ffffff;">
          <h5 class="offcanvas-title" id="searchDrawerLabel" style="font-size:16px;">ค้นหารายการ</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" style="background:#0f1113;color:#ffffff;">
          <%= form_with url: tournaments_path, method: :get, local: true do |f| %>
            <div class="mb-2">
              <%= f.text_field :q, value: params[:q], placeholder: "พิมพ์ชื่อรายการ...", class: "form-control", autofocus: true %>
            </div>
            <div class="row g-2 mb-2">
              <div class="col-6">
                <%= f.select :province,
                      options_for_select([["ทุกจังหวัด", ""]] + Array(@search_provinces).map { |p| [p, p] }, params[:province]),
                      {},
                      class: "form-select" %>
              </div>
              <div class="col-6">
                <%= f.select :age_category,
                      options_for_select([["ทุกรุ่นอายุ", ""]] + Array(@search_age_categories).map { |a| [a, a] }, params[:age_category]),
                      {},
                      class: "form-select" %>
              </div>
            </div>
            <button type="submit" class="btn btn-success w-100">ค้นหา</button>
          <% end %>
          <div class="text-muted" style="font-size:12px;margin-top:10px;">ค้นหาจากชื่อรายการ</div>
        </div>
      </div>

      <% if flash.present? %>
        <div id="flash-toast-container" style="position:fixed;left:50%;transform:translateX(-50%);bottom:72px;max-width:90%;z-index:1100;pointer-events:none;">
          <% flash.each do |key, message| %>
            <% next if message.blank? %>
            <% bs_class = key.to_s == "notice" ? "alert-success" : "alert-danger" %>
            <div class="alert <%= bs_class %> py-2 px-3 mb-2 js-flash-auto-hide" role="alert" style="font-size:13px;pointer-events:auto;box-shadow:0 2px 6px rgba(0,0,0,0.25);">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>

      <!-- Back to top button -->
      <button
        id="back-to-top-btn"
        type="button"
        style="position:fixed;right:16px;bottom:16px;width:40px;height:40px;border-radius:50%;border:none;background:#1976d2;color:#ffffff;display:none;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,0.3);z-index:1050;font-size:18px;"
        aria-label="กลับขึ้นด้านบน">
        ↑
      </button>

      <script>
        (function() {
          var btn = document.getElementById('back-to-top-btn');
          if (btn) {
            window.addEventListener('scroll', function() {
              if (window.scrollY > 200) {
                btn.style.display = 'flex';
              } else {
                btn.style.display = 'none';
              }
            });

            btn.addEventListener('click', function() {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          }

          // auto hide flash messages after a short delay
          var flashes = document.querySelectorAll('.js-flash-auto-hide');
          flashes.forEach(function(el) {
            setTimeout(function() {
              el.style.transition = 'opacity 0.3s ease';
              el.style.opacity = '0';
              setTimeout(function() {
                if (el && el.parentNode) {
                  el.parentNode.removeChild(el);
                }
              }, 350);
            }, 3000);
          });
        })();
      </script>
    </div>
  </body>
</html>
