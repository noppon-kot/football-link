<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "DERNSAI.com – รายการฟุตบอล ฟุตบอลเดินสาย รวมรายการฟุตบอล โปรแกรมจัดตารางแข่งขัน แบ่งสายฟุตบอล และตารางคะแนน" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% share_title = if defined?(@tournament) && @tournament.present?
                      @tournament.title
                    else
                      "DERNSAI"
                    end %>
    <% share_description = if defined?(@tournament) && @tournament.present?
                            parts = []
                            parts << tournament_competition_date_label(@tournament) if respond_to?(:tournament_competition_date_label)
                            parts << @tournament.location_name if @tournament.respond_to?(:location_name)
                            parts << truncate(strip_tags(@tournament.description.to_s), length: 140) if @tournament.respond_to?(:description)
                            parts.compact.reject(&:blank?).join(" · ")
                          else
                            "รวมรายการฟุตบอล ช่วยจัดตารางแข่งขัน และตารางคะแนน"
                          end %>
    <% share_url = request.original_url %>
    <% share_image_url = begin
        if defined?(@tournament) && @tournament.present? && @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>

    <% og_title = content_for?(:og_title) ? yield(:og_title) : share_title %>
    <% og_description = content_for?(:og_description) ? yield(:og_description) : share_description %>
    <% og_url = content_for?(:og_url) ? yield(:og_url) : share_url %>
    <% og_image_url = content_for?(:og_image) ? yield(:og_image) : share_image_url %>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="DERNSAI">
    <meta property="og:title" content="<%= og_title %>">
    <meta property="og:description" content="<%= og_description %>">
    <meta property="og:url" content="<%= og_url %>">
    <meta property="og:image" content="<%= og_image_url %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= og_title %>">
    <meta name="twitter:description" content="<%= og_description %>">
    <meta name="twitter:image" content="<%= og_image_url %>">

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%= asset_path "dernsai_icon.png" %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path "dernsai_icon.png" %>">

    <!-- Bootstrap 5 CSS via CDN -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <!-- Bootstrap 5 JS bundle (for navbar toggle) -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"></script>
  </head>

  <body class="theme-green">
    <div style="max-width:960px;margin:0 auto;">
      <div class="ls-topbar">
        <button type="button" class="ls-icon-btn ls-icon-btn--left" data-bs-toggle="offcanvas" data-bs-target="#mainMenu" aria-controls="mainMenu" aria-label="เมนู">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>

        <%= link_to root_path, class: "ls-brand", style: "text-decoration:none;" do %>
          <%= image_tag "dernsai_ban.png", alt: "DERNSAI", class: "ls-brand-img" %>
        <% end %>

        <div class="ls-topbar-actions" style="display:flex;align-items:center;gap:8px;">
          <%= link_to new_tournament_path, class: "ls-icon-btn ls-icon-btn--add", aria: { label: "เพิ่มรายการแข่ง" } do %>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
              <path d="M11 5h2v14h-2zM5 11h14v2H5z" fill="currentColor"/>
            </svg>
          <% end %>

          <button type="button" class="ls-icon-btn ls-icon-btn--search" data-bs-toggle="offcanvas" data-bs-target="#searchDrawer" aria-controls="searchDrawer" aria-label="ค้นหา">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
              <path d="M10.5 3a7.5 7.5 0 105.2 12.9l3.4 3.4 1.4-1.4-3.4-3.4A7.5 7.5 0 0010.5 3zm0 2a5.5 5.5 0 110 11 5.5 5.5 0 010-11z" fill="currentColor"/>
            </svg>
          </button>

          <% unless current_user.present? %>
            <%= link_to login_path, class: "ls-icon-btn ls-icon-btn--login", aria: { label: "เข้าสู่ระบบ" } do %>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path d="M10 17l1.41-1.41L9.83 14H20v-2H9.83l1.58-1.59L10 9l-5 5 5 5z" fill="currentColor"/>
                <path d="M4 4h8v2H4v12h8v2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" fill="currentColor"/>
              </svg>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if defined?(@tournament) && @tournament.present? && @tournament.persisted? %>
        <% can_manage_tournament = can_edit_tournament?(@tournament) %>
        <% pro_enabled = admin? || @tournament.pro? || @tournament.competition_data_present? || pro_owner?(@tournament) %>
        <% has_teams = @tournament.team_registrations.exists? %>
        <% has_groups = Group.joins(:tournament_division).where(tournament_divisions: { tournament_id: @tournament.id }).exists? %>
        <% has_matches = Match.joins(:tournament_division).where(tournament_divisions: { tournament_id: @tournament.id }).exists? %>

        <nav class="ls-subnav" aria-label="Tournament navigation">
          <div class="ls-subnav-scroll">
            <%= link_to "ข้อมูล", tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(tournament_path(@tournament))}" %>

            <% if can_manage_tournament || @tournament.free? || has_teams %>
              <%= link_to "ทีม", teams_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(teams_tournament_path(@tournament))}" %>
            <% end %>

            <% if can_manage_tournament %>
              <% if pro_enabled %>
                <%= link_to "แบ่งสาย", groups_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(groups_tournament_path(@tournament))}" %>
                <%= link_to "โปรแกรม", fixture_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(fixture_tournament_path(@tournament))}" %>
                <%= link_to "คะแนน", table_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(table_tournament_path(@tournament))}" %>
              <% else %>
                <a class="ls-subnav-link is-disabled" href="#" data-bs-toggle="modal" data-bs-target="#planUpgradeModal">แบ่งสาย</a>
                <a class="ls-subnav-link is-disabled" href="#" data-bs-toggle="modal" data-bs-target="#planUpgradeModal">โปรแกรม</a>
                <a class="ls-subnav-link is-disabled" href="#" data-bs-toggle="modal" data-bs-target="#planUpgradeModal">คะแนน</a>
              <% end %>
            <% else %>
              <% if has_groups %>
                <%= link_to "แบ่งสาย", groups_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(groups_tournament_path(@tournament))}" %>
              <% end %>
              <% if has_matches %>
                <%= link_to "โปรแกรม", fixture_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(fixture_tournament_path(@tournament))}" %>
                <%= link_to "คะแนน", table_tournament_path(@tournament), class: "ls-subnav-link #{'is-active' if current_page?(table_tournament_path(@tournament))}" %>
              <% end %>
            <% end %>
          </div>
        </nav>

        <div class="ls-tournament-strip" aria-label="Tournament title">
          <div class="ls-tournament-strip-inner">
            <div class="d-flex justify-content-between align-items-start" style="gap:10px;">
              <div>
                <div class="ls-tournament-strip-title"><%= @tournament.title %></div>
                <div class="ls-tournament-strip-meta">
                  <%= tournament_competition_date_label(@tournament) %>
                </div>
                <div class="ls-tournament-strip-meta">
                  <%= @tournament.location_name %><% if @tournament.respond_to?(:province) && @tournament.province.present? %> · <%= @tournament.province %><% end %>
                </div>
              </div>

              <div class="d-flex" style="gap:8px;">
                <button type="button" id="share-tournament-btn" class="btn btn-sm btn-outline-secondary" title="แชร์รายการ" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="แชร์รายการ" style="line-height:1;padding:6px 8px;">
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                    <path d="M18 16.1c-.8 0-1.5.3-2 .8l-7.1-4.1c.1-.3.1-.5.1-.8s0-.5-.1-.8l7-4.1c.5.5 1.2.8 2 .8 1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3c0 .3 0 .5.1.8l-7 4.1c-.5-.5-1.2-.8-2-.8-1.7 0-3 1.3-3 3s1.3 3 3 3c.8 0 1.5-.3 2-.8l7.1 4.1c-.1.2-.1.5-.1.7 0 1.7 1.3 3 3 3s3-1.3 3-3-1.3-3-3-3z" fill="currentColor"/>
                  </svg>
                </button>

                <% if admin? %>
                  <%= link_to edit_tournament_path(@tournament),
                              class: "btn btn-sm btn-outline-secondary",
                              title: "แก้ไขรายการ",
                              data: { bs_toggle: "tooltip", bs_placement: "top" },
                              aria: { label: "แก้ไขรายการ" },
                              style: "line-height:1;padding:6px 8px;" do %>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                      <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l8.06-8.06.92.92L5.92 20.08zM20.71 7.04a1.003 1.003 0 000-1.42l-2.34-2.34a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" fill="currentColor"/>
                    </svg>
                  <% end %>

                  <%= button_to tournament_path(@tournament),
                                method: :delete,
                                form: { style: "display:inline-block;" },
                                data: { turbo_confirm: "ยืนยันลบรายการแข่งนี้? ข้อมูลทั้งหมดที่เกี่ยวข้องจะถูกลบด้วย", bs_toggle: "tooltip", bs_placement: "top" },
                                title: "ลบรายการ",
                                class: "btn btn-sm btn-outline-danger",
                                aria: { label: "ลบรายการ" },
                                style: "line-height:1;padding:6px 8px;" do %>
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                      <path d="M6 7h12l-1 14H7L6 7zm3-3h6l1 2H8l1-2z" fill="currentColor"/>
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <% if can_manage_tournament && !pro_enabled %>
          <div class="modal fade" id="planUpgradeModal" tabindex="-1" aria-labelledby="planUpgradeModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content" style="background:#111315;color:#ffffff;border:1px solid rgba(255,255,255,0.10);">
                <div class="modal-header" style="border-bottom:1px solid rgba(255,255,255,0.10);">
                  <h5 class="modal-title" id="planUpgradeModalLabel" style="font-size:16px;">ฟีเจอร์สำหรับแพ็กเกจ Pro</h5>
                  <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="font-size:14px;">
                  แพ็กเกจฟรีใช้งานได้เฉพาะ <strong>Info</strong> และ <strong>Team</strong> เท่านั้น
                  <div class="text-muted" style="font-size:12px;margin-top:6px;">
                    ต้องการใช้งาน Group / Fixtures / Table กรุณาอัปเกรดเป็นแพ็กเกจ Pro
                  </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid rgba(255,255,255,0.10);">
                  <%= link_to "ดูรายละเอียดแพ็กเกจ", package_tournament_path(@tournament), class: "btn btn-light" %>
                  <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">ปิด</button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="offcanvas offcanvas-start" tabindex="-1" id="mainMenu" aria-labelledby="mainMenuLabel" style="width:320px;">
        <div class="offcanvas-header" style="background:#111315;color:#ffffff;">
          <h5 class="offcanvas-title" id="mainMenuLabel" style="font-size:16px;">เมนู</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" style="background:#0f1113;color:#ffffff;">
          <div class="d-flex flex-column" style="gap:10px;">
            <%= link_to "รายการแข่งขันทั้งหมด", root_path, class: "ls-drawer-link" %>

            <% if can_create_tournaments? %>
              <%= link_to "รายการของฉัน", mytournaments_path, class: "ls-drawer-link" %>
            <% end %>

            <%= link_to "เพิ่มรายการแข่ง", new_tournament_path, class: "ls-drawer-link" %>

            <% if admin? %>
              <div style="height:1px;background:rgba(255,255,255,0.08);"></div>
              <%= link_to "จัดการผู้ใช้", admin_users_path, class: "ls-drawer-link" %>
            <% end %>

            <% if defined?(@tournament) && @tournament.present? && @tournament.persisted? %>
              <div style="height:1px;background:rgba(255,255,255,0.08);"></div>

              <% show_my_tab = current_user.present? && (
                TeamRegistrationManager.joins(:team_registration).where(team_registrations: { tournament_id: @tournament.id }, user_id: current_user.id).exists? ||
                @tournament.team_registrations.where(manager_user_id: current_user.id).exists?
              ) %>
            <% end %>

            <div style="height:1px;background:rgba(255,255,255,0.08);"></div>

            <% if current_user %>
              <div class="ls-user-name" style="font-size:12px;"> <%= current_user.name %> </div>
              <%= button_to "ออกจากระบบ", logout_path,
                    method: :delete,
                    form: { style: "margin:0;" },
                    class: "ls-drawer-button" %>
            <% else %>
              <%= link_to "เข้าสู่ระบบ", login_path, class: "ls-drawer-button", style: "text-decoration:none;" %>
            <% end %>
          </div>
        </div>
      </div>

      <div class="offcanvas offcanvas-end" tabindex="-1" id="searchDrawer" aria-labelledby="searchDrawerLabel" style="width:360px;">
        <div class="offcanvas-header" style="background:#111315;color:#ffffff;">
          <h5 class="offcanvas-title" id="searchDrawerLabel" style="font-size:16px;">ค้นหารายการ</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body" style="background:#0f1113;color:#ffffff;">
          <%= form_with url: tournaments_path, method: :get, local: true do |f| %>
            <div class="mb-2">
              <%= f.text_field :q, value: params[:q], placeholder: "พิมพ์ชื่อรายการ...", class: "form-control", autofocus: true %>
            </div>
            <div class="row g-2 mb-2">
              <div class="col-6">
                <%= f.select :province,
                      options_for_select([["ทุกจังหวัด", ""]] + Array(@search_provinces).map { |p| [p, p] }, params[:province]),
                      {},
                      class: "form-select" %>
              </div>
              <div class="col-6">
                <%= f.select :age_category,
                      options_for_select([["ทุกรุ่นอายุ", ""]] + Array(@search_age_categories).map { |a| [a, a] }, params[:age_category]),
                      {},
                      class: "form-select" %>
              </div>
            </div>
            <button type="submit" class="btn btn-success w-100">ค้นหา</button>
          <% end %>
          <div class="text-muted" style="font-size:12px;margin-top:10px;">ค้นหาจากชื่อรายการ</div>
        </div>
      </div>

      <% if flash.present? %>
        <div id="flash-toast-container" style="position:fixed;left:50%;transform:translateX(-50%);bottom:90px;max-width:90%;z-index:1100;pointer-events:none;">
          <% flash.each do |key, message| %>
            <% next if message.blank? %>
            <% bs_class = key.to_s == "notice" ? "alert-success" : "alert-danger" %>
            <div class="alert <%= bs_class %> py-2 px-3 mb-2 js-flash-auto-hide" role="alert" style="font-size:13px;pointer-events:auto;box-shadow:0 2px 6px rgba(0,0,0,0.25);">
              <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>

      <% if defined?(@tournament) && @tournament.present? && @tournament.persisted? %>
        <script>
          (function() {
            var btn = document.getElementById('share-tournament-btn');
            if (!btn) return;

            btn.addEventListener('click', async function() {
              var url = window.location.href;
              var title = "<%= j @tournament.title.to_s %>";

              try {
                if (navigator.share) {
                  await navigator.share({ title: title, url: url });
                  return;
                }
              } catch (e) {
              }

              try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                  await navigator.clipboard.writeText(url);
                  alert('คัดลอกลิงก์แล้ว');
                  return;
                }
              } catch (e) {
              }

              window.prompt('คัดลอกลิงก์เพื่อแชร์', url);
            });
          })();
        </script>
      <% end %>

      <div class="ls-footerbar" role="contentinfo">
        <div class="ls-footerbar-inner">
          <div class="ls-footerbar-left">© <%= Time.current.year %> DERNSAI</div>
          <div class="ls-footerbar-right">
            <%= link_to "ติดต่อเรา", new_admin_message_path, class: "ls-footerbar-link" %>
          </div>
        </div>
      </div>

      <!-- Back to top button -->
      <button
        id="back-to-top-btn"
        type="button"
        style="position:fixed;right:16px;bottom:76px;width:40px;height:40px;border-radius:50%;border:none;background:#1976d2;color:#ffffff;display:none;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,0.3);z-index:2000;font-size:18px;"
        aria-label="กลับขึ้นด้านบน">
        ↑
      </button>

      <script>
        (function() {
          function ensureGlobalWaitOverlay() {
            var el = document.getElementById('global-wait-overlay');
            if (el) return el;

            el = document.createElement('div');
            el.id = 'global-wait-overlay';
            el.style.display = 'none';
            el.style.position = 'fixed';
            el.style.inset = '0';
            el.style.zIndex = '3000';
            el.style.background = 'rgba(0,0,0,0.55)';
            el.style.alignItems = 'center';
            el.style.justifyContent = 'center';
            el.style.padding = '16px';
            el.innerHTML = '' +
              '<div style="background:#ffffff;border-radius:14px;padding:16px 18px;min-width:220px;max-width:92vw;box-shadow:0 12px 30px rgba(0,0,0,0.25);">' +
              '  <div class="d-flex align-items-center" style="gap:10px;">' +
              '    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>' +
              '    <div style="font-weight:700;">กำลังประมวลผล...</div>' +
              '  </div>' +
              '  <div class="text-muted" style="font-size:12px;margin-top:6px;">กรุณารอสักครู่</div>' +
              '</div>';
            document.body.appendChild(el);
            return el;
          }

          function showGlobalWaitOverlay() {
            var el = ensureGlobalWaitOverlay();
            el.style.display = 'flex';
          }

          function hideGlobalWaitOverlay() {
            var el = document.getElementById('global-wait-overlay');
            if (el) el.style.display = 'none';
          }

          // expose for pages that want to use it explicitly
          window.showGlobalWaitOverlay = showGlobalWaitOverlay;
          window.hideGlobalWaitOverlay = hideGlobalWaitOverlay;

          function initTooltips() {
            if (typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;

            var triggers = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            triggers.forEach(function(el) {
              try {
                bootstrap.Tooltip.getOrCreateInstance(el);
              } catch (e) {
              }
            });
          }

          function initBackToTop() {
            var btn = document.getElementById('back-to-top-btn');
            if (!btn) return;
            if (btn.__backToTopInitialized) return;

            function updateVisibility() {
              if (window.scrollY > 200) {
                btn.style.display = 'flex';
              } else {
                btn.style.display = 'none';
              }
            }

            window.addEventListener('scroll', updateVisibility, { passive: true });
            window.addEventListener('pageshow', updateVisibility);
            updateVisibility();

            btn.addEventListener('click', function() {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            btn.__backToTopInitialized = true;
          }

          document.addEventListener('turbo:load', initBackToTop);
          document.addEventListener('turbo:load', initTooltips);
          document.addEventListener('DOMContentLoaded', initBackToTop);
          document.addEventListener('DOMContentLoaded', initTooltips);
          initBackToTop();
          initTooltips();

          // Global loading overlay for long navigations / submits
          // - Show only for explicit actions (form submits / saves)
          // - Do not show for Turbo prefetch/hover or top tab navigation
          if (!window.__globalWaitOverlayBound) {
            document.addEventListener('turbo:load', function() {
              hideGlobalWaitOverlay();
            });

            document.addEventListener('submit', function(e) {
              var form = e.target;
              if (!form || form.tagName !== 'FORM') return;
              // allow opt-out
              if (form.getAttribute('data-disable-wait-overlay') === '1') return;
              showGlobalWaitOverlay();
            }, true);

            window.__globalWaitOverlayBound = true;
          }

          // auto hide flash messages after a short delay
          var flashes = document.querySelectorAll('.js-flash-auto-hide');
          flashes.forEach(function(el) {
            setTimeout(function() {
              el.style.transition = 'opacity 0.3s ease';
              el.style.opacity = '0';
              setTimeout(function() {
                if (el && el.parentNode) {
                  el.parentNode.removeChild(el);
                }
              }, 350);
            }, 3000);
          });
        })();
      </script>
    </div>
  </body>
</html>
