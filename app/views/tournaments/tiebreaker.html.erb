<div class="app-shell">
  <div class="container py-3" style="max-width:960px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h5 class="mb-1">จับสลาก</h5>
        <div class="text-muted" style="font-size:13px;"><%= @tournament.title %></div>
      </div>
      <%= link_to table_tournament_path(@tournament), class: "btn btn-sm btn-outline-secondary" do %>
        <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
          <path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
        </svg>
        กลับหน้าตารางคะแนน
      <% end %>
    </div>

    <% if @tiebreaker_data.empty? %>
      <div class="alert alert-success">
        <svg viewBox="0 0 24 24" width="20" height="20" style="margin-right:8px;vertical-align:middle;">
          <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
        </svg>
        ไม่มีทีมที่มีคะแนนเท่ากันและต้องเลือกลำดับ
      </div>
    <% else %>
      <%= form_with url: update_tiebreaker_tournament_path(@tournament), method: :patch, local: true do %>
        <% @divisions.each do |division| %>
          <% div_data = @tiebreaker_data[division.id] %>
          <% next unless div_data && div_data[:groups].any? %>

          <div class="card shadow-sm mb-3">
            <div class="card-header" style="background:#f8f9fa;">
              <div class="fw-bold">รุ่น <%= division.name %></div>
            </div>
            <div class="card-body">
              <% div_data[:groups].each do |group_data| %>
                <% group = group_data[:group] %>
                <% tied_teams = group_data[:tied_teams] %>

                <div class="mb-4">
                  <div class="fw-semibold mb-2" style="font-size:14px;">
                    <span class="badge bg-secondary me-1">สาย <%= group.name %></span>
                  </div>

                  <% tied_teams.each do |tied_group| %>
                    <% all_ranked = tied_group[:all_ranked] %>
                    <% matches_complete = tied_group[:matches_complete] %>
                    <% alert_class = if !matches_complete
                                       'alert-secondary'
                                     elsif all_ranked
                                       'alert-success'
                                     else
                                       'alert-warning'
                                     end %>
                    <div class="alert <%= alert_class %> mb-3" style="font-size:13px;">
                      <div class="fw-bold mb-2">
                        <% if !matches_complete %>
                          <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;vertical-align:middle;">
                            <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                          </svg>
                          ทีมที่มีคะแนนเท่ากัน (<%= tied_group[:pts] %> แต้ม) - <span class="text-secondary">แข่งยังไม่ครบ</span>
                        <% elsif all_ranked %>
                          <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;vertical-align:middle;">
                            <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                          </svg>
                          ทีมที่มีคะแนนเท่ากัน (<%= tied_group[:pts] %> แต้ม) - <span class="text-success">เลือกลำดับแล้ว ✓</span>
                        <% else %>
                          <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;vertical-align:middle;">
                            <path fill="currentColor" d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                          </svg>
                          ทีมที่มีคะแนนเท่ากัน (<%= tied_group[:pts] %> แต้ม) - <span class="text-danger">ยังไม่เลือกลำดับ</span>
                        <% end %>
                      </div>
                      
                      <div class="table-responsive">
                        <table class="table table-sm table-bordered mb-0" style="font-size:12px;background:#fff;">
                          <thead class="table-light">
                            <tr>
                              <th style="width:40px;">#</th>
                              <th>ทีม</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">แข่ง</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">ชนะ</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">เสมอ</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">แพ้</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">ได้</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">เสีย</th>
                              <th style="width:45px;" class="text-center d-none d-md-table-cell">+/-</th>
                              <th style="width:50px;" class="text-center">แต้ม</th>
                              <th style="width:100px;" class="text-center">ลำดับ</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% tied_group[:teams].each_with_index do |team, idx| %>
                              <tr>
                                <td class="text-center"><%= idx + 1 %></td>
                                <td>
                                  <div class="d-flex align-items-center" style="gap:6px;">
                                    <% team_obj = Team.find_by(id: team[:team_id]) %>
                                    <% if team_obj&.logo&.attached? %>
                                      <%= image_tag team_obj.logo, style: "width:20px;height:20px;border-radius:50%;object-fit:cover;" %>
                                    <% end %>
                                    <%= team[:team_name] %>
                                  </div>
                                </td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:played] %></td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:won] %></td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:draw] %></td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:lost] %></td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:gf] %></td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:ga] %></td>
                                <td class="text-center d-none d-md-table-cell"><%= team[:gf] - team[:ga] %></td>
                                <td class="text-center fw-bold"><%= team[:pts] %></td>
                                <td class="text-center">
                                  <%= select_tag "tiebreaker[#{team[:team_reg_id]}][tiebreaker_rank]",
                                        options_for_select(
                                          [["เลือก...", ""]] + (1..tied_group[:teams].size).map { |n| ["#{n}", n] },
                                          team[:tiebreaker_rank]
                                        ),
                                        class: "form-select form-select-sm",
                                        style: "font-size:11px;min-width:60px;",
                                        disabled: !matches_complete %>
                                </td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      </div>
                      
                      <div class="d-flex justify-content-between align-items-center mt-2">
                        <div class="text-muted" style="font-size:11px;">
                          <% if matches_complete %>
                            <strong>วิธีใช้:</strong> เลือกลำดับตามผลจับสลากที่สนาม (อันดับ 1 = เข้ารอบก่อน)
                          <% else %>
                            <span class="text-danger"><strong>หมายเหตุ:</strong> ต้องแข่งให้ครบก่อนจึงจะเลือกลำดับได้</span>
                          <% end %>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary" <%= 'disabled' unless matches_complete %>>
                          <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
                            <path fill="currentColor" d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
                          </svg>
                          บันทึก
                        </button>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if can_manage_registrations?(@tournament) %>
          <div class="d-flex justify-content-between align-items-center">
            <%= link_to fixture_tournament_path(@tournament), class: "btn btn-outline-success" do %>
              <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;">
                <path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
              </svg>
              ไปหน้าโปรแกรมแข่ง
            <% end %>
            <button type="submit" class="btn btn-primary">
              <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;">
                <path fill="currentColor" d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
              </svg>
              บันทึกลำดับ
            </button>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
