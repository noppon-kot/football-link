<div class="app-shell">
  <div class="container py-3" style="max-width:960px;">
    <div class="card shadow-sm" style="border-radius:14px;">
      <div class="card-body" style="padding:14px;">
        <div class="d-flex justify-content-between align-items-start" style="gap:10px;">
          <div class="tournament-page-title"><%= @tournament.title %></div>
          <div class="d-flex" style="gap:8px;">
            <button type="button" id="share-tournament-btn" class="btn btn-sm btn-outline-secondary" aria-label="แชร์รายการ" style="line-height:1;padding:6px 8px;">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M18 16.1c-.8 0-1.5.3-2 .8l-7.1-4.1c.1-.3.1-.5.1-.8s0-.5-.1-.8l7-4.1c.5.5 1.2.8 2 .8 1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3c0 .3 0 .5.1.8l-7 4.1c-.5-.5-1.2-.8-2-.8-1.7 0-3 1.3-3 3s1.3 3 3 3c.8 0 1.5-.3 2-.8l7.1 4.1c-.1.2-.1.5-.1.7 0 1.7 1.3 3 3 3s3-1.3 3-3-1.3-3-3-3z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="text-muted" style="font-size:12px;margin-top:6px;">
          <%= tournament_competition_date_label(@tournament) %>
        </div>
        <div class="text-muted" style="font-size:12px;">
          <%= @tournament.location_name %> · <%= @tournament.province %>
        </div>
        <% if admin? %>
          <div class="mt-2 d-flex gap-2">
            <%= link_to "Update รายการ",
                        edit_tournament_path(@tournament),
                        class: "btn btn-sm btn-success" %>
            <%= button_to "ลบรายการแข่ง",
                          tournament_path(@tournament),
                          method: :delete,
                          data: { turbo_confirm: "ยืนยันลบรายการแข่งนี้? ข้อมูลทั้งหมดที่เกี่ยวข้องจะถูกลบด้วย" },
                          class: "btn btn-sm btn-danger" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    // simple tab handler for teams by division (ใช้ event delegation จาก document)
    (function() {
      document.addEventListener('click', function(e) {
        var tab = e.target.closest('.team-tab');
        if (!tab) return;

        var tabsContainer = tab.parentElement;
        var panelsContainer = document.getElementById('team-tab-panels');
        if (!tabsContainer || !panelsContainer) return;

        var targetId = tab.getAttribute('data-tab');
        if (!targetId) return;

        // toggle active tab
        var allTabs = tabsContainer.querySelectorAll('.team-tab');
        allTabs.forEach(function(t) { t.classList.remove('team-tab--active'); });
        tab.classList.add('team-tab--active');

        // toggle panels
        var allPanels = panelsContainer.querySelectorAll('.team-tab-panel');
        allPanels.forEach(function(panel) {
          panel.style.display = (panel.id === targetId) ? 'block' : 'none';
        });
      });
    })();

    (function() {
      var btn = document.getElementById('share-tournament-btn');
      if (!btn) return;

      btn.addEventListener('click', async function() {
        var url = window.location.href;
        var title = "<%= j @tournament.title.to_s %>";

        try {
          if (navigator.share) {
            await navigator.share({ title: title, url: url });
            return;
          }
        } catch (e) {
        }

        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(url);
            alert('คัดลอกลิงก์แล้ว');
            return;
          }
        } catch (e) {
        }

        window.prompt('คัดลอกลิงก์เพื่อแชร์', url);
      });
    })();
  </script>

  <div class="tournament-show-body">
    <div class="container py-2">
      <div class="row g-3">
        <div class="col-12">
          <div class="tournament-info-card card shadow-sm" style="font-size:16px;">
      <% if @tournament.description.present? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">รายละเอียด</div>
          <div class="small text-muted"><%= simple_format(@tournament.description) %></div>
        </div>
      <% end %>

      <div class="fw-bold mb-1">ข้อมูลการแข่งขัน</div>
      <div class="mb-3">
        <div><span class="fw-bold">จำนวนผู้เล่น:</span> <span class="ms-1"><%= @tournament.team_size %> คน</span></div>
        <div><span class="fw-bold">วันแข่งขัน:</span> <span class="ms-1">เริ่ม <%= tournament_start_date_label(@tournament) %></span></div>
      </div>

      <div class="fw-bold mb-1">การรับสมัคร</div>
      <div class="mb-3">
        <div><span class="fw-bold">วันเปิดรับสมัคร:</span> <span class="ms-1"><%= @tournament.registration_open_on&.strftime("%Y-%m-%d") %></span></div>
        <div><span class="fw-bold">วันปิดรับสมัคร:</span> <span class="ms-1"><%= @tournament.registration_close_on&.strftime("%Y-%m-%d") %></span></div>
      </div>

      <% divisions = @tournament.tournament_divisions.order(:position, :id) %>
      <% if divisions.any? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">รุ่นที่เปิดแข่ง</div>
          <div class="list-group list-group-flush">
            <% divisions.each do |div| %>
              <div class="list-group-item px-0 py-2">
                <div><span class="fw-bold">ช่วงอายุ:</span> <span class="ms-1"><%= div.name %></span></div>
                <% if div.entry_fee.present? %>
                  <div><span class="fw-bold">ค่าสมัครรุ่นนี้:</span> <span class="ms-1"><%= number_to_currency(div.entry_fee, unit: "฿", precision: 0) %></span></div>
                <% end %>
                <% if div.prize_amount.present? %>
                  <div><span class="fw-bold">รางวัลรุ่นนี้:</span> <span class="ms-1"><%= number_to_currency(div.prize_amount, unit: "฿", precision: 0) %></span></div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <% if @tournament.age_category.present? || @tournament.entry_fee.present? || @tournament.prize_amount.present? %>
          <div class="mb-1"><span class="fw-bold">ช่วงอายุ (หลัก):</span> <span class="ms-1"><%= @tournament.age_category %></span></div>
          <div class="mb-1"><span class="fw-bold">ค่าสมัคร:</span> <span class="ms-1"><%= number_to_currency(@tournament.entry_fee, unit: "฿", precision: 0) %></span></div>
          <div class="mb-3"><span class="fw-bold">รางวัล:</span> <span class="ms-1"><%= number_to_currency(@tournament.prize_amount, unit: "฿", precision: 0) %></span></div>
        <% else %>
          <div class="mb-3">
            <div class="fw-bold mb-1">รุ่นที่เปิดแข่ง</div>
            <div class="text-muted" style="font-size:13px;">ยังไม่ได้เพิ่มรุ่นการแข่งขัน</div>
          </div>
        <% end %>
      <% end %>

      <% if @tournament.google_maps_url.present? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">แผนที่สนามแข่งขัน</div>
          <% url = @tournament.google_maps_url %>
          <% if url.include?("/maps/embed") %>
            <div class="ratio ratio-16x9">
              <iframe
                src="<%= url %>"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          <% else %>
            <div>
              <%= link_to "เปิดใน Google Maps", url, class: "btn btn-sm btn-outline-primary", target: "_blank", rel: "noopener" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mb-1"><span class="fw-bold">ผู้จัด:</span> <span class="ms-1"><%= @tournament.organizer.name %> (<%= @tournament.organizer.phone %>)</span></div>

      <div class="fw-bold mb-1 mt-3">การติดต่อ</div>
      <div class="mb-0 text-muted" style="font-size:13px;">
        <% if @tournament.line_id.present? %>
          <div>LINE ID: <%= @tournament.line_id %></div>
        <% end %>
        <% if @tournament.contact_phone.present? %>
          <div>โทร: <%= @tournament.contact_phone %></div>
        <% end %>
      </div>

      <% if @tournament.images.attached? %>
        <% image = @tournament.images.first %>
        <div class="mt-3">
          <div class="fw-bold mb-1">รูปภาพรายการ</div>
          <%= link_to url_for(image), target: "_blank", rel: "noopener" do %>
            <%= image_tag url_for(image), style: "width:96px;height:96px;object-fit:cover;display:block;border-radius:12px;border:1px solid rgba(0,0,0,0.12);background:#ffffff;" %>
          <% end %>
        </div>
      <% end %>
        </div>
        </div>
      </div>
    </div>
  </div>

  <% if @tournament.line_id.present? || @tournament.contact_phone.present? %>
    <% line_deep_link = @tournament.line_id.present? ? "line://ti/p/~#{@tournament.line_id}" : nil %>
    <% line_web_link  = @tournament.line_id.present? ? "https://line.me/R/ti/p/~#{@tournament.line_id}" : nil %>
    <% tel_raw = @tournament.contact_phone.to_s %>
    <% tel_href = "tel:#{tel_raw.gsub(/[^0-9+]/, '')}" %>

    <div class="mt-3">
      <div class="d-flex justify-content-center" style="gap:10px;flex-wrap:wrap;">
        <% if @tournament.line_id.present? %>
          <%= link_to "LINE: #{@tournament.line_id}",
                      line_deep_link,
                      class: "btn btn-success",
                      style: "min-width:200px;flex:1 1 0;max-width:260px;background-color:#00c300;border-color:#00c300;color:#ffffff;box-shadow:0 6px 18px rgba(0,0,0,0.18);border-radius:8px;padding:10px 12px;font-size:14px;",
                      target: "_blank",
                      rel: "noopener",
                      data: { fallback_url: line_web_link } %>
        <% end %>

        <% if @tournament.contact_phone.present? %>
          <%= link_to "โทร: #{@tournament.contact_phone}",
                      tel_href,
                      class: "btn btn-primary",
                      style: "min-width:200px;flex:1 1 0;max-width:260px;box-shadow:0 6px 18px rgba(0,0,0,0.18);border-radius:8px;padding:10px 12px;font-size:14px;" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
