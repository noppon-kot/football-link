<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <div class="row g-3">
        <div class="col-12">
          <div class="tournament-info-card card shadow-sm" style="font-size:16px;">
      <% if @tournament.images.attached? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">รูปภาพรายการ</div>
          <div class="row row-cols-2 g-2">
            <% @tournament.images.each do |image| %>
              <div class="col">
                <a href="#"
                   class="d-block js-tournament-image-lightbox"
                   data-full-url="<%= url_for(image) %>"
                   style="text-decoration:none;">
                  <%= image_tag url_for(image), style: "width:100%;aspect-ratio: 4 / 3;height:auto;object-fit:cover;display:block;border-radius:14px;border:1px solid rgba(0,0,0,0.12);background:#ffffff;" %>
                </a>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if @tournament.description.present? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">รายละเอียด</div>
          <div class="small text-muted ls-clamp-4-mobile"><%= simple_format(@tournament.description) %></div>
        </div>
      <% end %>

      <div class="fw-bold mb-1">ข้อมูลการแข่งขัน</div>
      <div class="mb-3">
        <div><span class="fw-bold">จำนวนผู้เล่น:</span> <span class="ms-1"><%= @tournament.team_size %> คน</span></div>
        <div><span class="fw-bold">วันแข่งขัน:</span> <span class="ms-1">เริ่ม <%= tournament_start_date_label(@tournament) %></span></div>
      </div>

      <div class="fw-bold mb-1">การรับสมัคร</div>
      <div class="mb-3">
        <div><span class="fw-bold">วันเปิดรับสมัคร:</span> <span class="ms-1"><%= @tournament.registration_open_on&.strftime("%Y-%m-%d") %></span></div>
        <div><span class="fw-bold">วันปิดรับสมัคร:</span> <span class="ms-1"><%= @tournament.registration_close_on&.strftime("%Y-%m-%d") %></span></div>
      </div>

      <% divisions = @tournament.tournament_divisions.order(:position, :id) %>
      <% if divisions.any? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">รุ่นที่เปิดแข่ง</div>
          <div class="list-group list-group-flush">
            <% divisions.each do |div| %>
              <div class="list-group-item px-0 py-2">
                <div><span class="fw-bold">ช่วงอายุ:</span> <span class="ms-1"><%= div.name %></span></div>
                <% if div.entry_fee.present? %>
                  <div><span class="fw-bold">ค่าสมัครรุ่นนี้:</span> <span class="ms-1"><%= number_to_currency(div.entry_fee, unit: "฿", precision: 0) %></span></div>
                <% end %>
                <% if div.prize_amount.present? %>
                  <div><span class="fw-bold">รางวัลรุ่นนี้:</span> <span class="ms-1"><%= number_to_currency(div.prize_amount, unit: "฿", precision: 0) %></span></div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% else %>
        <% if @tournament.age_category.present? || @tournament.entry_fee.present? || @tournament.prize_amount.present? %>
          <div class="mb-1"><span class="fw-bold">ช่วงอายุ (หลัก):</span> <span class="ms-1"><%= @tournament.age_category %></span></div>
          <div class="mb-1"><span class="fw-bold">ค่าสมัคร:</span> <span class="ms-1"><%= number_to_currency(@tournament.entry_fee, unit: "฿", precision: 0) %></span></div>
          <div class="mb-3"><span class="fw-bold">รางวัล:</span> <span class="ms-1"><%= number_to_currency(@tournament.prize_amount, unit: "฿", precision: 0) %></span></div>
        <% else %>
          <div class="mb-3">
            <div class="fw-bold mb-1">รุ่นที่เปิดแข่ง</div>
            <div class="text-muted" style="font-size:13px;">ยังไม่ได้เพิ่มรุ่นการแข่งขัน</div>
          </div>
        <% end %>
      <% end %>

      <% if @tournament.google_maps_url.present? %>
        <div class="mb-3">
          <div class="fw-bold mb-1">แผนที่สนามแข่งขัน</div>
          <% url = @tournament.google_maps_url %>
          <% if url.include?("/maps/embed") %>
            <div class="ratio ratio-16x9">
              <iframe
                src="<%= url %>"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          <% else %>
            <div>
              <%= link_to "เปิดใน Google Maps", url, class: "btn btn-sm btn-outline-primary", target: "_blank", rel: "noopener" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="mb-1"><span class="fw-bold">ผู้จัด:</span> <span class="ms-1"><%= @tournament.organizer.name %> (<%= @tournament.organizer.phone %>)</span></div>

      <div class="fw-bold mb-1 mt-3">การติดต่อ</div>
      <div class="mb-0 text-muted" style="font-size:13px;">
        <% if @tournament.line_id.present? %>
          <div>LINE ID: <%= @tournament.line_id %></div>
        <% end %>
        <% if @tournament.contact_phone.present? %>
          <div>โทร: <%= @tournament.contact_phone %></div>
        <% end %>
      </div>

      <div id="tournament-image-lightbox" aria-hidden="true" style="position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.86);z-index:2000;padding:16px;">
        <button type="button" id="tournament-image-lightbox-close" aria-label="Close" style="position:absolute;top:12px;right:12px;width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.35);color:#ffffff;font-size:26px;line-height:36px;display:flex;align-items:center;justify-content:center;">
          ×
        </button>
        <img id="tournament-image-lightbox-img" alt="tournament" style="max-width:min(980px, 100%);max-height:86vh;width:auto;height:auto;object-fit:contain;border-radius:14px;background:#000;" />
      </div>

      <script>
        function openTournamentLightbox(url) {
          if (!url) return;
          var overlay = document.getElementById("tournament-image-lightbox");
          var overlayImg = document.getElementById("tournament-image-lightbox-img");
          if (!overlay || !overlayImg) return;

          overlayImg.src = url;
          overlay.style.display = "flex";
          overlay.setAttribute("aria-hidden", "false");
        }

        function closeTournamentLightbox() {
          var overlay = document.getElementById("tournament-image-lightbox");
          var overlayImg = document.getElementById("tournament-image-lightbox-img");
          if (!overlay || !overlayImg) return;

          overlay.style.display = "none";
          overlay.setAttribute("aria-hidden", "true");
          overlayImg.removeAttribute("src");
        }

        function initTournamentImageLightbox() {
          if (document.documentElement.dataset.tournamentLightboxBound === "1") return;

          document.addEventListener("click", function(e) {
            var trigger = e.target.closest && e.target.closest(".js-tournament-image-lightbox");
            if (trigger) {
              e.preventDefault();
              openTournamentLightbox(trigger.getAttribute("data-full-url"));
              return;
            }

            if (e.target && e.target.id === "tournament-image-lightbox-close") {
              e.preventDefault();
              closeTournamentLightbox();
              return;
            }

            var overlay = document.getElementById("tournament-image-lightbox");
            if (overlay && e.target === overlay) {
              closeTournamentLightbox();
            }
          });

          document.addEventListener("keydown", function(e) {
            if (e.key === "Escape") closeTournamentLightbox();
          });

          document.addEventListener("turbo:before-cache", function() {
            closeTournamentLightbox();
          });

          document.documentElement.dataset.tournamentLightboxBound = "1";
        }

        document.addEventListener("turbo:load", initTournamentImageLightbox);
        document.addEventListener("DOMContentLoaded", initTournamentImageLightbox);
      </script>
        </div>
        </div>
      </div>
    </div>
  </div>

  <% if @tournament.line_id.present? || @tournament.contact_phone.present? %>
    <% line_deep_link = @tournament.line_id.present? ? "line://ti/p/~#{@tournament.line_id}" : nil %>
    <% line_web_link  = @tournament.line_id.present? ? "https://line.me/R/ti/p/~#{@tournament.line_id}" : nil %>
    <% tel_raw = @tournament.contact_phone.to_s %>
    <% tel_href = "tel:#{tel_raw.gsub(/[^0-9+]/, '')}" %>

    <div class="mt-3">
      <div class="d-flex justify-content-center" style="gap:10px;flex-wrap:wrap;">
        <% if @tournament.line_id.present? %>
          <%= link_to "LINE: #{@tournament.line_id}",
                      line_deep_link,
                      class: "btn btn-success",
                      style: "min-width:200px;flex:1 1 0;max-width:260px;background-color:#00c300;border-color:#00c300;color:#ffffff;box-shadow:0 6px 18px rgba(0,0,0,0.18);border-radius:8px;padding:10px 12px;font-size:14px;",
                      target: "_blank",
                      rel: "noopener",
                      data: { fallback_url: line_web_link } %>
        <% end %>

        <% if @tournament.contact_phone.present? %>
          <%= link_to "โทร: #{@tournament.contact_phone}",
                      tel_href,
                      class: "btn btn-primary",
                      style: "min-width:200px;flex:1 1 0;max-width:260px;box-shadow:0 6px 18px rgba(0,0,0,0.18);border-radius:8px;padding:10px 12px;font-size:14px;" %>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
