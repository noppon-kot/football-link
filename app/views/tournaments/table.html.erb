<% content_for :og_title do %>
  <%= "ตารางคะแนน · #{@tournament.title}" %>
<% end %>
<% content_for :og_description do %>
  <%= ["ตารางคะแนนและสถิติ", tournament_competition_date_label(@tournament), @tournament.location_name.presence].compact.join(" · ") %>
<% end %>
<% content_for :og_url do %>
  <%= request.original_url %>
<% end %>
<% content_for :og_image do %>
  <%= begin
        if @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>
<% end %>

<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <style>
        .standings-scroll {
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          --rank-col-width: 28px;
          --team-col-width: 140px;
        }

        .standings-table {
          min-width: 560px;
        }

        @media (max-width: 768px) {
          .standings-table th,
          .standings-table td {
            padding-left: 6px;
            padding-right: 6px;
          }
        }

        @media (max-width: 576px) {
          .standings-table th,
          .standings-table td {
            padding-left: 4px;
            padding-right: 4px;
          }
        }

        .standings-scroll.is-overflowing .standings-sticky-rank {
          position: sticky;
          left: 0;
          z-index: 3;
          background: #ffffff;
        }

        .standings-scroll.is-overflowing .standings-sticky-team {
          position: sticky;
          left: var(--rank-col-width);
          z-index: 2;
          background: #ffffff;
          box-shadow: 8px 0 10px -10px rgba(0, 0, 0, 0.35);
        }

        .standings-scroll.is-overflowing thead .standings-sticky-rank,
        .standings-scroll.is-overflowing thead .standings-sticky-team {
          z-index: 4;
          background: #f8f9fa;
        }

        .standings-sticky-rank {
          width: var(--rank-col-width);
          min-width: var(--rank-col-width);
          max-width: var(--rank-col-width);
        }

        .standings-sticky-team {
          width: var(--team-col-width);
          min-width: var(--team-col-width);
          max-width: var(--team-col-width);
        }

        .standings-scroll.is-overflowing .standings-sticky-rank {
          border-right: 1px solid rgba(0,0,0,0.06);
        }

        .standings-scroll.is-overflowing .standings-sticky-team {
          border-right: 1px solid rgba(0,0,0,0.06);
        }

        .standings-col-pts {
          font-weight: 900;
        }
      </style>

      <div class="card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between" style="gap:10px;">
          <div class="fw-bold">ตารางคะแนน</div>
          <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#standingsDownloadModal" title="ดาวน์โหลดตารางคะแนน" style="line-height:1;padding:6px 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
              <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
        <div class="card-body">
          <% if can_manage_registrations?(@tournament) %>
            <div class="d-flex justify-content-between align-items-start mb-2" style="gap:12px;">
              <p class="mb-0" style="font-size:13px;color:#78909c;">
                ระบบจะคำนวณคะแนนอัตโนมัติจากผลการแข่งขันของแต่ละสาย เมื่อมีการบันทึกสกอร์แล้ว ด้านล่างจะแสดงตารางคะแนนแยกตามรุ่น
              </p>
              <%= link_to tiebreaker_tournament_path(@tournament), class: "btn btn-sm btn-outline-warning", style: "white-space:nowrap;" do %>
                <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
                  <path fill="currentColor" d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l4.59-4.58L18 11l-6 6z"/>
                </svg>
                จับสลาก
              <% end %>
            </div>
          <% end %>

          <% divisions = @tournament.tournament_divisions.order(:position, :id) %>
          <% all_matches = Match.where(tournament_division_id: divisions.map(&:id)).includes(:group, :home_team, :away_team) %>

          <% if divisions.any? %>
            <% sample_div = divisions.first %>
            <% win_pts  = sample_div.respond_to?(:points_win)  ? sample_div.points_win  : 3 %>
            <% draw_pts = sample_div.respond_to?(:points_draw) ? sample_div.points_draw : 1 %>
            <% loss_pts = sample_div.respond_to?(:points_loss) ? sample_div.points_loss : 0 %>
            <% draw_mode = sample_div.respond_to?(:draw_mode) ? (sample_div.draw_mode.presence || "normal") : "normal" %>
            <% pk_win_pts  = sample_div.respond_to?(:points_pk_win)  && sample_div.points_pk_win.present?  ? sample_div.points_pk_win  : draw_pts %>
            <% pk_loss_pts = sample_div.respond_to?(:points_pk_loss) && sample_div.points_pk_loss.present? ? sample_div.points_pk_loss : draw_pts %>

            <% if can_manage_registrations?(@tournament) %>
              <div class="d-flex align-items-center justify-content-between mb-2" style="gap:8px;">
                <div style="font-size:12px;color:#78909c;">ตั้งค่าคะแนน (ใช้ร่วมกันทุกรุ่น)</div>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#pointsSettingsModal"
                        aria-label="ตั้งค่าคะแนน"
                        style="line-height:1;padding:6px 8px;">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M19.4 13.5c.04-.5.04-1 0-1.5l2.1-1.6c.2-.2.25-.5.12-.7l-2-3.5c-.13-.23-.4-.33-.65-.25l-2.5 1c-.4-.3-.8-.5-1.3-.7l-.4-2.7c-.04-.26-.26-.46-.53-.46h-4c-.27 0-.5.2-.54.46l-.4 2.7c-.45.18-.9.42-1.3.7l-2.5-1c-.25-.1-.52.02-.65.25l-2 3.5c-.13.22-.08.5.12.7l2.1 1.6c-.04.5-.04 1 0 1.5l-2.1 1.6c-.2.2-.25.5-.12.7l2 3.5c.13.23.4.33.65.25l2.5-1c.4.3.8.5 1.3.7l.4 2.7c.04.26.27.46.54.46h4c.27 0 .5-.2.53-.46l.4-2.7c.45-.18.9-.42 1.3-.7l2.5 1c.25.1.52-.02.65-.25l2-3.5c.13-.22.08-.5-.12-.7l-2.1-1.6ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"/>
                  </svg>
                </button>
              </div>

              <div class="modal fade" id="pointsSettingsModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <div>
                        <div class="fw-bold">กำหนดคะแนน</div>
                        <div class="text-muted" style="font-size:12px;">ชนะ/เสมอ/แพ้ และกติกาเสมอ (ใช้ร่วมกันทุกรุ่น)</div>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                      <%= form_with url: update_points_tournament_path(@tournament), method: :patch, local: true do |f| %>
                        <div class="row g-2 align-items-end">
                          <div class="col-4 col-md-2" style="font-size:12px;">
                            <label class="form-label mb-0" style="font-size:11px;">ชนะ</label>
                            <input type="number" name="division[points_win]" min="0" max="10" class="form-control form-control-sm" value="<%= win_pts %>">
                          </div>
                          <div class="col-4 col-md-2" style="font-size:12px;">
                            <label class="form-label mb-0" style="font-size:11px;">เสมอ</label>
                            <input type="number" name="division[points_draw]" min="0" max="10" class="form-control form-control-sm" value="<%= draw_pts %>">
                          </div>
                          <div class="col-4 col-md-2" style="font-size:12px;">
                            <label class="form-label mb-0" style="font-size:11px;">แพ้</label>
                            <input type="number" name="division[points_loss]" min="0" max="10" class="form-control form-control-sm" value="<%= loss_pts %>">
                          </div>

                          <div class="col-12 col-md-6" style="font-size:12px;">
                            <label class="form-label mb-0" style="font-size:11px;">กติกากรณีเสมอ</label>
                            <select name="division[draw_mode]" class="form-select form-select-sm">
                              <option value="normal" <%= "selected" if draw_mode == "normal" %>>เสมอธรรมดา (ทีมละ <%= draw_pts %> แต้ม)</option>
                              <option value="pk" <%= "selected" if draw_mode == "pk" %>>เสมอแล้วยิงจุดโทษ</option>
                            </select>
                          </div>

                          <div class="col-6 col-md-3" style="font-size:12px;">
                            <label class="form-label mb-0" style="font-size:11px;">แต้มชนะจุดโทษ</label>
                            <input type="number" name="division[points_pk_win]" min="0" max="10" class="form-control form-control-sm" value="<%= pk_win_pts %>">
                          </div>
                          <div class="col-6 col-md-3" style="font-size:12px;">
                            <label class="form-label mb-0" style="font-size:11px;">แต้มแพ้จุดโทษ</label>
                            <input type="number" name="division[points_pk_loss]" min="0" max="10" class="form-control form-control-sm" value="<%= pk_loss_pts %>">
                          </div>

                          <div class="col-12">
                            <div class="text-muted" style="font-size:12px;">
                              ถ้าเลือก "เสมอแล้วยิงจุดโทษ" ให้ไปเลือกทีมที่ชนะจุดโทษในหน้าตารางแข่งขันของแต่ละนัดด้วย
                            </div>
                          </div>

                          <div class="col-12 d-flex justify-content-end" style="gap:8px;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                            <button type="submit" class="btn btn-sm btn-primary">บันทึก</button>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <% color_classes = ["border-primary", "border-success", "border-warning", "border-info", "border-danger"] %>

            <% divisions.each_with_index do |div, idx| %>
              <% color_class = color_classes[idx % color_classes.size] %>
              <% div_matches = all_matches.select { |m| m.tournament_division_id == div.id } %>

              <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f9fafb;">
                <div class="d-flex align-items-center mb-2" style="gap:8px;">
                  <div class="border-start border-4 <%= color_class %>" style="height:20px;"></div>
                  <div>
                    <div class="fw-bold" style="font-size:13px;">รุ่น <%= div.name %></div>
                    <div style="font-size:11px;color:#78909c;">ตารางคะแนนของรุ่นนี้ (จะแยกตามสาย และจะคำนวณจากผลการแข่งขันอัตโนมัติ)</div>
                  </div>
                </div>

                <% groups = div.groups.order(:name) %>

                <% if groups.any? %>
                  <% groups.each do |group| %>
                    <% group_matches = div_matches.select { |m| m.group_id == group.id } %>
                    <% team_ids = (group_matches.map(&:home_team_id) + group_matches.map(&:away_team_id)).compact.uniq %>
                    <% next if team_ids.empty? %>

                    <div class="mb-2">
                      <% card_id = "standings-card-#{div.id}-#{group.id}" %>
                      <% export_team_count = [team_ids.length, 10].min %>
                      <% export_base_height = 980 %>
                      <% export_row_height = 80 %>
                      <% export_max_height = 1350 %>
                      <% export_card_height = [export_base_height + (export_team_count * export_row_height), export_max_height].min %>
                      <div class="d-flex align-items-center justify-content-between mb-1" style="gap:8px;">
                        <div style="font-size:12px;color:#546e7a;">สาย <%= group.name %></div>
                        <% if team_ids.any? %>
                          <button type="button"
                                  class="btn btn-sm btn-success js-standings-export"
                                  data-target="<%= card_id %>"
                                  data-division-id="<%= div.id %>"
                                  data-group-id="<%= group.id %>"
                                  data-filename="standings_<%= div.name.to_s.gsub(' ', '_') %>_group_<%= group.name %>.png">
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                              <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
                            </svg>
                          </button>
                        <% end %>
                      </div>

                      <div id="<%= card_id %>" style="position:fixed;left:-10000px;top:0;width:1080px;height:<%= export_card_height %>px;overflow:hidden;">
                        <div data-theme-root style="position:relative;width:1080px;height:<%= export_card_height %>px;background:#071b14;">
                          <div style="position:absolute;inset:0;background-image:url('<%= asset_path("banner2.png") %>');background-size:cover;background-position:center;filter:brightness(0.45);"></div>
                          <div data-theme-gradient style="position:absolute;inset:0;background:linear-gradient(135deg, rgba(6,58,42,0.88) 0%, rgba(11,74,51,0.78) 45%, rgba(10,47,34,0.88) 100%);"></div>

                          <div style="position:absolute;left:54px;right:54px;top:48px;display:flex;justify-content:space-between;align-items:flex-start;gap:18px;">
                            <div>
                              <div data-theme-title style="font-size:50px;font-weight:900;letter-spacing:0.4px;line-height:1.05;color:#d7ff59;text-transform:uppercase;">
                                <%= @tournament.title %>
                              </div>
                              <div style="margin-top:12px;font-size:30px;font-weight:900;color:rgba(255,255,255,0.92);letter-spacing:0.8px;">ตารางคะแนน</div>
                              <div style="margin-top:8px;font-size:18px;color:rgba(255,255,255,0.88);">
                                รุ่น <%= div.name %> · สาย <%= group.name %>
                                <% show_top10_badge = team_ids.length > 10 %>
                                <% if show_top10_badge %>
                                  · Top 10
                                <% end %>
                              </div>
                            </div>
                          </div>

                          <div style="position:absolute;left:54px;right:54px;top:260px;bottom:120px;background:rgba(10,18,36,0.70);border:1px solid rgba(255,255,255,0.14);border-radius:18px;overflow:hidden;">
                            <div style="padding:18px 20px;">
                              <div style="display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid rgba(255,255,255,0.18);color:rgba(255,255,255,0.9);font-weight:900;font-size:15px;letter-spacing:0.6px;">
                                <div style="width:60px;text-align:center;">NO</div>
                                <div style="flex:1;">CLUB</div>
                                <div style="width:80px;text-align:center;">แต้ม</div>
                                <div style="width:60px;text-align:center;">แข่ง</div>
                                <div style="width:60px;text-align:center;">ชนะ</div>
                                <div style="width:60px;text-align:center;">แพ้</div>
                                <div style="width:60px;text-align:center;">เสมอ</div>
                                <div style="width:70px;text-align:center;">ประตู</div>
                              </div>

                              <% if team_ids.any? %>
                                <% stats = {} %>
                                <% team_ids.each do |tid| %>
                                  <% stats[tid] = { played: 0, won: 0, draw: 0, lost: 0, gf: 0, ga: 0, pts: 0 } %>
                                <% end %>

                                <% group_matches.each do |match| %>
                                  <% next if match.home_team_id.blank? || match.away_team_id.blank? %>
                                  <% next unless match.home_score.present? && match.away_score.present? %>

                                  <% h_id = match.home_team_id %>
                                  <% a_id = match.away_team_id %>
                                  <% hs  = match.home_score.to_i %>
                                  <% as  = match.away_score.to_i %>

                                  <% stats[h_id][:played] += 1 %>
                                  <% stats[a_id][:played] += 1 %>
                                  <% stats[h_id][:gf] += hs; stats[h_id][:ga] += as %>
                                  <% stats[a_id][:gf] += as; stats[a_id][:ga] += hs %>

                                  <% if hs > as %>
                                    <% stats[h_id][:won]  += 1; stats[h_id][:pts] += win_pts %>
                                    <% stats[a_id][:lost] += 1; stats[a_id][:pts] += loss_pts %>
                                  <% elsif hs < as %>
                                    <% stats[a_id][:won]  += 1; stats[a_id][:pts] += win_pts %>
                                    <% stats[h_id][:lost] += 1; stats[h_id][:pts] += loss_pts %>
                                  <% else %>
                                    <% if draw_mode == "pk" && match.decided_by_penalty && match.penalty_winner_side.present? %>
                                      <% if match.penalty_winner_side == "home" %>
                                        <% winner_id = h_id; loser_id = a_id %>
                                      <% else %>
                                        <% winner_id = a_id; loser_id = h_id %>
                                      <% end %>

                                      <% stats[winner_id][:draw] += 1; stats[winner_id][:pts] += pk_win_pts %>
                                      <% stats[loser_id][:draw]  += 1; stats[loser_id][:pts]  += pk_loss_pts %>
                                    <% else %>
                                      <% stats[h_id][:draw] += 1; stats[h_id][:pts] += draw_pts %>
                                      <% stats[a_id][:draw] += 1; stats[a_id][:pts] += draw_pts %>
                                    <% end %>
                                  <% end %>
                                <% end %>

                                <% sorted = team_ids.map { |tid| 
                                  team_reg = TeamRegistration.find_by(tournament_id: @tournament.id, tournament_division_id: div.id, group_id: group.id, team_id: tid)
                                  team_reg ||= TeamRegistration.find_by(tournament_id: @tournament.id, tournament_division_id: div.id, team_id: tid)
                                  team_reg ||= TeamRegistration.find_by(tournament_id: @tournament.id, team_id: tid)
                                  tiebreaker = team_reg&.tiebreaker_rank || 999
                                  [tid, stats[tid].merge(tiebreaker_rank: tiebreaker)]
                                }.sort_by { |tid, s| [-s[:pts], s[:tiebreaker_rank], -(s[:gf] - s[:ga]), -s[:gf], Team.find(tid).name] } %>
                              <% sorted.first(10).each_with_index do |(tid, s), idx| %>
                                <% team = Team.find(tid) %>
                                <% gd = s[:gf] - s[:ga] %>
                                <div style="display:flex;align-items:center;gap:10px;padding:14px 0;border-top:1px solid rgba(255,255,255,0.18);">
                                    <div style="width:60px;text-align:center;color:#ffffff;font-weight:900;font-size:20px;"><%= idx + 1 %></div>
                                    <div style="flex:1;display:flex;align-items:center;gap:12px;min-width:0;">
                                      <% if team.logo.attached? %>
                                        <%= image_tag team.logo, style: "width:48px;height:48px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,0.12);", crossorigin: "anonymous" %>
                                      <% else %>
                                        <div style="width:48px;height:48px;border-radius:999px;background:rgba(255,255,255,0.12);"></div>
                                      <% end %>
                                      <div style="font-size:24px;font-weight:900;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= team.name %></div>
                                    </div>
                                    <div style="width:80px;text-align:center;color:#ffffff;font-weight:900;font-size:24px;"><%= s[:pts] %></div>
                                    <div style="width:60px;text-align:center;color:#ffffff;font-weight:900;font-size:18px;"><%= s[:played] %></div>
                                    <div style="width:60px;text-align:center;color:#ffffff;font-weight:900;font-size:18px;"><%= s[:won] %></div>
                                    <div style="width:60px;text-align:center;color:#ffffff;font-weight:900;font-size:18px;"><%= s[:lost] %></div>
                                    <div style="width:60px;text-align:center;color:#ffffff;font-weight:900;font-size:18px;"><%= s[:draw] %></div>
                                    <div style="width:70px;text-align:center;color:#ffffff;font-weight:900;font-size:18px;"><%= s[:gf] %></div>
                                  </div>
                                <% end %>
                              <% else %>
                                <div style="padding:26px 0;color:rgba(255,255,255,0.85);font-size:18px;font-weight:700;">ยังไม่มีข้อมูลตารางคะแนน</div>
                              <% end %>
                            </div>
                          </div>

                          <div style="position:absolute;left:54px;right:54px;bottom:54px;display:flex;justify-content:flex-end;">
                            <div style="display:flex;align-items:center;gap:10px;color:rgba(255,255,255,0.92);border:1px solid rgba(255,255,255,0.18);background:rgba(255,255,255,0.08);padding:10px 14px;border-radius:14px;white-space:nowrap;">
                              <%= image_tag "dernsai_icon.png", alt: "DERNSAI", style: "width:28px;height:28px;border-radius:8px;object-fit:contain;background:rgba(255,255,255,0.08);padding:4px;", crossorigin: "anonymous" %>
                              <span style="font-size:14px;font-weight:800;letter-spacing:0.6px;">DERNSAI.COM</span>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div class="text-muted mb-1" style="font-size:10px;">
                        <span title="ใช้สำหรับเปรียบเทียบทีมอันดับ 2 ที่ดีที่สุดข้ามสาย">💡 คอลัมน์ "แต้ม/นัด" และ "+/-/นัด" ใช้สำหรับเปรียบเทียบทีมข้ามสายที่มีจำนวนนัดไม่เท่ากัน</span>
                      </div>
                      <div class="table-responsive standings-scroll">
                        <table class="table table-sm align-middle mb-0 standings-table">
                          <thead class="table-light">
                            <tr>
                              <th scope="col" class="text-start standings-sticky-rank" style="width:28px;font-size:12px;">#</th>
                              <th scope="col" class="standings-sticky-team" style="width:140px;">ทีม</th>
                              <th scope="col" class="text-center standings-col-pts" style="width:56px;">แต้ม</th>
                              <th scope="col" class="text-center" style="width:44px;">แข่ง</th>
                              <th scope="col" class="text-center" style="width:44px;">ชนะ</th>
                              <th scope="col" class="text-center" style="width:44px;">แพ้</th>
                              <th scope="col" class="text-center" style="width:44px;">เสมอ</th>
                              <th scope="col" class="text-center" style="width:56px;">ประตู</th>
                              <th scope="col" class="text-center" style="width:56px;font-size:10px;" title="แต้มเฉลี่ยต่อนัด">แต้ม/นัด</th>
                              <th scope="col" class="text-center" style="width:56px;font-size:10px;" title="ผลต่างประตูเฉลี่ยต่อนัด">+/-/นัด</th>
                            </tr>
                          </thead>
                          <tbody>
                            <% if team_ids.any? %>
                              <% stats = {} %>
                              <% team_ids.each do |tid| %>
                                <% stats[tid] = { played: 0, won: 0, draw: 0, lost: 0, gf: 0, ga: 0, pts: 0 } %>
                              <% end %>

                              <% group_matches.each do |match| %>
                                <% next if match.home_team_id.blank? || match.away_team_id.blank? %>
                                <% next unless match.home_score.present? && match.away_score.present? %>

                                <% h_id = match.home_team_id %>
                                <% a_id = match.away_team_id %>
                                <% hs  = match.home_score.to_i %>
                                <% as  = match.away_score.to_i %>

                                <% stats[h_id][:played] += 1 %>
                                <% stats[a_id][:played] += 1 %>
                                <% stats[h_id][:gf] += hs; stats[h_id][:ga] += as %>
                                <% stats[a_id][:gf] += as; stats[a_id][:ga] += hs %>

                                <% if hs > as %>
                                  <% stats[h_id][:won]  += 1; stats[h_id][:pts] += win_pts %>
                                  <% stats[a_id][:lost] += 1; stats[a_id][:pts] += loss_pts %>
                                <% elsif hs < as %>
                                  <% stats[a_id][:won]  += 1; stats[a_id][:pts] += win_pts %>
                                  <% stats[h_id][:lost] += 1; stats[h_id][:pts] += loss_pts %>
                                <% else %>
                                  <% if draw_mode == "pk" && match.decided_by_penalty && match.penalty_winner_side.present? %>
                                    <% if match.penalty_winner_side == "home" %>
                                      <% winner_id = h_id; loser_id = a_id %>
                                    <% else %>
                                      <% winner_id = a_id; loser_id = h_id %>
                                    <% end %>

                                    <% stats[winner_id][:draw] += 1; stats[winner_id][:pts] += pk_win_pts %>
                                    <% stats[loser_id][:draw]  += 1; stats[loser_id][:pts]  += pk_loss_pts %>
                                  <% else %>
                                    <% stats[h_id][:draw] += 1; stats[h_id][:pts] += draw_pts %>
                                    <% stats[a_id][:draw] += 1; stats[a_id][:pts] += draw_pts %>
                                  <% end %>
                                <% end %>
                              <% end %>

                              <% sorted = team_ids.map { |tid| 
                                team_reg = TeamRegistration.find_by(tournament_id: @tournament.id, tournament_division_id: div.id, group_id: group.id, team_id: tid)
                                team_reg ||= TeamRegistration.find_by(tournament_id: @tournament.id, tournament_division_id: div.id, team_id: tid)
                                team_reg ||= TeamRegistration.find_by(tournament_id: @tournament.id, team_id: tid)
                                tiebreaker = team_reg&.tiebreaker_rank || 999
                                [tid, stats[tid].merge(tiebreaker_rank: tiebreaker)]
                              }.sort_by { |tid, s| [-s[:pts], s[:tiebreaker_rank], -(s[:gf] - s[:ga]), -s[:gf], Team.find(tid).name] } %>

                              <% sorted.each_with_index do |(tid, s), idx| %>
                                <% team = Team.find(tid) %>
                                <% gd = s[:gf] - s[:ga] %>
                                <% leader_row = (idx == 0) %>
                                <% played_safe = [s[:played], 1].max %>
                                <% pts_avg = (s[:pts].to_f / played_safe).round(2) %>
                                <% gd_avg = ((s[:gf] - s[:ga]).to_f / played_safe).round(2) %>
                                <tr<%= ' style="background-color:#fffde7;"' if leader_row %>>
                                  <td class="text-start standings-sticky-rank" style="font-size:12px;"><%= idx + 1 %></td>
                                  <td class="standings-sticky-team">
                                    <div class="d-flex align-items-center" style="gap:4px;">
                                      <% if team.logo.attached? %>
                                        <%= image_tag team.logo,
                                                      class: "rounded-circle",
                                                      style: "width:20px;height:20px;object-fit:cover;" %>
                                      <% end %>
                                      <span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= team.name %></span>
                                    </div>
                                  </td>
                                  <td class="text-center standings-col-pts"><%= s[:pts] %></td>
                                  <td class="text-center"><%= s[:played] %></td>
                                  <td class="text-center"><%= s[:won] %></td>
                                  <td class="text-center"><%= s[:lost] %></td>
                                  <td class="text-center"><%= s[:draw] %></td>
                                  <td class="text-center"><%= s[:gf] %></td>
                                  <td class="text-center" style="font-size:11px;color:#1976d2;" title="แต้มเฉลี่ย <%= pts_avg %> ต่อนัด"><%= pts_avg %></td>
                                  <td class="text-center" style="font-size:11px;color:<%= gd_avg >= 0 ? '#388e3c' : '#d32f2f' %>;" title="ผลต่างประตูเฉลี่ย <%= gd_avg %> ต่อนัด"><%= gd_avg >= 0 ? "+#{gd_avg}" : gd_avg %></td>
                                </tr>
                              <% end %>
                            <% else %>
                              <tr>
                                <td colspan="10" class="text-center text-muted" style="font-size:13px;">
                                  ยังไม่มีทีมในสายนี้ (หรือยังไม่ได้จัดทีมลงสาย)
                                </td>
                              </tr>
                            <% end %>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  <% end %>
                <% else %>
                  <% div_team_ids = (div_matches.map(&:home_team_id) + div_matches.map(&:away_team_id)).compact.uniq %>
                  <% if div_team_ids.any? %>
                    <% card_id = "standings-card-#{div.id}-no-group" %>
                    <div class="d-flex align-items-center justify-content-between mb-1" style="gap:8px;">
                      <div style="font-size:12px;color:#546e7a;">ตารางคะแนนรุ่นนี้</div>
                      <button type="button"
                              class="btn btn-sm btn-success js-standings-export"
                              data-target="<%= card_id %>"
                              data-division-id="<%= div.id %>"
                              data-filename="standings_<%= div.name.to_s.gsub(' ', '_') %>.png">
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                          <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
                        </svg>
                      </button>
                    </div>
                    <div class="table-responsive">
                      <div id="<%= card_id %>">
                        <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                          <tr>
                            <th scope="col">ทีม</th>
                            <th scope="col" class="text-center">แต้ม</th>
                            <th scope="col" class="text-center">แข่ง</th>
                            <th scope="col" class="text-center">ชนะ</th>
                            <th scope="col" class="text-center">แพ้</th>
                            <th scope="col" class="text-center">เสมอ</th>
                            <th scope="col" class="text-center">ประตู</th>
                          </tr>
                        </thead>
                        <tbody>
                          <tr>
                            <td colspan="7" class="text-center text-muted" style="font-size:13px;">
                              ยังไม่มีการแบ่งสายสำหรับรุ่นนี้
                            </td>
                          </tr>
                        </tbody>
                        </table>
                      </div>
                    </div>
                  <% end %>
                <% end %>

                <% top_scorers = (@top_scorers_by_division && @top_scorers_by_division[div.id]) || [] %>
                <% if top_scorers.any? %>
                  <div class="card shadow-sm mt-3">
                    <div class="card-header fw-bold">ดาวซัลโว (Top 3)</div>
                    <div class="card-body">
                      <div class="d-flex flex-column" style="gap:8px;">
                        <% top_scorers.each_with_index do |(player, goals), idx| %>
                          <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                            <div style="min-width:0;">
                              <div style="font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                <%= idx + 1 %>. <%= player.full_name %>
                              </div>
                              <div class="text-muted" style="font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                <%= player.team_registration&.team&.name %>
                              </div>
                            </div>
                            <div class="d-flex align-items-center" style="gap:6px;flex:0 0 auto;">
                              <%= image_tag "football.png", alt: "goal", style: "width:16px;height:16px;object-fit:contain;display:block;" %>
                              <div style="font-weight:900;">
                                <%= goals %>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="mb-0 text-muted" style="font-size:13px;">ยังไม่มีการกำหนดรุ่นการแข่งขันสำหรับรายการนี้</p>
          <% end %>
        </div>
      </div>

      <div class="modal fade" id="standingsDownloadModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
          <div class="modal-content">
            <div class="modal-header">
              <div class="fw-bold">ดาวน์โหลดตารางคะแนน</div>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:0;">
              <div class="p-3 border-bottom" style="background:#f8f9fa;">
                <div class="d-flex align-items-center flex-wrap" style="gap:12px;">
                  <div>
                    <label class="form-label mb-1" style="font-size:11px;color:#6b7280;">เลือกรุ่น</label>
                    <select id="standings-download-division" class="form-select form-select-sm" style="width:auto;min-width:120px;">
                      <% divisions.each do |div| %>
                        <option value="<%= div.id %>"><%= div.name %></option>
                      <% end %>
                    </select>
                  </div>
                  <div>
                    <label class="form-label mb-1" style="font-size:11px;color:#6b7280;">เลือกสาย</label>
                    <div id="standings-download-groups" style="display:flex;gap:6px;flex-wrap:wrap;">
                    </div>
                  </div>
                  <div class="ms-auto">
                    <button type="button" id="standings-select-all" class="btn btn-sm btn-outline-secondary" style="font-size:11px;">เลือกทั้งหมด</button>
                  </div>
                </div>
              </div>
              
              <div id="standings-download-preview-container" style="max-height:50vh;overflow:auto;padding:16px;">
                <div id="standings-download-capture" style="background:#fff;padding:16px;display:inline-block;min-width:400px;">
                  <div id="standings-compact-tables" style="display:flex;flex-wrap:wrap;gap:16px;">
                  </div>
                  <div style="margin-top:12px;padding-top:8px;border-top:1px solid #e2e8f0;display:flex;justify-content:flex-end;align-items:center;gap:4px;">
                    <%= image_tag "dernsai_icon.png", alt: "DERNSAI", style: "width:16px;height:16px;border-radius:4px;object-fit:contain;" %>
                    <span style="font-size:10px;font-weight:600;color:#94a3b8;">DERNSAI.COM</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
              <button type="button" id="standings-download-btn" class="btn btn-sm btn-success">
                <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
                  <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
                </svg>
                ดาวน์โหลดรูป
              </button>
            </div>
          </div>
        </div>
      </div>

      <script>
        (function() {
          var divisionsData = <%= raw divisions.map { |div|
            groups = div.groups.order(:name)
            div_matches = all_matches.select { |m| m.tournament_division_id == div.id }
            
            groups_data = groups.map { |group|
              group_matches = div_matches.select { |m| m.group_id == group.id }
              team_ids = (group_matches.map(&:home_team_id) + group_matches.map(&:away_team_id)).compact.uniq
              
              stats = {}
              team_ids.each { |tid| stats[tid] = { played: 0, won: 0, draw: 0, lost: 0, gf: 0, ga: 0, pts: 0 } }
              
              group_matches.each do |match|
                next if match.home_team_id.blank? || match.away_team_id.blank?
                next unless match.home_score.present? && match.away_score.present?
                
                h_id = match.home_team_id
                a_id = match.away_team_id
                hs = match.home_score.to_i
                as = match.away_score.to_i
                
                stats[h_id][:played] += 1
                stats[a_id][:played] += 1
                stats[h_id][:gf] += hs; stats[h_id][:ga] += as
                stats[a_id][:gf] += as; stats[a_id][:ga] += hs
                
                if hs > as
                  stats[h_id][:won] += 1; stats[h_id][:pts] += (div.points_win || 3)
                  stats[a_id][:lost] += 1; stats[a_id][:pts] += (div.points_loss || 0)
                elsif hs < as
                  stats[a_id][:won] += 1; stats[a_id][:pts] += (div.points_win || 3)
                  stats[h_id][:lost] += 1; stats[h_id][:pts] += (div.points_loss || 0)
                else
                  stats[h_id][:draw] += 1; stats[h_id][:pts] += (div.points_draw || 1)
                  stats[a_id][:draw] += 1; stats[a_id][:pts] += (div.points_draw || 1)
                end
              end
              
              teams_sorted = team_ids.map { |tid|
                team = Team.find(tid)
                s = stats[tid]
                team_reg = TeamRegistration.find_by(tournament_id: @tournament.id, tournament_division_id: div.id, group_id: group.id, team_id: tid)
                team_reg ||= TeamRegistration.find_by(tournament_id: @tournament.id, tournament_division_id: div.id, team_id: tid)
                team_reg ||= TeamRegistration.find_by(tournament_id: @tournament.id, team_id: tid)
                tiebreaker = team_reg&.tiebreaker_rank || 999
                { id: tid, name: team.name, logo_url: (team.logo.attached? ? Rails.application.routes.url_helpers.rails_blob_path(team.logo, only_path: true) : nil), pts: s[:pts], played: s[:played], won: s[:won], draw: s[:draw], lost: s[:lost], gf: s[:gf], ga: s[:ga], tiebreaker_rank: tiebreaker }
              }.sort_by { |t| [-t[:pts], t[:tiebreaker_rank], -(t[:gf] - t[:ga]), -t[:gf], t[:name]] }
              
              { id: group.id, name: group.name, teams: teams_sorted }
            }.select { |g| g[:teams].any? }
            
            { id: div.id, name: div.name, groups: groups_data }
          }.to_json %>;

          var divSelect = document.getElementById('standings-download-division');
          var groupsContainer = document.getElementById('standings-download-groups');
          var tablesContainer = document.getElementById('standings-compact-tables');
          var downloadBtn = document.getElementById('standings-download-btn');
          var selectAllBtn = document.getElementById('standings-select-all');
          var selectedGroups = {};

          function getCurrentDivision() {
            var divId = parseInt(divSelect.value, 10);
            return divisionsData.find(function(d) { return d.id === divId; });
          }

          function updateGroupCheckboxes() {
            var div = getCurrentDivision();
            if (!div) return;
            
            selectedGroups = {};
            groupsContainer.innerHTML = '';
            
            div.groups.forEach(function(g) {
              selectedGroups[g.id] = true;
              
              var label = document.createElement('label');
              label.className = 'btn btn-sm btn-outline-success';
              label.style.cssText = 'font-size:12px;padding:4px 10px;';
              
              var checkbox = document.createElement('input');
              checkbox.type = 'checkbox';
              checkbox.checked = true;
              checkbox.value = g.id;
              checkbox.style.display = 'none';
              checkbox.addEventListener('change', function() {
                selectedGroups[g.id] = this.checked;
                label.classList.toggle('active', this.checked);
                label.classList.toggle('btn-success', this.checked);
                label.classList.toggle('btn-outline-success', !this.checked);
                renderTables();
              });
              
              label.appendChild(checkbox);
              label.appendChild(document.createTextNode('สาย ' + g.name));
              label.classList.add('active', 'btn-success');
              label.classList.remove('btn-outline-success');
              
              groupsContainer.appendChild(label);
            });
            
            renderTables();
          }

          function renderTables() {
            var div = getCurrentDivision();
            if (!div) return;
            
            var selectedGroupIds = Object.keys(selectedGroups).filter(function(k) { return selectedGroups[k]; }).map(Number);
            var groupsToRender = div.groups.filter(function(g) { return selectedGroupIds.includes(g.id); });
            
            tablesContainer.innerHTML = '';
            
            if (groupsToRender.length === 0) {
              tablesContainer.innerHTML = '<div class="text-muted" style="padding:20px;">กรุณาเลือกสายที่ต้องการ</div>';
              return;
            }
            
            groupsToRender.forEach(function(g) {
              var tableDiv = document.createElement('div');
              tableDiv.style.cssText = 'display:inline-block;';
              
              var html = '<div style="background:#f8f9fa;padding:8px 12px;border-radius:6px 6px 0 0;font-weight:700;font-size:13px;white-space:nowrap;">รุ่น ' + div.name + ' · สาย ' + g.name + '</div>';
              html += '<table style="border-collapse:collapse;font-size:13px;width:100%;">';
              html += '<thead style="background:#e2e8f0;"><tr>';
              html += '<th style="padding:8px 10px;text-align:center;white-space:nowrap;width:40px;">#</th>';
              html += '<th style="padding:8px 16px;white-space:nowrap;min-width:150px;">ทีม</th>';
              html += '<th style="padding:8px 12px;text-align:center;font-weight:900;white-space:nowrap;">คะแนน</th>';
              html += '<th style="padding:8px 12px;text-align:center;white-space:nowrap;">แข่ง</th>';
              html += '<th style="padding:8px 12px;text-align:center;white-space:nowrap;">ชนะ</th>';
              html += '<th style="padding:8px 12px;text-align:center;white-space:nowrap;">เสมอ</th>';
              html += '<th style="padding:8px 12px;text-align:center;white-space:nowrap;">แพ้</th>';
              html += '<th style="padding:8px 12px;text-align:center;white-space:nowrap;">ประตู</th>';
              html += '</tr></thead><tbody>';
              
              g.teams.forEach(function(t, idx) {
                var bgColor = idx === 0 ? '#fffde7' : (idx % 2 === 0 ? '#fff' : '#f9fafb');
                html += '<tr style="background:' + bgColor + ';">';
                html += '<td style="padding:10px 10px;text-align:center;font-weight:600;">' + (idx + 1) + '</td>';
                var logoHtml = t.logo_url ? '<img src="' + t.logo_url + '" style="width:20px;height:20px;border-radius:50%;object-fit:cover;margin-right:6px;vertical-align:middle;">' : '';
                html += '<td style="padding:10px 16px;white-space:nowrap;">' + logoHtml + t.name + '</td>';
                html += '<td style="padding:10px 12px;text-align:center;font-weight:900;">' + t.pts + '</td>';
                html += '<td style="padding:10px 12px;text-align:center;">' + t.played + '</td>';
                html += '<td style="padding:10px 12px;text-align:center;">' + t.won + '</td>';
                html += '<td style="padding:10px 12px;text-align:center;">' + t.draw + '</td>';
                html += '<td style="padding:10px 12px;text-align:center;">' + t.lost + '</td>';
                html += '<td style="padding:10px 12px;text-align:center;">' + t.gf + '</td>';
                html += '</tr>';
              });
              
              html += '</tbody></table>';
              tableDiv.innerHTML = html;
              tablesContainer.appendChild(tableDiv);
            });
          }

          if (divSelect) {
            divSelect.addEventListener('change', updateGroupCheckboxes);
          }

          if (selectAllBtn) {
            selectAllBtn.addEventListener('click', function() {
              var checkboxes = groupsContainer.querySelectorAll('input[type="checkbox"]');
              var allChecked = Array.from(checkboxes).every(function(cb) { return cb.checked; });
              
              checkboxes.forEach(function(cb) {
                cb.checked = !allChecked;
                cb.dispatchEvent(new Event('change'));
              });
            });
          }

          if (downloadBtn) {
            downloadBtn.addEventListener('click', function() {
              var captureEl = document.getElementById('standings-download-capture');
              if (captureEl && typeof html2canvas !== 'undefined') {
                html2canvas(captureEl, { scale: 2, useCORS: true, backgroundColor: '#ffffff' }).then(function(canvas) {
                  var link = document.createElement('a');
                  var div = getCurrentDivision();
                  var divName = div ? div.name.replace(/\s+/g, '').toLowerCase() : 'all';
                  var selectedGroupIds = Object.keys(selectedGroups).filter(function(k) { return selectedGroups[k]; }).map(Number);
                  var groupNames = div ? div.groups.filter(function(g) { return selectedGroupIds.includes(g.id); }).map(function(g) { return g.name; }).join('') : '';
                  var timestamp = Date.now().toString(36);
                  link.download = 'table_' + divName + '_group' + (groupNames || 'all') + '_' + timestamp + '.png';
                  link.href = canvas.toDataURL('image/png');
                  link.click();
                });
              }
            });
          }

          var modal = document.getElementById('standingsDownloadModal');
          if (modal) {
            modal.addEventListener('shown.bs.modal', function() {
              updateGroupCheckboxes();
            });
          }
        })();
      </script>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
  <script>
    (function() {
      if (window.__standingsExportInitialized) return;
      window.__standingsExportInitialized = true;

      function ensureWaitOverlay() {
        var el = document.getElementById('global-wait-overlay');
        if (el) return el;
        el = document.createElement('div');
        el.id = 'global-wait-overlay';
        el.style.display = 'none';
        el.style.position = 'fixed';
        el.style.inset = '0';
        el.style.zIndex = '2000';
        el.style.background = 'rgba(0,0,0,0.55)';
        el.style.alignItems = 'center';
        el.style.justifyContent = 'center';
        el.style.padding = '16px';
        el.innerHTML = '' +
          '<div style="background:#ffffff;border-radius:14px;padding:16px 18px;min-width:220px;max-width:92vw;box-shadow:0 12px 30px rgba(0,0,0,0.25);">' +
          '  <div class="d-flex align-items-center" style="gap:10px;">' +
          '    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>' +
          '    <div style="font-weight:700;">กำลังประมวลผล...</div>' +
          '  </div>' +
          '  <div class="text-muted" style="font-size:12px;margin-top:6px;">กรุณารอสักครู่</div>' +
          '</div>';
        document.body.appendChild(el);
        return el;
      }

      function showWaitOverlay() {
        var el = ensureWaitOverlay();
        el.style.display = 'flex';
      }

      function hideWaitOverlay() {
        var el = document.getElementById('global-wait-overlay');
        if (el) el.style.display = 'none';
      }

      function ensureModal() {
        var existing = document.getElementById('standings-snapshot-modal');
        if (existing) return existing;

        var modal = document.createElement('div');
        modal.id = 'standings-snapshot-modal';
        modal.style.display = 'none';
        modal.style.position = 'fixed';
        modal.style.inset = '0';
        modal.style.zIndex = '1055';
        modal.style.background = 'rgba(0,0,0,0.72)';
        modal.style.padding = '16px';
        modal.style.overflow = 'auto';

        modal.innerHTML = '' +
          '<div style="min-height:100%;display:flex;align-items:center;justify-content:center;">' +
          '  <div style="position:relative;max-width:min(500px, 96vw);width:100%;">' +
          '    <div style="position:absolute;top:-10px;right:-10px;display:flex;gap:8px;">' +
          '      <button type="button" data-standings-snapshot-download title="Save" aria-label="Save" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.55);color:#fff;line-height:1;display:flex;align-items:center;justify-content:center;">' +
          '        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">' +
          '          <path d="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4Zm-5 18a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM6 8V5h9v3H6Z" fill="currentColor"/>' +
          '        </svg>' +
          '      </button>' +
          '      <button type="button" data-standings-snapshot-close style="width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.55);color:#fff;font-size:22px;line-height:1;">×</button>' +
          '    </div>' +
          '    <img data-standings-snapshot-modal-img alt="Standings snapshot" style="width:100%;height:auto;border-radius:14px;display:block;background:#fff;" />' +
          '  </div>' +
          '</div>';

        document.body.appendChild(modal);

        modal.addEventListener('click', function(e) {
          if (e.target === modal) {
            modal.style.display = 'none';
          }
        });
        modal.querySelector('[data-standings-snapshot-close]').addEventListener('click', function() {
          modal.style.display = 'none';
        });

        modal.querySelector('[data-standings-snapshot-download]').addEventListener('click', function() {
          var img = modal.querySelector('[data-standings-snapshot-modal-img]');
          if (!img || !img.src) return;

          var filename = modal.getAttribute('data-filename') || 'standings.png';
          if (img.src.indexOf('data:image') === 0) {
            var a = document.createElement('a');
            a.href = img.src;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          } else {
            window.open(img.src, '_blank');
          }
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape') {
            modal.style.display = 'none';
          }
        });

        return modal;
      }

      function setModalImage(src, filename) {
        var modal = ensureModal();
        var modalImg = modal.querySelector('[data-standings-snapshot-modal-img]');
        modalImg.src = src;
        modal.setAttribute('data-current-src', src);
        if (filename) modal.setAttribute('data-filename', filename);
        modal.style.display = 'block';
      }

      document.addEventListener('click', async function(e) {
        var btn = e.target.closest('.js-standings-export');
        if (!btn) return;

        if (btn.getAttribute('data-busy') === '1') return;
        btn.setAttribute('data-busy', '1');

        var targetId = btn.getAttribute('data-target');
        if (!targetId) return;

        var target = document.getElementById(targetId);
        if (!target) return;

        var filename = btn.getAttribute('data-filename') || 'standings.png';

        var oldText = btn.innerText;
        try {
          btn.disabled = true;
          showWaitOverlay();

          var canvas = await html2canvas(target, {
            backgroundColor: '#ffffff',
            scale: 2,
            useCORS: true
          });
          var dataUrl = canvas.toDataURL('image/png');
          setModalImage(dataUrl, filename);

          var a = document.createElement('a');
          a.href = dataUrl;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        } catch (err) {
          console.error(err);
          alert('สร้างรูปไม่สำเร็จ');
        } finally {
          btn.disabled = false;
          btn.innerText = oldText;
          btn.setAttribute('data-busy', '0');
          hideWaitOverlay();
        }
      });
    })();
  </script>

  <script>
    (function() {
      function updateStandingsOverflowState() {
        var els = document.querySelectorAll('.standings-scroll');
        els.forEach(function(el) {
          var isOverflowing = el.scrollWidth > el.clientWidth;
          el.classList.toggle('is-overflowing', isOverflowing);
        });
      }

      window.addEventListener('resize', updateStandingsOverflowState);
      window.addEventListener('load', updateStandingsOverflowState);
      document.addEventListener('DOMContentLoaded', updateStandingsOverflowState);
    })();
  </script>
</div>
