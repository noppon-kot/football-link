<% content_for :og_title do %>
  <%= "ทีม · #{@tournament.title}" %>
<% end %>
<% content_for :og_description do %>
  <%= ["รายชื่อทีมที่สมัคร/สนใจ", tournament_competition_date_label(@tournament), @tournament.location_name.presence].compact.join(" · ") %>
<% end %>
<% content_for :og_url do %>
  <%= request.original_url %>
<% end %>
<% content_for :og_image do %>
  <%= begin
        if @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>
<% end %>

<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <div class="team-list-card card shadow-sm mx-auto" style="max-width:780px;">
        <div class="team-list-header d-flex justify-content-between align-items-center">
          <span>ทีมที่สนใจ / สมัคร</span>
          <div class="d-flex align-items-center" style="gap:6px;">
            <% show_mine = params[:mine].to_s == "1" %>
            <% can_manage_sensitive = current_user.present? && (admin? || @tournament.organizer_id == current_user.id) %>
            <% if current_user.present? %>
              <%= link_to teams_tournament_path(@tournament, mine: (show_mine ? nil : 1)),
                    class: (show_mine ? "btn btn-sm btn-primary" : "btn btn-sm btn-outline-primary"),
                    title: "ทีมของฉัน",
                    data: { bs_toggle: "tooltip", bs_placement: "top" },
                    aria: { label: "ทีมของฉัน" },
                    style: "line-height:1;padding:6px 10px;" do %>
                ทีมของฉัน
              <% end %>

              <% if show_mine %>
                <%= link_to teams_tournament_path(@tournament),
                      class: "btn btn-sm btn-outline-secondary",
                      title: "แสดงทั้งหมด",
                      data: { bs_toggle: "tooltip", bs_placement: "top" },
                      aria: { label: "แสดงทั้งหมด" },
                      style: "line-height:1;padding:6px 10px;" do %>
                  ทั้งหมด
                <% end %>
              <% end %>
            <% end %>

            <% if can_manage_sensitive %>
              <%= link_to new_tournament_team_registration_path(@tournament),
                          class: "btn btn-sm btn-outline-secondary",
                          title: "เพิ่มทีมใหม่",
                          data: { bs_toggle: "tooltip", bs_placement: "top" },
                          aria: { label: "เพิ่มทีมใหม่" },
                          style: "line-height:1;padding:6px 8px;" do %>
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M11 5h2v14h-2zM5 11h14v2H5z" fill="currentColor"/>
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
        <% divisions = @tournament.tournament_divisions.order(:position, :id).to_a %>
        <% regs_without_div = @tournament.team_registrations.where(tournament_division_id: nil).includes(:team, :team_registration_managers).to_a %>
        <% status_order = { "confirmed" => 0, "paid" => 0, "applied" => 1, "interested" => 1 } %>
        <% show_mine = params[:mine].to_s == "1" %>

        <% if divisions.any? || @tournament.team_registrations.any? %>
          <% color_classes = ["border-primary", "border-success", "border-warning", "border-info", "border-danger"] %>
          <div class="accordion" id="tournament-teams-accordion">
            <% divisions.each_with_index do |div, idx| %>
              <% regs = div.team_registrations.includes(:team, :team_registration_managers).to_a %>
              <% if show_mine && current_user.present? %>
                <% regs = regs.select do |r|
                     r.manager_user_id == current_user.id ||
                       r.team_registration_managers.any? { |m| m.user_id == current_user.id }
                   end %>
              <% end %>
              <% sorted_regs = regs.sort_by { |reg| [status_order[reg.status] || 1, reg.created_at] } %>
              <% color_class = color_classes[idx % color_classes.size] %>
              <% locked_for_div = div.groups.exists? || div.matches.exists? %>
              <% collapse_id = "tournament-teams-division-#{div.id}" %>
              <% heading_id = "tournament-teams-division-heading-#{div.id}" %>

              <div class="accordion-item">
                <h2 class="accordion-header" id="<%= heading_id %>">
                  <button class="accordion-button <%= (idx == 0 ? '' : 'collapsed') %>" type="button" data-bs-toggle="collapse" data-bs-target="#<%= collapse_id %>" aria-expanded="<%= idx == 0 %>" aria-controls="<%= collapse_id %>">
                    <div class="d-flex align-items-center" style="gap:8px;min-width:0;">
                      <div class="border-start border-4 <%= color_class %>" style="height:18px;"></div>
                      <div style="min-width:0;">
                        <div class="fw-bold" style="font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">รุ่น <%= div.name %></div>
                        <div style="font-size:11px;color:#78909c;">จำนวนทีมในรุ่นนี้ <%= regs.count %> ทีม</div>
                      </div>
                    </div>
                  </button>
                </h2>
                <div id="<%= collapse_id %>" class="accordion-collapse collapse <%= (idx == 0 ? 'show' : '') %>" aria-labelledby="<%= heading_id %>" data-bs-parent="#tournament-teams-accordion">
                  <div class="accordion-body" style="background-color:#f8f9fa;">
                    <% if sorted_regs.any? %>
                      <% sorted_regs.each_with_index do |reg, reg_idx| %>
                  <% team = reg.team %>
                  <% display_state = case reg.status
                                     when "confirmed", "paid" then :confirmed
                                     else :applied
                                     end %>

                  <% badge_class = case display_state
                                   when :applied   then "team-status-badge team-status-badge--applied"
                                   when :confirmed then "team-status-badge team-status-badge--confirmed"
                                   end %>

                  <% label = display_state == :applied ? "สมัครแล้ว" : "ยืนยันแล้ว" %>
                  <div style="padding:6px 0;">
                    <div class="d-flex align-items-start" style="gap:8px;">
                      <% if team.logo.attached? %>
                        <%= image_tag team.logo, class: "rounded-circle", style: "width:26px;height:26px;object-fit:cover;flex:0 0 auto;" %>
                      <% end %>
                      <div style="min-width:0;flex:1;">
                        <%= link_to team.name,
                              team_players_tournament_path(@tournament, team_registration_id: reg.id),
                              class: "text-decoration-none",
                              style: "font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;color:inherit;" %>
                        <div style="font-size:10px;color:#78909c;">ผู้จัดการทีม: <%= team.contact_name %></div>
                        <% if can_manage_sensitive %>
                          <div class="text-muted" style="font-size:12px;">
                            ผู้ดูแล:
                            <% if reg.manager_users.any? %>
                              <%= reg.manager_users.order(:id).map { |u| u.name.presence || "User##{u.id}" }.join(", ") %>
                            <% else %>
                              ผู้จัดรายการ
                            <% end %>
                          </div>
                        <% end %>

                        <% status_btn_class = (display_state == :confirmed ? "btn btn-sm btn-success" : "btn btn-sm btn-outline-secondary") %>
                        <div style="margin-top:4px;display:flex;align-items:center;justify-content:flex-end;gap:6px;flex-wrap:wrap;">
                          <% if can_manage_sensitive %>
                            <% target_status = (display_state == :confirmed ? "applied" : "confirmed") %>
                            <%= button_to tournament_team_registration_path(@tournament, reg),
                                  method: :patch,
                                  params: { team_registration: { status: target_status } },
                                  class: status_btn_class,
                                  title: label,
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: label },
                                  form_class: "inline-form",
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M9 16.2 4.8 12l1.4-1.4L9 13.4l8.8-8.8 1.4 1.4z" fill="currentColor"/>
                              </svg>
                            <% end %>

                            <%= link_to edit_team_tournament_team_registration_path(@tournament, reg),
                                  class: "btn btn-sm btn-outline-secondary",
                                  title: "แก้ไขทีม",
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: "แก้ไขทีม" },
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l8.06-8.06.92.92L5.92 20.08zM20.71 7.04a1.003 1.003 0 000-1.42l-2.34-2.34a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" fill="currentColor"/>
                              </svg>
                            <% end %>

                            <%= link_to my_entry_players_tournament_path(@tournament, team_registration_id: reg.id),
                                  class: "btn btn-sm btn-outline-success",
                                  title: "จัดการนักเตะ",
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: "จัดการนักเตะ" },
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.42 0-8 2-8 4v2h16v-2c0-2-3.58-4-8-4z" fill="currentColor"/>
                              </svg>
                            <% end %>

                            <%= link_to edit_manager_tournament_team_registration_path(@tournament, reg),
                                  class: "btn btn-sm btn-outline-primary",
                                  title: "กำหนดผู้จัดการทีม",
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: "กำหนดผู้จัดการทีม" },
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm7 8v-1c0-2.2-3.1-4-7-4s-7 1.8-7 4v1h14zm1-7h-2v-2h-2v2h-2v2h2v2h2v-2h2z" fill="currentColor"/>
                              </svg>
                            <% end %>

                            <%= button_to tournament_team_registration_path(@tournament, reg),
                                  method: :delete,
                                  data: { turbo_confirm: "ลบทีมนี้ออกจากรายการแข่ง?", bs_toggle: "tooltip", bs_placement: "top" },
                                  title: "ลบทีมนี้",
                                  aria: { label: "ลบทีมนี้" },
                                  class: "btn btn-sm btn-outline-danger",
                                  form_class: "inline-form",
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M6 7h12l-1 14H7L6 7zm3-3h6l1 2H8l1-2z" fill="currentColor"/>
                              </svg>
                            <% end %>
                          <% else %>
                            <div class="<%= badge_class %>"><%= label %></div>
                            <% is_team_manager = current_user.present? && (
                              reg.manager_user_id == current_user.id ||
                              reg.team_registration_managers.any? { |m| m.user_id == current_user.id }
                            ) %>
                            <% if is_team_manager %>
                              <%= link_to edit_team_tournament_team_registration_path(@tournament, reg),
                                    class: "btn btn-sm btn-outline-secondary",
                                    title: "แก้ไขทีม",
                                    data: { bs_toggle: "tooltip", bs_placement: "top" },
                                    aria: { label: "แก้ไขทีม" },
                                    style: "line-height:1;padding:6px 8px;" do %>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                  <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l8.06-8.06.92.92L5.92 20.08zM20.71 7.04a1.003 1.003 0 000-1.42l-2.34-2.34a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" fill="currentColor"/>
                                </svg>
                                <span style="margin-left:6px;">แก้ไข</span>
                              <% end %>

                              <%= link_to my_entry_players_tournament_path(@tournament, team_registration_id: reg.id),
                                    class: "btn btn-sm btn-outline-primary",
                                    title: "จัดการนักเตะ",
                                    data: { bs_toggle: "tooltip", bs_placement: "top" },
                                    aria: { label: "จัดการนักเตะ" },
                                    style: "line-height:1;padding:6px 8px;" do %>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                  <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.42 0-8 2-8 4v2h16v-2c0-2-3.58-4-8-4z" fill="currentColor"/>
                                </svg>
                                <span style="margin-left:6px;">นักเตะ</span>
                              <% end %>

                              <%= link_to my_entry_lineups_tournament_path(@tournament, team_registration_id: reg.id),
                                    class: "btn btn-sm btn-success",
                                    title: "ส่งรายชื่อตัวจริง (Line Up)",
                                    data: { bs_toggle: "tooltip", bs_placement: "top" },
                                    aria: { label: "ส่งรายชื่อตัวจริง (Line Up)" },
                                    style: "line-height:1;padding:6px 10px;" do %>
                                Line Up
                              <% end %>
                            <% end %>
                          <% end %>
                        </div>
                      </div>
                    </div>
                    <% if reg_idx < (sorted_regs.size - 1) %>
                      <hr class="my-0" />
                    <% end %>
                  </div>
                      <% end %>
                    <% else %>
                      <div class="team-list-row">ยังไม่มีทีมที่สนใจหรือสมัครในรุ่นนี้</div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <% if regs_without_div.any? %>
              <% regs_without_div_filtered = regs_without_div %>
              <% if show_mine && current_user.present? %>
                <% regs_without_div_filtered = regs_without_div.select do |r|
                     r.manager_user_id == current_user.id ||
                       r.team_registration_managers.any? { |m| m.user_id == current_user.id }
                   end %>
              <% end %>
              <% if regs_without_div_filtered.any? %>
                <% sorted_regs = regs_without_div_filtered.sort_by { |reg| [status_order[reg.status] || 1, reg.created_at] } %>
                <div class="accordion-item">
                  <h2 class="accordion-header" id="tournament-teams-division-heading-unassigned">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#tournament-teams-division-unassigned" aria-expanded="false" aria-controls="tournament-teams-division-unassigned">
                      <div class="d-flex align-items-center" style="gap:8px;min-width:0;">
                        <div class="border-start border-4 border-secondary" style="height:18px;"></div>
                        <div style="min-width:0;">
                          <div class="fw-bold" style="font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">ไม่ระบุรุ่น</div>
                          <div style="font-size:11px;color:#78909c;">จำนวนทีมที่ยังไม่ได้เลือกรุ่น <%= regs_without_div_filtered.count %> ทีม</div>
                        </div>
                      </div>
                    </button>
                  </h2>
                  <div id="tournament-teams-division-unassigned" class="accordion-collapse collapse" aria-labelledby="tournament-teams-division-heading-unassigned" data-bs-parent="#tournament-teams-accordion">
                    <div class="accordion-body" style="background-color:#f8f9fa;">
                      <% sorted_regs.each_with_index do |reg, reg_idx| %>
                <% team = reg.team %>
                <% display_state = case reg.status
                                   when "confirmed", "paid" then :confirmed
                                   else :applied
                                   end %>

                <% badge_class = case display_state
                                 when :applied   then "team-status-badge team-status-badge--applied"
                                 when :confirmed then "team-status-badge team-status-badge--confirmed"
                                 end %>

                <% label = display_state == :applied ? "สมัครแล้ว" : "ยืนยันแล้ว" %>
                <div style="padding:6px 0;">
                  <div class="d-flex align-items-start" style="gap:8px;">
                    <% if team.logo.attached? %>
                      <%= image_tag team.logo, class: "rounded-circle", style: "width:26px;height:26px;object-fit:cover;flex:0 0 auto;" %>
                    <% end %>
                    <div style="min-width:0;flex:1;">
                      <%= link_to team.name,
                            team_players_tournament_path(@tournament, team_registration_id: reg.id),
                            class: "text-decoration-none",
                            style: "font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block;color:inherit;" %>
                      <div style="font-size:10px;color:#78909c;">ผู้จัดการทีม: <%= team.contact_name %></div>

                      <% status_btn_class = (display_state == :confirmed ? "btn btn-sm btn-success" : "btn btn-sm btn-outline-secondary") %>
                      <div style="margin-top:4px;display:flex;align-items:center;justify-content:flex-end;gap:6px;flex-wrap:wrap;">
                        <% if can_manage_sensitive %>
                          <% target_status = (display_state == :confirmed ? "applied" : "confirmed") %>
                          <%= button_to tournament_team_registration_path(@tournament, reg),
                                method: :patch,
                                params: { team_registration: { status: target_status } },
                                class: status_btn_class,
                                title: label,
                                data: { bs_toggle: "tooltip", bs_placement: "top" },
                                aria: { label: label },
                                form_class: "inline-form",
                                style: "line-height:1;padding:6px 8px;" do %>
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                              <path d="M9 16.2 4.8 12l1.4-1.4L9 13.4l8.8-8.8 1.4 1.4z" fill="currentColor"/>
                            </svg>
                          <% end %>

                          <%= link_to edit_team_tournament_team_registration_path(@tournament, reg),
                                class: "btn btn-sm btn-outline-secondary",
                                title: "แก้ไขทีม",
                                data: { bs_toggle: "tooltip", bs_placement: "top" },
                                aria: { label: "แก้ไขทีม" },
                                style: "line-height:1;padding:6px 8px;" do %>
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                              <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l8.06-8.06.92.92L5.92 20.08zM20.71 7.04a1.003 1.003 0 000-1.42l-2.34-2.34a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" fill="currentColor"/>
                            </svg>
                          <% end %>

                          <%= link_to my_entry_players_tournament_path(@tournament, team_registration_id: reg.id),
                                class: "btn btn-sm btn-outline-success",
                                title: "จัดการนักเตะ",
                                data: { bs_toggle: "tooltip", bs_placement: "top" },
                                aria: { label: "จัดการนักเตะ" },
                                style: "line-height:1;padding:6px 8px;" do %>
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                              <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.42 0-8 2-8 4v2h16v-2c0-2-3.58-4-8-4z" fill="currentColor"/>
                            </svg>
                          <% end %>
                          <%= link_to edit_manager_tournament_team_registration_path(@tournament, reg),
                                class: "btn btn-sm btn-outline-primary",
                                title: "กำหนดผู้จัดการทีม",
                                data: { bs_toggle: "tooltip", bs_placement: "top" },
                                aria: { label: "กำหนดผู้จัดการทีม" },
                                style: "line-height:1;padding:6px 8px;" do %>
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                              <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm7 8v-1c0-2.2-3.1-4-7-4s-7 1.8-7 4v1h14zm1-7h-2v-2h-2v2h-2v2h2v2h2v-2h2z" fill="currentColor"/>
                            </svg>
                          <% end %>

                          <%# สำหรับทีมที่ไม่ระบุรุ่น จะไม่มี lock ที่ระดับ division จึงลบได้เสมอ %>
                          <%= button_to tournament_team_registration_path(@tournament, reg),
                                method: :delete,
                                data: { turbo_confirm: "ลบทีมนี้ออกจากรายการแข่ง?", bs_toggle: "tooltip", bs_placement: "top" },
                                title: "ลบทีมนี้",
                                aria: { label: "ลบทีมนี้" },
                                class: "btn btn-sm btn-outline-danger",
                                form_class: "inline-form",
                                style: "line-height:1;padding:6px 8px;" do %>
                            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                              <path d="M6 7h12l-1 14H7L6 7zm3-3h6l1 2H8l1-2z" fill="currentColor"/>
                            </svg>
                          <% end %>
                        <% else %>
                          <div class="<%= badge_class %>"><%= label %></div>
                          <% is_team_manager = current_user.present? && (
                            reg.manager_user_id == current_user.id ||
                            reg.team_registration_managers.any? { |m| m.user_id == current_user.id }
                          ) %>
                          <% if is_team_manager %>
                            <%= link_to edit_team_tournament_team_registration_path(@tournament, reg),
                                  class: "btn btn-sm btn-outline-secondary",
                                  title: "แก้ไขทีม",
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: "แก้ไขทีม" },
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm2.92 2.83H5v-.92l8.06-8.06.92.92L5.92 20.08zM20.71 7.04a1.003 1.003 0 000-1.42l-2.34-2.34a1.003 1.003 0 00-1.42 0l-1.83 1.83 3.75 3.75 1.84-1.82z" fill="currentColor"/>
                              </svg>
                              <span style="margin-left:6px;">แก้ไข</span>
                            <% end %>

                            <%= link_to my_entry_players_tournament_path(@tournament, team_registration_id: reg.id),
                                  class: "btn btn-sm btn-outline-primary",
                                  title: "จัดการนักเตะ",
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: "จัดการนักเตะ" },
                                  style: "line-height:1;padding:6px 8px;" do %>
                              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                                <path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-4.42 0-8 2-8 4v2h16v-2c0-2-3.58-4-8-4z" fill="currentColor"/>
                              </svg>
                              <span style="margin-left:6px;">นักเตะ</span>
                            <% end %>

                            <%= link_to my_entry_lineups_tournament_path(@tournament, team_registration_id: reg.id),
                                  class: "btn btn-sm btn-success",
                                  title: "ส่งรายชื่อตัวจริง (Line Up)",
                                  data: { bs_toggle: "tooltip", bs_placement: "top" },
                                  aria: { label: "ส่งรายชื่อตัวจริง (Line Up)" },
                                  style: "line-height:1;padding:6px 10px;" do %>
                              Line Up
                            <% end %>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <% if reg_idx < (sorted_regs.size - 1) %>
                    <hr class="my-0" />
                  <% end %>
                </div>
                <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
          </div>
        <% else %>
          <div class="team-list-row">ยังไม่มีทีมที่สนใจหรือสมัคร</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
