<% content_for :og_title do %>
  <%= "แบ่งสาย · #{@tournament.title}" %>
<% end %>
<% content_for :og_description do %>
  <%= ["หน้าแบ่งสายการแข่งขัน", tournament_competition_date_label(@tournament), @tournament.location_name.presence].compact.join(" · ") %>
<% end %>
<% content_for :og_url do %>
  <%= request.original_url %>
<% end %>
<% content_for :og_image do %>
  <%= begin
        if @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>
<% end %>

<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <% divisions = @tournament.tournament_divisions.order(:position, :id).to_a %>
      <% status_order = { "confirmed" => 0, "paid" => 0, "applied" => 1, "interested" => 1 } %>

      <% if divisions.any? %>
        <% color_classes = ["border-primary", "border-success", "border-warning", "border-info", "border-danger"] %>

        <% divisions.each_with_index do |div, idx| %>
          <% regs = div.team_registrations.confirmed_for_competition.includes(:team).to_a %>
          <% color_class = color_classes[idx % color_classes.size] %>

          <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
            <div class="d-flex align-items-center justify-content-between mb-2" style="gap:8px;">
              <div class="d-flex align-items-center" style="gap:8px;">
                <div class="border-start border-4 <%= color_class %>" style="height:20px;"></div>
                <div>
                  <div class="fw-bold" style="font-size:13px;">รุ่น <%= div.name %></div>
                  <div style="font-size:11px;color:#78909c;">จำนวนทีมในรุ่นนี้ <%= regs.count %> ทีม</div>
                </div>
              </div>

              <% if can_manage_registrations?(@tournament) %>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#divisionSettingsModal_<%= div.id %>"
                        aria-label="ตั้งค่าการแบ่งสาย"
                        style="line-height:1;padding:6px 10px;white-space:nowrap;flex:0 0 auto;">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M19.4 13.5c.04-.5.04-1 0-1.5l2.1-1.6c.2-.2.25-.5.12-.7l-2-3.5c-.13-.23-.4-.33-.65-.25l-2.5 1c-.4-.3-.8-.5-1.3-.7l-.4-2.7c-.04-.26-.26-.46-.53-.46h-4c-.27 0-.5.2-.54.46l-.4 2.7c-.45.18-.9.42-1.3.7l-2.5 1c-.25.1-.52.02-.65.25l-2 3.5c-.13.22-.08.5.12.7l2.1 1.6c-.04.5-.04 1 0 1.5l-2.1 1.6c-.2.2-.25.5-.12.7l2 3.5c.13.23.4.33.65.25l2.5-1c.4.3.8.5 1.3.7l.4 2.7c.04.26.27.46.54.46h4c.27 0 .5.2.53-.46l.4-2.7c.45-.18.9-.42 1.3-.7l2.5 1c.25.1.52-.02.65-.25l2-3.5c.13-.22.08-.5-.12-.7l-2.1-1.6ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"/>
                  </svg>
                  <span style="margin-left:6px;">แบ่งสายการแข่งขัน</span>
                </button>
              <% end %>
            </div>

            <% if can_manage_registrations?(@tournament) %>
              <div class="modal fade" id="divisionSettingsModal_<%= div.id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <div>
                        <div class="fw-bold">แบ่งสายการแข่งขัน</div>
                        <div class="text-muted" style="font-size:12px;">รุ่น <%= div.name %></div>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                      <p class="mb-2" style="font-size:12px;color:#78909c;">
                        กำหนดจำนวนสาย และจำนวนทีมต่อสาย จากนั้นระบบจะสร้างคู่แข่งขันแบบพบกันหมดในแต่ละสายให้โดยอัตโนมัติ
                      </p>

                      <% existing_group_count = div.groups.count if div.groups.loaded? ? div.groups.any? : div.groups.exists? %>
                      <% existing_slots_per_group = nil %>
                      <% if div.groups.any? && div.matches.any? %>
                        <% sample_group = div.groups.order(:name).first %>
                        <% group_slots = (div.matches.where(group: sample_group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq) %>
                        <% existing_slots_per_group = group_slots.size if group_slots.any? %>
                      <% end %>

                      <%= form_with url: generate_mock_schedule_tournament_path(@tournament), method: :post, local: true, class: "row g-2 align-items-end js-division-form", data: { total_teams: regs.count } do |f| %>
                        <%= hidden_field_tag :division_id, div.id %>

                        <% has_group_matches   = div.matches.group_stage.exists? %>
                        <% has_knockout_match = div.matches.knockout.exists? %>
                        <% default_mode = if has_group_matches && has_knockout_match
                                            "group_with_knockout"
                                          elsif has_knockout_match && !has_group_matches
                                            "knockout_only"
                                          elsif has_group_matches && !has_knockout_match
                                            "league_only"
                                          else
                                            "group_with_knockout"
                                          end %>

                        <div class="col-12 mb-1">
                          <label class="form-label d-block" style="font-size:12px;">รูปแบบการแข่งขัน</label>
                          <div class="btn-group btn-group-sm js-competition-mode-group" role="group" aria-label="รูปแบบการแข่งขัน">
                            <input type="radio" class="btn-check js-competition-mode" name="competition_mode[<%= div.id %>]" id="mode_group_with_knockout_<%= div.id %>" value="group_with_knockout" autocomplete="off" <%= "checked" if default_mode == "group_with_knockout" %>>
                            <label class="btn btn-outline-primary" for="mode_group_with_knockout_<%= div.id %>">ระบบแบ่งกลุ่ม</label>

                            <input type="radio" class="btn-check js-competition-mode" name="competition_mode[<%= div.id %>]" id="mode_knockout_only_<%= div.id %>" value="knockout_only" autocomplete="off" <%= "checked" if default_mode == "knockout_only" %>>
                            <label class="btn btn-outline-primary" for="mode_knockout_only_<%= div.id %>">ระบบน็อคเอาท์</label>

                            <input type="radio" class="btn-check js-competition-mode" name="competition_mode[<%= div.id %>]" id="mode_league_only_<%= div.id %>" value="league_only" autocomplete="off" <%= "checked" if default_mode == "league_only" %>>
                            <label class="btn btn-outline-primary" for="mode_league_only_<%= div.id %>">ระบบลีก</label>
                          </div>
                        </div>

                        <div class="col-6 col-md-3 js-field-group-count">
                          <label class="form-label" style="font-size:12px;">จำนวนสาย</label>
                          <input type="number" name="group_count" min="1" class="form-control form-control-sm js-group-count" value="<%= existing_group_count || 2 %>">
                        </div>
                        <%= hidden_field_tag :slots_per_group, (existing_slots_per_group || 2), class: "js-slots-per-group" %>

                        <div class="col-6 col-md-3 js-field-match-format">
                          <label class="form-label" style="font-size:12px;">รูปแบบแข่ง</label>
                          <select name="match_format" class="form-select form-select-sm js-match-format">
                            <option value="single_leg">นัดเดียว</option>
                            <option value="home_away">เหย้า-เยือน</option>
                          </select>
                        </div>

                        <div class="col-6 col-md-3 js-field-knockout-size">
                          <label class="form-label" style="font-size:12px;">จำนวนทีมในรอบน็อคเอาท์</label>
                          <select name="knockout_bracket_size" class="form-select form-select-sm js-knockout-size">
                            <option value="4" selected>4 ทีม</option>
                            <option value="8">8 ทีม</option>
                            <option value="16">16 ทีม</option>
                            <option value="32">32 ทีม</option>
                            <option value="64">64 ทีม</option>
                          </select>
                        </div>

                        <div class="col-6 col-md-3 js-field-third-place">
                          <label class="form-label" style="font-size:12px;">แมตช์ชิงที่ 3</label>
                          <select name="include_third_place" class="form-select form-select-sm js-include-third-place">
                            <option value="">ไม่มี</option>
                            <option value="1">มี</option>
                          </select>
                        </div>

                        <div class="col-12 d-flex justify-content-end" style="gap:8px;">
                          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                          <button type="submit" class="btn btn-sm btn-primary">แบ่งสาย+สร้างโปรแกรมแข่งขัน</button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <% has_played_matches = div.matches.where.not(home_score: nil, away_score: nil).exists? %>
              <% knockout_only_mode = div.matches.knockout.exists? && !div.matches.group_stage.exists? && div.groups.count == 2 %>
              <% knockout_only_bracket_size = nil %>
              <% knockout_only_side_size = nil %>
              <% if knockout_only_mode %>
                <% first_round_count = div.matches.knockout.where(round_number: 1).count %>
                <% knockout_only_bracket_size = first_round_count * 2 if first_round_count.positive? %>
                <% knockout_only_side_size = (knockout_only_bracket_size / 2) if knockout_only_bracket_size.to_i > 0 %>
              <% end %>

              <% if has_played_matches %>
                  <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
                    <p class="mb-2" style="font-size:12px;color:#e53935;">
                      มีการแข่งขันบางนัดแล้ว ไม่สามารถแก้ไขสายได้อีก สามารถดูตำแหน่งทีมในสายได้จากตารางด้านล่าง
                    </p>

                    <% current_assignments = {} %>
                    <% div.matches.each do |m| %>
                      <% if m.home_slot_label.present? && m.home_team_id.present? %>
                        <% current_assignments[m.home_slot_label] ||= m.home_team_id %>
                      <% end %>
                      <% if m.away_slot_label.present? && m.away_team_id.present? %>
                        <% current_assignments[m.away_slot_label] ||= m.away_team_id %>
                      <% end %>
                    <% end %>

                    <div class="row g-2">
                      <% div.groups.order(:name).each do |group| %>
                        <% if knockout_only_mode %>
                          <% side = group.name.to_s.presence || "A" %>
                          <% ko_first_round_slots = div.matches.knockout.where(round_number: 1).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq %>
                          <% group_slots = ko_first_round_slots.select { |s| s.to_s.start_with?(side) || s.to_s.end_with?(side) } %>
                          <% group_slots = group_slots.sort_by { |s| s.to_s.scan(/\d+/).first.to_i } %>
                        <% else %>
                          <% group_slots = (div.matches.where(group: group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort) %>
                        <% end %>
                        <% next if group_slots.empty? %>

                        <div class="col-12 col-md-6">
                          <div class="mb-2 p-2 rounded" style="background-color:#ffffff;border:1px solid #eceff1;">
                            <div class="mb-1" style="font-size:12px;color:#546e7a;">สาย <%= group.name %></div>
                            <div class="table-responsive">
                              <table class="table table-sm align-middle mb-2">
                                <thead class="table-light">
                                  <tr>
                                    <th scope="col" style="width:80px;">ตำแหน่ง</th>
                                    <th scope="col">ทีม</th>
                                  </tr>
                                </thead>
                                <tbody>
                                  <% group_slots.each do |slot_label| %>
                                    <% assigned_team_id = current_assignments[slot_label] %>
                                    <% assigned_reg = regs.find { |r| r.team_id == assigned_team_id } %>
                                    <% team = assigned_reg&.team %>
                                    <% team_name = team&.name %>
                                    <tr>
                                      <td><strong><%= slot_label %></strong></td>
                                      <td>
                                        <div class="d-flex align-items-center" style="gap:6px;">
                                          <% if team&.logo&.attached? %>
                                            <%= image_tag team.logo,
                                                          class: "rounded-circle",
                                                          style: "width:24px;height:24px;object-fit:cover;" %>
                                          <% end %>
                                          <span><%= team_name.presence || "-" %></span>
                                        </div>
                                      </td>
                                    </tr>
                                  <% end %>
                                </tbody>
                              </table>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% else %>
                  <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;" data-total-teams="<%= regs.count %>">
                    <p class="mb-2" style="font-size:12px;color:#78909c;">
                      เลือกทีมให้แต่ละตำแหน่งในสาย ทีมหนึ่งสามารถอยู่ได้เพียงตำแหน่งเดียวในรุ่นนี้
                    </p>

                    <%= form_with url: assign_slot_teams_tournament_path(@tournament), method: :post, local: true, class: "js-slot-assignment-form" do |f| %>
                      <%= hidden_field_tag :division_id, div.id %>

                      <% current_assignments = {} %>
                      <% div.matches.each do |m| %>
                        <% if m.home_slot_label.present? && m.home_team_id.present? %>
                          <% current_assignments[m.home_slot_label] ||= m.home_team_id %>
                        <% end %>
                        <% if m.away_slot_label.present? && m.away_team_id.present? %>
                          <% current_assignments[m.away_slot_label] ||= m.away_team_id %>
                        <% end %>
                      <% end %>

                      <div class="row g-2">
                        <% div.groups.order(:name).each do |group| %>
                          <% if knockout_only_mode %>
                            <% side = group.name.to_s.presence || "A" %>
                            <% ko_first_round_slots = div.matches.knockout.where(round_number: 1).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq %>
                            <% group_slots = ko_first_round_slots.select { |s| s.to_s.start_with?(side) || s.to_s.end_with?(side) } %>
                            <% group_slots = group_slots.sort_by { |s| s.to_s.scan(/\d+/).first.to_i } %>
                          <% else %>
                            <% group_slots = (div.matches.where(group: group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort) %>
                          <% end %>
                          <% next if group_slots.empty? %>

                          <div class="col-12 col-md-6">
                            <div class="mb-2 p-2 rounded" style="background-color:#ffffff;border:1px solid #eceff1;">
                              <div class="mb-1" style="font-size:12px;color:#546e7a;">สาย <%= group.name %></div>
                              <div class="table-responsive">
                                <table class="table table-sm align-middle mb-2">
                                  <thead class="table-light">
                                    <tr>
                                      <th scope="col" style="width:80px;">ตำแหน่ง</th>
                                      <th scope="col">ทีม</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% group_slots.each do |slot_label| %>
                                      <% assigned_team_id = current_assignments[slot_label] %>
                                      <tr>
                                        <td><strong><%= slot_label %></strong></td>
                                        <td>
                                          <select name="slot_assignments[<%= slot_label %>]" class="form-select form-select-sm">
                                            <option value="">
                                              <%= assigned_team_id ? "ไม่เลือกทีม" : "เลือกทีม" %>
                                            </option>
                                            <% regs.each do |reg| %>
                                              <option value="<%= reg.team_id %>" <%= 'selected' if reg.team_id == assigned_team_id %>>
                                                <%= reg.team.name %>
                                              </option>
                                            <% end %>
                                          </select>
                                        </td>
                                        <td class="text-end"></td>
                                      </tr>
                                    <% end %>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </div>

                      <div class="mb-2 mt-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 js-random-assign">สุ่มทีมอัตโนมัติ</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary">บันทึกการจัดทีมลงสายของรุ่นนี้</button>
                      </div>
                    <% end %>
                  </div>
                <% end %>

            <% else %>
              <% if div.groups.any? && div.matches.any? %>
                <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
                  <% current_assignments = {} %>
                  <% div.matches.each do |m| %>
                    <% if m.home_slot_label.present? && m.home_team_id.present? %>
                      <% current_assignments[m.home_slot_label] ||= m.home_team_id %>
                    <% end %>
                    <% if m.away_slot_label.present? && m.away_team_id.present? %>
                      <% current_assignments[m.away_slot_label] ||= m.away_team_id %>
                    <% end %>
                  <% end %>

                  <div class="row g-2">
                    <% div.groups.order(:name).each do |group| %>
                      <% group_slots = (div.matches.where(group: group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort) %>
                      <% next if group_slots.empty? %>

                      <div class="col-12 col-md-6">
                        <div class="mb-2 p-2 rounded" style="background-color:#ffffff;border:1px solid #eceff1;">
                          <div class="mb-1" style="font-size:12px;color:#546e7a;">สาย <%= group.name %></div>
                          <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2">
                              <thead class="table-light">
                                <tr>
                                  <th scope="col" style="width:80px;">ตำแหน่ง</th>
                                  <th scope="col">ทีม</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% group_slots.each do |slot_label| %>
                                  <% assigned_team_id = current_assignments[slot_label] %>
                                  <% assigned_reg = regs.find { |r| r.team_id == assigned_team_id } %>
                                  <% team = assigned_reg&.team %>
                                  <% team_name = team&.name %>
                                  <tr>
                                    <td><strong><%= slot_label %></strong></td>
                                    <td>
                                      <div class="d-flex align-items-center" style="gap:6px;">
                                        <% if team&.logo&.attached? %>
                                          <%= image_tag team.logo,
                                                        class: "rounded-circle",
                                                        style: "width:24px;height:24px;object-fit:cover;" %>
                                        <% end %>
                                        <% if assigned_reg.present? && assigned_reg.tournament_players.exists? %>
                                          <%= link_to team_name,
                                                    team_players_tournament_path(@tournament, team_registration_id: assigned_reg.id),
                                                    class: "text-decoration-none",
                                                    style: "color:inherit;" %>
                                        <% else %>
                                          <span><%= team_name.presence || "-" %></span>
                                        <% end %>
                                      </div>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="mb-0 text-muted" style="font-size:13px;">ยังไม่มีการกำหนดรุ่นการแข่งขันสำหรับรายการนี้</p>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function() {
    function shuffleInPlace(arr) {
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = arr[i];
        arr[i] = arr[j];
        arr[j] = tmp;
      }
      return arr;
    }

    document.addEventListener('click', function(e) {
      var btn = e.target && e.target.closest ? e.target.closest('.js-random-assign') : null;
      if (!btn) return;

      var form = btn.closest('form.js-slot-assignment-form');
      if (!form) return;

      var selects = Array.prototype.slice.call(form.querySelectorAll('select[name^="slot_assignments["]'));
      if (!selects.length) return;

      shuffleInPlace(selects);

      var used = new Set();
      selects.forEach(function(sel) {
        var candidates = [];
        Array.prototype.forEach.call(sel.options, function(opt) {
          var v = (opt.value || '').trim();
          if (!v) return;
          if (used.has(v)) return;
          candidates.push(v);
        });

        if (!candidates.length) {
          sel.value = '';
          return;
        }

        var chosen = candidates[Math.floor(Math.random() * candidates.length)];
        used.add(chosen);
        sel.value = chosen;
      });
    });
  })();
</script>
