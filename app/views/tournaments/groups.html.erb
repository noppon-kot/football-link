                    <%= form_with url: assign_slot_teams_tournament_path(@tournament), method: :post, local: true, class: "js-slot-assignment-form" do |f| %>
                      <%= hidden_field_tag :division_id, div.id %>

                      <% current_assignments = {} %>
                      <% div.matches.each do |m| %>
                        <% if m.home_slot_label.present? && m.home_team_id.present? %>
                          <% current_assignments[m.home_slot_label] ||= m.home_team_id %>
                        <% end %>
                        <% if m.away_slot_label.present? && m.away_team_id.present? %>
                          <% current_assignments[m.away_slot_label] ||= m.away_team_id %>
                        <% end %>
                      <% end %>

                      <div class="row g-2">
                        <% div.groups.order(:name).each do |group| %>
                          <% if knockout_only_mode %>
                            <% side = group.name.to_s.presence || "A" %>
                            <% ko_first_round_slots = div.matches.knockout.where(round_number: 1).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq %>
                            <% group_slots = ko_first_round_slots.select { |s| s.to_s.start_with?(side) || s.to_s.end_with?(side) } %>
                            <% group_slots = group_slots.sort_by { |s| s.to_s.scan(/\d+/).first.to_i } %>
                          <% else %>
                            <% group_slots = (div.matches.where(group: group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort_by { |s| s.to_s.scan(/\d+/).first.to_i }) %>
                          <% end %>
                          <% next if group_slots.empty? %>

                          <div class="col-12 col-md-6">
                            <div class="mb-2 p-2 rounded" style="background-color:#ffffff;border:1px solid #eceff1;">
                              <div class="mb-1" style="font-size:12px;color:#546e7a;">สาย <%= group.name %></div>
                              <div class="table-responsive">
                                <table class="table table-sm align-middle mb-2">
                                  <thead class="table-light">
                                    <tr>
                                      <th scope="col" style="width:80px;">ตำแหน่ง</th>
                                      <th scope="col">ทีม</th>
                                    </tr>
                                  </thead>
                                  <tbody>
                                    <% group_slots.each do |slot_label| %>
                                      <% assigned_team_id = current_assignments[slot_label] %>
                                      <tr>
                                        <td><strong><%= slot_label %></strong></td>
                                        <td>
                                          <select name="slot_assignments[<%= slot_label %>]" class="form-select form-select-sm">
                                            <option value="">
                                              <%= assigned_team_id ? "ไม่เลือกทีม" : "เลือกทีม" %>
                                            </option>
                                            <% regs.each do |reg| %>
                                              <option value="<%= reg.team_id %>" <%= 'selected' if reg.team_id == assigned_team_id %>>
                                                <%= reg.team.name %>
                                              </option>
                                            <% end %>
                                          </select>
                                        </td>
                                        <td class="text-end"></td>
                                      </tr>
                                    <% end %>
                                  </tbody>
                                </table>
                              </div>
                            </div>
                          </div>
                        <% end %>
                      </div>

                      <div class="mb-2 mt-2 text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 js-random-assign">สุ่มทีมอัตโนมัติ</button>
                        <button type="submit" class="btn btn-sm btn-outline-primary">บันทึกการจัดทีมลงสายของรุ่นนี้</button>
                      </div>
                    <% end %>
                  </div>
                <% end %>

            <% else %>
              <% if div.groups.any? && div.matches.any? %>
                <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
                  <% current_assignments = {} %>
                  <% div.matches.each do |m| %>
                    <% if m.home_slot_label.present? && m.home_team_id.present? %>
                      <% current_assignments[m.home_slot_label] ||= m.home_team_id %>
                    <% end %>
                    <% if m.away_slot_label.present? && m.away_team_id.present? %>
                      <% current_assignments[m.away_slot_label] ||= m.away_team_id %>
                    <% end %>
                  <% end %>

                  <div class="row g-2">
                    <% div.groups.order(:name).each do |group| %>
                      <% group_slots = (div.matches.where(group: group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort_by { |s| s.to_s.scan(/\d+/).first.to_i }) %>
                      <% next if group_slots.empty? %>

                      <div class="col-12 col-md-6">
                        <div class="mb-2 p-2 rounded" style="background-color:#ffffff;border:1px solid #eceff1;">
                          <div class="mb-1" style="font-size:12px;color:#546e7a;">สาย <%= group.name %></div>
                          <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2">
                              <thead class="table-light">
                                <tr>
                                  <th scope="col" style="width:80px;">ตำแหน่ง</th>
                                  <th scope="col">ทีม</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% group_slots.each do |slot_label| %>
                                  <% assigned_team_id = current_assignments[slot_label] %>
                                  <% assigned_reg = regs.find { |r| r.team_id == assigned_team_id } %>
                                  <% team = assigned_reg&.team %>
                                  <% team_name = team&.name %>
                                  <tr>
                                    <td><strong><%= slot_label %></strong></td>
                                    <td>
                                      <div class="d-flex align-items-center" style="gap:6px;">
                                        <% if team&.logo&.attached? %>
                                          <%= image_tag team.logo,
                                                        class: "rounded-circle",
                                                        style: "width:24px;height:24px;object-fit:cover;" %>
                                        <% end %>
                                        <% if assigned_reg.present? && assigned_reg.tournament_players.exists? %>
                                          <%= link_to team_name,
                                                    team_players_tournament_path(@tournament, team_registration_id: assigned_reg.id),
                                                    class: "text-decoration-none",
                                                    style: "color:inherit;" %>
                                        <% else %>
                                          <span><%= team_name.presence || "-" %></span>
                                        <% end %>
                                      </div>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="mb-0 text-muted" style="font-size:13px;">ยังไม่มีการกำหนดรุ่นการแข่งขันสำหรับรายการนี้</p>
      <% end %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
  (function() {
    if (window.__groupsExportInitialized) return;
    window.__groupsExportInitialized = true;

    function ensureWaitOverlay() {
      var el = document.getElementById('global-wait-overlay');
      if (el) return el;
      el = document.createElement('div');
      el.id = 'global-wait-overlay';
      el.style.display = 'none';
      el.style.position = 'fixed';
      el.style.inset = '0';
      el.style.zIndex = '2000';
      el.style.background = 'rgba(0,0,0,0.55)';
      el.style.alignItems = 'center';
      el.style.justifyContent = 'center';
      el.style.padding = '16px';
      el.innerHTML = '' +
        '<div style="background:#ffffff;border-radius:14px;padding:16px 18px;min-width:220px;max-width:92vw;box-shadow:0 12px 30px rgba(0,0,0,0.25);">' +
        '  <div class="d-flex align-items-center" style="gap:10px;">' +
        '    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>' +
        '    <div style="font-weight:700;">กำลังประมวลผล...</div>' +
        '  </div>' +
        '  <div class="text-muted" style="font-size:12px;margin-top:6px;">กรุณารอสักครู่</div>' +
        '</div>';
      document.body.appendChild(el);
      return el;
    }

    function showWaitOverlay() {
      var el = ensureWaitOverlay();
      el.style.display = 'flex';
    }

    function hideWaitOverlay() {
      var el = document.getElementById('global-wait-overlay');
      if (el) el.style.display = 'none';
    }

    function ensureModal() {
      var existing = document.getElementById('groups-snapshot-modal');
      if (existing) return existing;

      var modal = document.createElement('div');
      modal.id = 'groups-snapshot-modal';
      modal.style.display = 'none';
      modal.style.position = 'fixed';
      modal.style.inset = '0';
      modal.style.zIndex = '1055';
      modal.style.background = 'rgba(0,0,0,0.72)';
      modal.style.padding = '16px';
      modal.style.overflow = 'auto';

      modal.innerHTML = '' +
        '<div style="min-height:100%;display:flex;align-items:center;justify-content:center;">' +
        '  <div style="position:relative;max-width:min(500px, 96vw);width:100%;">' +
        '    <div style="position:absolute;top:-10px;right:-10px;display:flex;gap:8px;">' +
        '      <button type="button" data-groups-snapshot-download title="Save" aria-label="Save" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.55);color:#fff;line-height:1;display:flex;align-items:center;justify-content:center;">' +
        '        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">' +
        '          <path d="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4Zm-5 18a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM6 8V5h9v3H6Z" fill="currentColor"/>' +
        '        </svg>' +
        '      </button>' +
        '      <button type="button" data-groups-snapshot-close style="width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.55);color:#fff;font-size:22px;line-height:1;">×</button>' +
        '    </div>' +
        '    <img data-groups-snapshot-modal-img alt="Groups snapshot" style="width:100%;height:auto;border-radius:14px;display:block;background:#fff;" />' +
        '  </div>' +
        '</div>';

      document.body.appendChild(modal);

      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.style.display = 'none';
        }
      });
      modal.querySelector('[data-groups-snapshot-close]').addEventListener('click', function() {
        modal.style.display = 'none';
      });

      modal.querySelector('[data-groups-snapshot-download]').addEventListener('click', function() {
        var img = modal.querySelector('[data-groups-snapshot-modal-img]');
        if (!img || !img.src) return;

        var filename = modal.getAttribute('data-filename') || 'groups.png';
        if (img.src.indexOf('data:image') === 0) {
          var a = document.createElement('a');
          a.href = img.src;
          a.download = filename;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
        } else {
          window.open(img.src, '_blank');
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          modal.style.display = 'none';
        }
      });

      return modal;
    }

    function setModalImage(src, filename) {
      var modal = ensureModal();
      var modalImg = modal.querySelector('[data-groups-snapshot-modal-img]');
      modalImg.src = src;
      modal.setAttribute('data-current-src', src);
      if (filename) modal.setAttribute('data-filename', filename);
      modal.style.display = 'block';
    }

    document.addEventListener('click', async function(e) {
      var btn = e.target.closest('.js-groups-export');
      if (!btn) return;

      if (btn.getAttribute('data-busy') === '1') return;
      btn.setAttribute('data-busy', '1');

      var targetId = btn.getAttribute('data-target');
      if (!targetId) return;

      var target = document.getElementById(targetId);
      if (!target) return;

      var filename = btn.getAttribute('data-filename') || 'groups.png';

      var oldText = btn.innerText;
      try {
        btn.disabled = true;
        showWaitOverlay();

        var canvas = await html2canvas(target, {
          backgroundColor: '#ffffff',
          scale: 2,
          useCORS: true
        });
        var dataUrl = canvas.toDataURL('image/png');
        setModalImage(dataUrl, filename);
      } catch (err) {
        console.error(err);
        alert('สร้างรูปไม่สำเร็จ');
      } finally {
        btn.disabled = false;
        btn.innerText = oldText;
        btn.setAttribute('data-busy', '0');
        hideWaitOverlay();
      }
    });
  })();
</script>

<script>
  (function() {
    function shuffleInPlace(arr) {
      for (var i = arr.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = arr[i];
        arr[i] = arr[j];
        arr[j] = tmp;
      }
      return arr;
    }

    document.addEventListener('click', function(e) {
      var btn = e.target && e.target.closest ? e.target.closest('.js-random-assign') : null;
      if (!btn) return;

      var form = btn.closest('form.js-slot-assignment-form');
      if (!form) return;

      var selects = Array.prototype.slice.call(form.querySelectorAll('select[name^="slot_assignments["]'));
      if (!selects.length) return;

      shuffleInPlace(selects);

      var used = new Set();
      selects.forEach(function(sel) {
        var candidates = [];
        Array.prototype.forEach.call(sel.options, function(opt) {
          var v = (opt.value || '').trim();
          if (!v) return;
          if (used.has(v)) return;
          candidates.push(v);
        });

        if (!candidates.length) {
          sel.value = '';
          return;
        }

        var chosen = candidates[Math.floor(Math.random() * candidates.length)];
        used.add(chosen);
        sel.value = chosen;
      });
    });
  })();
</script>
