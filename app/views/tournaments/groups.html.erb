<% content_for :og_title do %>
  <%= "แบ่งสาย · #{@tournament.title}" %>
<% end %>
<% content_for :og_description do %>
  <%= ["หน้าแบ่งสายการแข่งขัน", tournament_competition_date_label(@tournament), @tournament.location_name.presence].compact.join(" · ") %>
<% end %>
<% content_for :og_url do %>
  <%= request.original_url %>
<% end %>
<% content_for :og_image do %>
  <%= begin
        if @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>
<% end %>

<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <% divisions = @tournament.tournament_divisions.order(:position, :id).to_a %>
      <% status_order = { "confirmed" => 0, "paid" => 0, "applied" => 1, "interested" => 1 } %>

      <% if divisions.any? %>
        <% color_classes = ["border-primary", "border-success", "border-warning", "border-info", "border-danger"] %>

        <% divisions.each_with_index do |div, idx| %>
          <% regs = div.team_registrations.confirmed_for_competition.includes(:team).to_a %>
          <% color_class = color_classes[idx % color_classes.size] %>

          <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
            <% div_groups = div.groups.order(:name).to_a %>
            <% div_has_groups = div_groups.any? && div.matches.any? %>
            <% groups_share_card_id = "groups-share-card-#{div.id}" %>

            <% if div_has_groups %>
              <% div_current_assignments = {} %>
              <% div.matches.each do |m| %>
                <% if m.home_slot_label.present? && m.home_team_id.present? %>
                  <% div_current_assignments[m.home_slot_label] ||= m.home_team_id %>
                <% end %>
                <% if m.away_slot_label.present? && m.away_team_id.present? %>
                  <% div_current_assignments[m.away_slot_label] ||= m.away_team_id %>
                <% end %>
              <% end %>

              <% max_teams_per_group = 0 %>
              <% div_groups.each do |grp| %>
                <% grp_slots = (div.matches.where(group: grp).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq) %>
                <% max_teams_per_group = [max_teams_per_group, grp_slots.size].max %>
              <% end %>

              <% groups_count = div_groups.size %>
              <% rows_count = (groups_count / 2.0).ceil %>
              <% row_height = 60 + (max_teams_per_group * 56) %>
              <% share_card_height = 320 + (rows_count * row_height) %>
              <% share_card_height = [share_card_height, 1800].min %>

              <div id="<%= groups_share_card_id %>" style="position:fixed;left:-10000px;top:0;width:1080px;height:<%= share_card_height %>px;overflow:hidden;">
                <div data-theme-root style="position:relative;width:1080px;height:<%= share_card_height %>px;background:#071b14;">
                  <div style="position:absolute;inset:0;background-image:url('<%= asset_path("banner2.png") %>');background-size:cover;background-position:center;filter:brightness(0.45);"></div>
                  <div data-theme-gradient style="position:absolute;inset:0;background:linear-gradient(135deg, rgba(6,58,42,0.88) 0%, rgba(11,74,51,0.78) 45%, rgba(10,47,34,0.88) 100%);"></div>

                  <div style="position:absolute;left:54px;right:54px;top:48px;display:flex;justify-content:space-between;align-items:flex-start;gap:18px;">
                    <div>
                      <div data-theme-title style="font-size:50px;font-weight:900;letter-spacing:0.4px;line-height:1.05;color:#d7ff59;text-transform:uppercase;">
                        <%= @tournament.title %>
                      </div>
                      <div style="margin-top:12px;font-size:30px;font-weight:900;color:rgba(255,255,255,0.92);letter-spacing:0.8px;">การแบ่งสาย</div>
                      <div style="margin-top:8px;font-size:18px;color:rgba(255,255,255,0.88);">รุ่น <%= div.name %> · <%= groups_count %> สาย</div>
                    </div>
                  </div>

                  <div style="position:absolute;left:54px;right:54px;top:220px;bottom:100px;overflow:hidden;">
                    <div style="display:flex;flex-wrap:wrap;gap:20px;">
                      <% div_groups.each do |grp| %>
                        <% grp_slots = (div.matches.where(group: grp).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort_by { |s| s.to_s.scan(/\d+/).first.to_i }) %>
                        <% next if grp_slots.empty? %>
                        <div style="flex:0 0 calc(50% - 10px);background:rgba(10,18,36,0.70);border:1px solid rgba(255,255,255,0.14);border-radius:14px;padding:16px;">
                          <div style="font-size:18px;font-weight:900;color:#d7ff59;margin-bottom:12px;">สาย <%= grp.name %></div>
                          <% grp_slots.each_with_index do |slot_label, slot_idx| %>
                            <% assigned_team_id = div_current_assignments[slot_label] %>
                            <% assigned_reg = regs.find { |r| r.team_id == assigned_team_id } %>
                            <% team = assigned_reg&.team %>
                            <div style="display:flex;align-items:center;gap:10px;padding:8px 0;<%= 'border-top:1px solid rgba(255,255,255,0.12);' if slot_idx > 0 %>">
                              <div style="width:36px;text-align:center;font-size:16px;font-weight:900;color:rgba(255,255,255,0.7);">
                                <%= slot_label %>
                              </div>
                              <% if team&.logo&.attached? %>
                                <%= image_tag team.logo, style: "width:36px;height:36px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,0.12);", crossorigin: "anonymous" %>
                              <% else %>
                                <div style="width:36px;height:36px;border-radius:999px;background:rgba(255,255,255,0.12);"></div>
                              <% end %>
                              <div style="flex:1;font-size:18px;font-weight:700;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                <%= team&.name.presence || "-" %>
                              </div>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <div style="position:absolute;left:54px;right:54px;bottom:36px;display:flex;justify-content:flex-end;">
                    <div style="display:flex;align-items:center;gap:10px;color:rgba(255,255,255,0.92);border:1px solid rgba(255,255,255,0.18);background:rgba(255,255,255,0.08);padding:10px 14px;border-radius:14px;white-space:nowrap;">
                      <%= image_tag "dernsai_icon.png", alt: "DERNSAI", style: "width:28px;height:28px;border-radius:8px;object-fit:contain;background:rgba(255,255,255,0.08);padding:4px;", crossorigin: "anonymous" %>
                      <span style="font-size:14px;font-weight:800;letter-spacing:0.6px;">DERNSAI.COM</span>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>

            <div class="d-flex align-items-center justify-content-between mb-2" style="gap:8px;">
              <div class="d-flex align-items-center" style="gap:8px;">
                <div class="border-start border-4 <%= color_class %>" style="height:20px;"></div>
                <div>
                  <div class="fw-bold" style="font-size:13px;">รุ่น <%= div.name %></div>
                  <div style="font-size:11px;color:#78909c;">จำนวนทีมในรุ่นนี้ <%= regs.count %> ทีม</div>
                </div>
              </div>

              <div class="d-flex align-items-center" style="gap:6px;">
                <% if div_has_groups %>
                  <button type="button"
                          class="btn btn-sm btn-success js-groups-export"
                          data-target="<%= groups_share_card_id %>"
                          data-filename="groups_<%= @tournament.title.to_s.gsub(' ', '_') %>_<%= div.name.to_s.gsub(' ', '_') %>.png"
                          title="ดาวน์โหลดรูปแบ่งสาย"
                          style="line-height:1;padding:6px 8px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                      <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
                    </svg>
                  </button>
                <% end %>

              <% if can_manage_registrations?(@tournament) %>
                <% if div_has_groups %>
                  <button type="button"
                          class="btn btn-sm btn-outline-primary"
                          data-bs-toggle="modal"
                          data-bs-target="#addTeamToGroupModal_<%= div.id %>"
                          aria-label="เพิ่มทีมเข้าสาย"
                          style="line-height:1;padding:6px 10px;white-space:nowrap;flex:0 0 auto;">
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                      <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/>
                    </svg>
                    <span style="margin-left:4px;">เพิ่มทีมเข้าสาย</span>
                  </button>
                <% end %>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal"
                        data-bs-target="#divisionSettingsModal_<%= div.id %>"
                        aria-label="ตั้งค่าการแบ่งสาย"
                        style="line-height:1;padding:6px 10px;white-space:nowrap;flex:0 0 auto;">
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                    <path d="M19.4 13.5c.04-.5.04-1 0-1.5l2.1-1.6c.2-.2.25-.5.12-.7l-2-3.5c-.13-.23-.4-.33-.65-.25l-2.5 1c-.4-.3-.8-.5-1.3-.7l-.4-2.7c-.04-.26-.26-.46-.53-.46h-4c-.27 0-.5.2-.54.46l-.4 2.7c-.45.18-.9.42-1.3.7l-2.5 1c-.25.1-.52.02-.65.25l-2 3.5c-.13.22-.08.5.12.7l2.1 1.6c-.04.5-.04 1 0 1.5l-2.1 1.6c-.2.2-.25.5-.12.7l2 3.5c.13.23.4.33.65.25l2.5-1c.4.3.8.5 1.3.7l.4 2.7c.04.26.27.46.54.46h4c.27 0 .5.2.53-.46l.4-2.7c.45-.18.9-.42 1.3-.7l2.5 1c.25.1.52-.02.65-.25l2-3.5c.13-.22.08-.5-.12-.7l-2.1-1.6ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"/>
                  </svg>
                  <span style="margin-left:6px;">แบ่งสายการแข่งขัน</span>
                </button>
              <% end %>
              </div>
            </div>

            <% if can_manage_registrations?(@tournament) %>
              <div class="modal fade" id="divisionSettingsModal_<%= div.id %>" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <div>
                        <div class="fw-bold">แบ่งสายการแข่งขัน</div>
                        <div class="text-muted" style="font-size:12px;">รุ่น <%= div.name %></div>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                      <p class="mb-2" style="font-size:12px;color:#78909c;">
                        กำหนดจำนวนสาย และจำนวนทีมต่อสาย จากนั้นระบบจะสร้างคู่แข่งขันแบบพบกันหมดในแต่ละสายให้โดยอัตโนมัติ
                      </p>

                      <% existing_group_count = div.groups.count if div.groups.loaded? ? div.groups.any? : div.groups.exists? %>
                      <% existing_slots_per_group = nil %>
                      <% if div.groups.any? && div.matches.any? %>
                        <% sample_group = div.groups.order(:name).first %>
                        <% group_slots = (div.matches.where(group: sample_group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq) %>
                        <% existing_slots_per_group = group_slots.size if group_slots.any? %>
                      <% end %>

                      <%= form_with url: generate_mock_schedule_tournament_path(@tournament), method: :post, local: true, class: "row g-2 align-items-end js-division-form", data: { total_teams: regs.count } do |f| %>
                        <%= hidden_field_tag :division_id, div.id %>

                        <% has_group_matches   = div.matches.group_stage.exists? %>
                        <% has_knockout_match = div.matches.knockout.exists? %>
                        <% default_mode = if has_group_matches && has_knockout_match
                                            "group_with_knockout"
                                          elsif has_knockout_match && !has_group_matches
                                            "knockout_only"
                                          elsif has_group_matches && !has_knockout_match
                                            "league_only"
                                          else
                                            "group_with_knockout"
                                          end %>

                        <div class="col-12 mb-1">
                          <label class="form-label d-block" style="font-size:12px;">รูปแบบการแข่งขัน</label>
                          <div class="btn-group btn-group-sm js-competition-mode-group" role="group" aria-label="รูปแบบการแข่งขัน">
                            <input type="radio" class="btn-check js-competition-mode" name="competition_mode[<%= div.id %>]" id="mode_group_with_knockout_<%= div.id %>" value="group_with_knockout" autocomplete="off" <%= "checked" if default_mode == "group_with_knockout" %>>
                            <label class="btn btn-outline-primary" for="mode_group_with_knockout_<%= div.id %>">ระบบแบ่งกลุ่ม</label>

                            <input type="radio" class="btn-check js-competition-mode" name="competition_mode[<%= div.id %>]" id="mode_knockout_only_<%= div.id %>" value="knockout_only" autocomplete="off" <%= "checked" if default_mode == "knockout_only" %>>
                            <label class="btn btn-outline-primary" for="mode_knockout_only_<%= div.id %>">ระบบน็อคเอาท์</label>

                            <input type="radio" class="btn-check js-competition-mode" name="competition_mode[<%= div.id %>]" id="mode_league_only_<%= div.id %>" value="league_only" autocomplete="off" <%= "checked" if default_mode == "league_only" %>>
                            <label class="btn btn-outline-primary" for="mode_league_only_<%= div.id %>">ระบบลีก</label>
                          </div>
                        </div>

                        <div class="col-6 col-md-3 js-field-group-count">
                          <label class="form-label" style="font-size:12px;">จำนวนสาย</label>
                          <input type="number" name="group_count" min="1" class="form-control form-control-sm js-group-count" value="<%= existing_group_count || 2 %>">
                        </div>
                        <%= hidden_field_tag :slots_per_group, (existing_slots_per_group || 2), class: "js-slots-per-group" %>

                        <div class="col-6 col-md-3 js-field-extra-team-placement">
                          <label class="form-label" style="font-size:12px;">ทีมเกินอยู่สายไหน</label>
                          <select name="extra_team_placement" class="form-select form-select-sm">
                            <option value="first" selected>สายแรก (A, B, C...)</option>
                            <option value="last">สายท้าย (...C, B, A)</option>
                            <option value="odd">สายคี่ (A, C, E...)</option>
                          </select>
                        </div>

                        <div class="col-6 col-md-3 js-field-match-format">
                          <label class="form-label" style="font-size:12px;">รูปแบบแข่ง</label>
                          <select name="match_format" class="form-select form-select-sm js-match-format">
                            <option value="single_leg">นัดเดียว</option>
                            <option value="home_away">เหย้า-เยือน</option>
                          </select>
                        </div>

                        <div class="col-6 col-md-3 js-field-knockout-size">
                          <label class="form-label" style="font-size:12px;">จำนวนทีมในรอบน็อคเอาท์</label>
                          <select name="knockout_bracket_size" class="form-select form-select-sm js-knockout-size">
                            <option value="4" selected>4 ทีม</option>
                            <option value="8">8 ทีม</option>
                            <option value="16">16 ทีม</option>
                            <option value="32">32 ทีม</option>
                            <option value="64">64 ทีม</option>
                          </select>
                        </div>

                        <div class="col-6 col-md-3 js-field-knockout-pattern">
                          <label class="form-label" style="font-size:12px;">รูปแบบการจับคู่</label>
                          <select name="knockout_pattern" class="form-select form-select-sm">
                            <option value="cross" <%= 'selected' if div.knockout_pattern == 'cross' %>>A vs C, B vs D (ข้ามสาย)</option>
                            <option value="adjacent" <%= 'selected' if div.knockout_pattern == 'adjacent' %>>A vs B, C vs D (สายติดกัน)</option>
                            <option value="adjacent_cross" <%= 'selected' if div.knockout_pattern == 'adjacent_cross' %>>A vs B, C vs D (ผู้ชนะข้ามกลุ่ม)</option>
                          </select>
                        </div>

                        <div class="col-6 col-md-3 js-field-third-place">
                          <label class="form-label" style="font-size:12px;">แมตช์ชิงที่ 3</label>
                          <select name="include_third_place" class="form-select form-select-sm js-include-third-place">
                            <option value="">ไม่มี</option>
                            <option value="1">มี</option>
                          </select>
                        </div>

                        <div class="col-12 d-flex justify-content-end" style="gap:8px;">
                          <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                          <button type="submit" class="btn btn-sm btn-primary">แบ่งสาย+สร้างโปรแกรมแข่งขัน</button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>

              <% # Modal for adding team to existing group %>
              <% if div_has_groups %>
                <% unassigned_regs = regs.reject { |r| div_current_assignments.values.include?(r.team_id) } %>
                <div class="modal fade" id="addTeamToGroupModal_<%= div.id %>" tabindex="-1" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                      <div class="modal-header">
                        <div>
                          <div class="fw-bold">เพิ่มทีมเข้าสาย</div>
                          <div class="text-muted" style="font-size:12px;">รุ่น <%= div.name %></div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                      </div>
                      <div class="modal-body">
                        <% if unassigned_regs.any? %>
                          <%= form_with url: add_team_to_group_tournament_path(@tournament), method: :post, local: true do |f| %>
                            <div class="mb-3">
                              <label class="form-label" style="font-size:13px;">เลือกทีม</label>
                              <%= f.select :team_registration_id,
                                    options_for_select(unassigned_regs.map { |r| [r.team&.name || r.team_name, r.id] }),
                                    { include_blank: "-- เลือกทีม --" },
                                    class: "form-select" %>
                            </div>
                            <div class="mb-3">
                              <label class="form-label" style="font-size:13px;">เลือกสาย</label>
                              <%= f.select :group_id,
                                    options_for_select(div_groups.map { |g| ["สาย #{g.name}", g.id] }),
                                    { include_blank: "-- เลือกสาย --" },
                                    class: "form-select" %>
                            </div>
                            <div class="text-muted mb-3" style="font-size:11px;">
                              หมายเหตุ: ทีมจะถูกเพิ่มเข้าสายที่เลือก แต่ยังไม่มีคู่แข่งขันอัตโนมัติ ต้องไปเพิ่มคู่แข่งขันเองในหน้าจัดโปรแกรม
                            </div>
                            <div class="d-flex justify-content-end" style="gap:8px;">
                              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                              <button type="submit" class="btn btn-sm btn-primary">เพิ่มทีมเข้าสาย</button>
                            </div>
                          <% end %>
                        <% else %>
                          <div class="text-muted text-center py-3">
                            <p class="mb-0">ทีมทั้งหมดในรุ่นนี้ถูกจัดเข้าสายแล้ว</p>
                          </div>
                          <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>

              <% has_played_matches = div.matches.where.not(home_score: nil, away_score: nil).exists? %>
              <% knockout_only_mode = div.matches.knockout.exists? && !div.matches.group_stage.exists? && div.groups.count == 2 %>
              <% knockout_only_bracket_size = nil %>
              <% knockout_only_side_size = nil %>
              <% if knockout_only_mode %>
                <% first_round_count = div.matches.knockout.where(round_number: 1).count %>
                <% knockout_only_bracket_size = first_round_count * 2 if first_round_count.positive? %>
                <% knockout_only_side_size = (knockout_only_bracket_size / 2) if knockout_only_bracket_size.to_i > 0 %>
              <% end %>

              <% if has_played_matches %>
                  <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
                    <% current_assignments = {} %>
                    <% div.matches.each do |m| %>
                      <% if m.home_slot_label.present? && m.home_team_id.present? %>
                        <% current_assignments[m.home_slot_label] ||= m.home_team_id %>
                      <% end %>
                      <% if m.away_slot_label.present? && m.away_team_id.present? %>
                        <% current_assignments[m.away_slot_label] ||= m.away_team_id %>
                      <% end %>
                    <% end %>

                    <div class="row g-2">
                      <% div.groups.order(:name).each do |group| %>
                        <% if knockout_only_mode %>
                          <% side = group.name.to_s.presence || "A" %>
                          <% ko_first_round_slots = div.matches.knockout.where(round_number: 1).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq %>
                          <% group_slots = ko_first_round_slots.select { |s| s.to_s.start_with?(side) || s.to_s.end_with?(side) } %>
                          <% group_slots = group_slots.sort_by { |s| s.to_s.scan(/\d+/).first.to_i } %>
                        <% else %>
                          <% group_slots = (div.matches.where(group: group).pluck(:home_slot_label, :away_slot_label).flatten.compact.uniq.sort_by { |s| s.to_s.scan(/\d+/).first.to_i }) %>
