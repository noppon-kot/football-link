<% content_for :og_title do %>
  <%= "จัดการตารางแข่ง · #{@tournament.title}" %>
<% end %>

<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <div class="mb-3">
        <%= link_to fixture_tournament_path(@tournament), class: "btn btn-sm btn-outline-secondary" do %>
          <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" fill="currentColor"/>
          </svg>
          กลับไปหน้า Match Day
        <% end %>
      </div>

      <div class="card shadow-sm mb-3">
        <div class="card-header">
          <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap:10px;">
            <div class="fw-bold">จัดการตารางแข่ง</div>
            <div class="d-flex flex-wrap" style="gap:8px;">
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addMatchModal"
                    aria-label="เพิ่มคู่แข่งขัน"
                    style="line-height:1;padding:6px 10px;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"/>
              </svg>
              <span style="margin-left:4px;">เพิ่มคู่แข่งขัน</span>
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#bulkScheduleModal"
                    aria-label="ตั้งค่าเวลาแข่งแบบชุด"
                    style="line-height:1;padding:6px 10px;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.06 7.06 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 13.9 1h-3.8a.5.5 0 0 0-.49.42l-.36 2.54c-.58.23-1.12.54-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 7.48a.5.5 0 0 0 .12.64l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L2.83 14.52a.5.5 0 0 0-.12.64l1.92 3.32c.13.22.39.3.6.22l2.39-.96c.5.4 1.05.71 1.63.94l.36 2.54c.04.24.25.42.49.42h3.8c.24 0 .45-.18.49-.42l.36-2.54c.58-.23 1.12-.54 1.63-.94l2.39.96c.22.09.47 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"/>
              </svg>
              <span style="margin-left:6px;">ตั้งเวลาเป็นชุด</span>
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#clearScheduleModal"
                    aria-label="ล้างตารางแข่ง"
                    style="line-height:1;padding:6px 10px;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" fill="currentColor"/>
              </svg>
              <span style="margin-left:4px;">ล้างตาราง</span>
            </button>
            <button type="button"
                    class="btn btn-sm btn-outline-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#regenerateKnockoutModal"
                    aria-label="สร้างรอบน็อคเอาท์ใหม่"
                    style="line-height:1;padding:6px 10px;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="currentColor"/>
              </svg>
              <span style="margin-left:4px;">สร้างน็อคเอาท์ใหม่</span>
            </button>
            </div>
          </div>
          <% total_matches = @all_matches.size %>
          <% scheduled_matches = @all_matches.count { |m| m.kickoff_at.present? } %>
          <% unscheduled_matches = total_matches - scheduled_matches %>
          <div class="d-flex align-items-center flex-wrap mt-2 pt-2 border-top" style="gap:12px;">
            <div class="d-flex align-items-center" style="gap:6px;">
              <span class="badge bg-success"><%= scheduled_matches %></span>
              <span style="font-size:12px;color:#546e7a;">จัดเวลาแล้ว</span>
            </div>
            <div class="d-flex align-items-center" style="gap:6px;">
              <span class="badge bg-warning text-dark"><%= unscheduled_matches %></span>
              <span style="font-size:12px;color:#546e7a;">ยังไม่จัดเวลา</span>
            </div>
            <div class="ms-auto d-flex align-items-center" style="gap:8px;">
              <span style="font-size:12px;color:#78909c;">แสดง:</span>
              <div class="btn-group btn-group-sm" role="group">
                <input type="radio" class="btn-check" name="filter-schedule" id="filter-all" value="all" checked>
                <label class="btn btn-outline-secondary" for="filter-all" style="font-size:11px;">ทั้งหมด</label>
                <input type="radio" class="btn-check" name="filter-schedule" id="filter-scheduled" value="scheduled">
                <label class="btn btn-outline-secondary" for="filter-scheduled" style="font-size:11px;">จัดแล้ว</label>
                <input type="radio" class="btn-check" name="filter-schedule" id="filter-unscheduled" value="unscheduled">
                <label class="btn btn-outline-secondary" for="filter-unscheduled" style="font-size:11px;">ยังไม่จัด</label>
              </div>
            </div>
          </div>
        </div>
        <div class="card-body">
          <% if @divisions.any? && @all_matches.any? %>
            <% color_classes = ["border-primary", "border-success", "border-warning", "border-info", "border-danger"] %>

            <% @divisions.each_with_index do |div, idx| %>
              <% div_matches = @all_matches.select { |m| m.tournament_division_id == div.id } %>
              <% next if div_matches.empty? %>

              <% color_class = color_classes[idx % color_classes.size] %>
              <% division_teams = div.team_registrations.confirmed_for_competition.includes(:team).map(&:team).compact.uniq %>
              <% teams_by_group = {} %>
              <% div.groups.order(:name).each do |g| %>
                <% ids = div.matches.group_stage.where(group_id: g.id).pluck(:home_team_id, :away_team_id).flatten.compact.uniq %>
                <% teams_by_group[g.name.to_s] = division_teams.select { |t| ids.include?(t.id) } %>
              <% end %>

              <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
                <div class="d-flex align-items-center mb-2" style="gap:8px;">
                  <div class="border-start border-4 <%= color_class %>" style="height:20px;"></div>
                  <div>
                    <div class="fw-bold" style="font-size:13px;">รุ่น <%= div.name %></div>
                    <div style="font-size:11px;color:#78909c;">ตารางแข่งขันทั้งหมดในรุ่นนี้</div>
                  </div>
                </div>

                <% matches_by_group = div_matches.group_by do |m| %>
                  <% if m.knockout? %>
                    <% "KO_#{m.round_label}" %>
                  <% else %>
                    <% "GROUP_#{m.group&.name || "-"}" %>
                  <% end %>
                <% end %>

                <% sorted_group_keys = matches_by_group.keys.sort_by do |group_key| %>
                  <% if group_key.to_s.start_with?("KO_") %>
                    <% round_code = group_key.to_s.sub("KO_", "") %>
                    <% ko_order = case round_code
                       when "R64" then 10
                       when "R32" then 11
                       when "R16" then 12
                       when "QF"  then 13
                       when "SF"  then 14
                       when "FINAL" then 15
                       when "3RD" then 16
                       else 17
                       end %>
                    <% [1, ko_order, group_key.to_s] %>
                  <% else %>
                    <% [0, 0, group_key.to_s] %>
                  <% end %>
                <% end %>

                <%= form_with url: update_scores_tournament_path(@tournament), method: :patch, local: true do |f| %>
                <%= hidden_field_tag :from_manage_schedule, "1" %>
                <% sorted_group_keys.each do |group_key| %>
                  <% matches = matches_by_group[group_key] || [] %>
                  <% next if matches.empty? %>

                  <% group_label = if group_key.start_with?("KO_")
                                     round_code = group_key.sub("KO_", "")
                                     case round_code
                                     when "SF" then "รอบ 4 ทีม"
                                     when "QF" then "รอบ 8 ทีม"
                                     when "R16" then "รอบ 16 ทีม"
                                     when "R32" then "รอบ 32 ทีม"
                                     when "R64" then "รอบ 64 ทีม"
                                     when "FINAL" then "รอบชิงชนะเลิศ"
                                     when "3RD" then "ชิงอันดับ 3"
                                     else "รอบน็อคเอาท์"
                                     end
                                   else
                                     "สาย #{group_key.sub('GROUP_', '')}"
                                   end %>

                  <div class="mb-2">
                    <div class="fw-bold" style="font-size:12px;color:#546e7a;margin-bottom:6px;"><%= group_label %></div>
                    <%# Mobile card layout - fields with _mobile suffix %>
                    <div class="d-md-none">
                      <% matches.each_with_index do |match, midx| %>
                        <% is_scheduled = match.kickoff_at.present? %>
                        <div class="card mb-2" style="<%= is_scheduled ? 'border-left:3px solid #4caf50;' : 'border-left:3px solid #ff9800;' %>">
                          <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                              <span class="badge bg-secondary">คู่ที่ <%= match.position || (midx + 1) %></span>
                              <div class="d-flex align-items-center" style="gap:8px;">
                                <span style="font-size:10px;color:#78909c;">สนาม</span>
                                <%= number_field_tag "matches[#{match.id}][pitch_no]",
                                      match.pitch_no,
                                      class: "form-control form-control-sm js-mobile-field",
                                      style: "width:50px;font-size:11px;padding:2px 4px;",
                                      min: 0, max: 99,
                                      data: { match_id: match.id, field: "pitch_no" } %>
                              </div>
                            </div>
                            <div class="mb-2">
                              <%= datetime_local_field_tag "matches[#{match.id}][kickoff_at]",
                                    (match.kickoff_at&.strftime("%Y-%m-%dT%H:%M")),
                                    class: "form-control form-control-sm js-mobile-field",
                                    style: "font-size:11px;",
                                    data: { match_id: match.id, field: "kickoff_at" } %>
                            </div>
                            <div class="d-flex align-items-center justify-content-between" style="gap:8px;">
                              <div class="text-truncate" style="flex:1;font-size:12px;">
                                <%= match.home_name %>
                              </div>
                              <div class="d-flex align-items-center" style="gap:4px;">
                                <%= select_tag "matches[#{match.id}][home_score]",
                                      options_for_select((0..20).to_a, match.home_score),
                                      include_blank: "-",
                                      class: "form-select form-select-sm js-score-select js-mobile-field",
                                      style: "width:45px;font-size:11px;padding:2px;",
                                      data: { match_id: match.id, side: "home", field: "home_score" } %>
                                <span style="font-size:12px;font-weight:bold;">-</span>
                                <%= select_tag "matches[#{match.id}][away_score]",
                                      options_for_select((0..20).to_a, match.away_score),
                                      include_blank: "-",
                                      class: "form-select form-select-sm js-score-select js-mobile-field",
                                      style: "width:45px;font-size:11px;padding:2px;",
                                      data: { match_id: match.id, side: "away", field: "away_score" } %>
                              </div>
                              <div class="text-truncate text-end" style="flex:1;font-size:12px;">
                                <%= match.away_name %>
                              </div>
                            </div>
                            <% is_draw = match.home_score.present? && match.away_score.present? && match.home_score == match.away_score %>
                            <div class="mt-1 js-penalty-container" 
                                 id="penalty-container-mobile-<%= match.id %>"
                                 data-match-id="<%= match.id %>"
                                 style="<%= is_draw ? '' : 'display:none;' %>">
                              <%= select_tag "matches[#{match.id}][penalty_winner_side]",
                                    options_for_select([
                                      ["ไม่มียิงจุดโทษ", ""],
                                      ["#{match.home_name.presence || 'เหย้า'} ชนะ PK", "home"],
                                      ["#{match.away_name.presence || 'เยือน'} ชนะ PK", "away"]
                                    ], match.penalty_winner_side),
                                    class: "form-select form-select-sm js-mobile-field",
                                    style: "font-size:10px;",
                                    data: { match_id: match.id, field: "penalty_winner_side" } %>
                            </div>
                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 mt-2" style="padding:6px;">
                              <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
                                <path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" fill="currentColor"/>
                              </svg>
                              บันทึก
                            </button>
                          </div>
                        </div>
                      <% end %>
                    </div>
                    <%# Desktop table layout %>
                    <div class="d-none d-md-block table-responsive">
                      <table class="table table-sm align-middle mb-0" style="font-size:12px;">
                        <thead class="table-light">
                          <tr>
                            <th scope="col" style="width:50px;">คู่ที่</th>
                            <th scope="col" style="width:160px;">วัน/เวลา</th>
                            <th scope="col" style="width:70px;">สนาม</th>
                            <th scope="col">ทีมเหย้า</th>
                            <th scope="col">ทีมเยือน</th>
                            <th scope="col" style="width:120px;" class="text-center">สกอร์</th>
                            <th scope="col" style="width:40px;" class="text-center"></th>
                          </tr>
                        </thead>
                        <tbody>
                          <% matches.each_with_index do |match, midx| %>
                            <% is_scheduled = match.kickoff_at.present? %>
                            <tr class="match-row <%= is_scheduled ? 'scheduled' : 'unscheduled' %>" 
                                style="<%= is_scheduled ? 'background-color:#e8f5e9;' : 'background-color:#fff8e1;' %>">
                              <td>
                                <%= link_to match_tournament_path(@tournament, match_id: match.id), class: "text-decoration-none" do %>
                                  คู่ที่ <%= match.position || (midx + 1) %>
                                <% end %>
                              </td>
                              <td style="white-space:nowrap;">
                                <%= datetime_local_field_tag "matches[#{match.id}][kickoff_at]",
                                      (match.kickoff_at&.strftime("%Y-%m-%dT%H:%M")),
                                      class: "form-control form-control-sm",
                                      style: "font-size:11px;padding:2px 4px;" %>
                              </td>
                              <td>
                                <%= number_field_tag "matches[#{match.id}][pitch_no]",
                                      match.pitch_no,
                                      class: "form-control form-control-sm",
                                      style: "width:50px;font-size:11px;padding:2px 4px;",
                                      min: 0, max: 99 %>
                              </td>
                              <td>
                                <div class="d-flex align-items-center" style="gap:6px;">
                                  <% if match.home_team&.logo&.attached? %>
                                    <%= image_tag match.home_team.logo, class: "rounded-circle", style: "width:20px;height:20px;object-fit:cover;" %>
                                  <% end %>
                                  <span><%= match.home_name %></span>
                                </div>
                              </td>
                              <td>
                                <div class="d-flex align-items-center" style="gap:6px;">
                                  <% if match.away_team&.logo&.attached? %>
                                    <%= image_tag match.away_team.logo, class: "rounded-circle", style: "width:20px;height:20px;object-fit:cover;" %>
                                  <% end %>
                                  <span><%= match.away_name %></span>
                                </div>
                              </td>
                              <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center" style="gap:4px;">
                                  <%= select_tag "matches[#{match.id}][home_score]",
                                        options_for_select((0..20).to_a, match.home_score),
                                        include_blank: "-",
                                        class: "form-select form-select-sm js-score-select",
                                        style: "width:45px;font-size:11px;padding:2px;",
                                        data: { match_id: match.id, side: "home" } %>
                                  <span>-</span>
                                  <%= select_tag "matches[#{match.id}][away_score]",
                                        options_for_select((0..20).to_a, match.away_score),
                                        include_blank: "-",
                                        class: "form-select form-select-sm js-score-select",
                                        style: "width:45px;font-size:11px;padding:2px;",
                                        data: { match_id: match.id, side: "away" } %>
                                </div>
                                <% is_draw = match.home_score.present? && match.away_score.present? && match.home_score == match.away_score %>
                                <div class="mt-1 js-penalty-container" 
                                     id="penalty-container-<%= match.id %>"
                                     data-match-id="<%= match.id %>"
                                     style="<%= is_draw ? '' : 'display:none;' %>">
                                  <%= select_tag "matches[#{match.id}][penalty_winner_side]",
                                        options_for_select([
                                          ["ไม่มียิงจุดโทษ", ""],
                                          ["#{match.home_name.presence || 'เหย้า'} ชนะจุดโทษ", "home"],
                                          ["#{match.away_name.presence || 'เยือน'} ชนะจุดโทษ", "away"]
                                        ], match.penalty_winner_side),
                                        class: "form-select form-select-sm",
                                        style: "font-size:10px;padding:2px 4px;" %>
                                </div>
                              </td>
                              <td class="text-center">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" style="padding:4px 8px;" title="บันทึก">
                                  <svg viewBox="0 0 24 24" width="14" height="14">
                                    <path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" fill="currentColor"/>
                                  </svg>
                                </button>
                              </td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                <% end %>

                <div class="text-end mt-3 mb-2">
                  <button type="submit" class="btn btn-sm btn-primary">
                    <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
                      <path d="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" fill="currentColor"/>
                    </svg>
                    บันทึกการเปลี่ยนแปลง
                  </button>
                </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="text-muted" style="font-size:13px;">ยังไม่มีคู่แข่งขันในระบบ</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="bulkScheduleModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div class="fw-bold">ตั้งเวลาแข่งเป็นชุด</div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <%= form_with url: bulk_schedule_tournament_path(@tournament), method: :patch, local: true, id: "bulk-schedule-form" do %>
          <div class="row g-2" id="bulk-time-settings">
            <div class="col-12">
              <div class="d-flex align-items-center justify-content-between" style="gap:10px;">
                <div class="fw-bold" style="font-size:13px;">ตั้งค่าเวลา</div>
                <button type="button" class="btn btn-sm btn-success" id="bulk-add-batch-btn" style="display:none;">
                  เพิ่มชุดนี้ & ตั้งค่าชุดถัดไป
                </button>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" style="font-size:12px;">วันที่แข่ง</label>
              <%= date_field_tag :schedule_date,
                    (@selected_day&.strftime("%Y-%m-%d") || Time.zone.today.strftime("%Y-%m-%d")),
                    class: "form-control", id: "bulk-schedule-date" %>
            </div>
            <div class="col-12 col-md-6">
              <label class="form-label" style="font-size:12px;">เวลาเริ่มแข่ง (คู่แรกของชุดนี้)</label>
              <%= time_field_tag :start_time, "09:00", class: "form-control", id: "bulk-start-time" %>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label" style="font-size:12px;">สนาม</label>
              <%= number_field_tag :pitch_no, 1, class: "form-control", min: 1, max: 6, id: "bulk-pitch-no" %>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label" style="font-size:12px;">นาที/ครึ่ง</label>
              <%= number_field_tag :minutes_per_half, 20, class: "form-control", min: 1, id: "bulk-minutes-per-half" %>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label" style="font-size:12px;">จำนวนครึ่ง</label>
              <%= number_field_tag :halves_count, 2, class: "form-control", min: 1, max: 4, id: "bulk-halves-count" %>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label" style="font-size:12px;">พักครึ่ง (นาที)</label>
              <%= number_field_tag :break_between_halves, 5, class: "form-control", min: 0, id: "bulk-break-halves" %>
            </div>
            <div class="col-6 col-md-3">
              <label class="form-label" style="font-size:12px;">พักระหว่างคู่ (นาที)</label>
              <%= number_field_tag :break_between_matches, 5, class: "form-control", min: 0, id: "bulk-break-matches" %>
            </div>
          </div>

          <div id="bulk-batches-container" style="display:none;margin-top:16px;">
            <div class="fw-bold" style="font-size:13px;margin-bottom:8px;">ชุดที่เพิ่มแล้ว</div>
            <div id="bulk-batches-list"></div>
          </div>

          <hr style="margin:16px 0;">

          <%# ฟีเจอร์ปรับเวลาจากคู่ที่เลือกไป %>
          <div class="card mb-3" style="background:#fff3e0;border-color:#ffb74d;">
            <div class="card-body p-2">
              <div class="fw-bold" style="font-size:12px;color:#e65100;margin-bottom:8px;">
                <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;vertical-align:middle;">
                  <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" fill="currentColor"/>
                </svg>
                ปรับเวลาคู่ที่จัดไว้แล้ว
              </div>
              <div class="text-muted" style="font-size:11px;margin-bottom:8px;">เลือกคู่เริ่มต้น แล้วระบบจะคำนวณเวลาใหม่ให้คู่ถัดไปทั้งหมด</div>
              <div class="row g-2">
                <div class="col-12 col-md-4">
                  <label class="form-label" style="font-size:11px;">เริ่มจากคู่</label>
                  <select class="form-select form-select-sm" id="adjust-from-match">
                    <option value="">-- เลือกคู่ --</option>
                    <% @all_matches.select { |m| m.kickoff_at.present? }.sort_by(&:kickoff_at).each do |match| %>
                      <option value="<%= match.id %>" data-kickoff="<%= match.kickoff_at.strftime('%Y-%m-%dT%H:%M') %>">
                        <%= match.kickoff_at.strftime('%H:%M') %> - <%= match.tournament_division&.name %>: <%= match.home_name %> vs <%= match.away_name %>
                      </option>
                    <% end %>
                  </select>
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label" style="font-size:11px;">นาที/ครึ่ง (ใหม่)</label>
                  <%= number_field_tag :adjust_minutes_per_half, 20, class: "form-control form-control-sm", min: 1, id: "adjust-minutes-per-half" %>
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label" style="font-size:11px;">จำนวนครึ่ง</label>
                  <%= number_field_tag :adjust_halves_count, 2, class: "form-control form-control-sm", min: 1, max: 4, id: "adjust-halves-count" %>
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label" style="font-size:11px;">พักครึ่ง</label>
                  <%= number_field_tag :adjust_break_halves, 5, class: "form-control form-control-sm", min: 0, id: "adjust-break-halves" %>
                </div>
                <div class="col-6 col-md-2">
                  <label class="form-label" style="font-size:11px;">พักระหว่างคู่</label>
                  <%= number_field_tag :adjust_break_matches, 5, class: "form-control form-control-sm", min: 0, id: "adjust-break-matches" %>
                </div>
              </div>
              <div class="mt-2">
                <button type="button" class="btn btn-sm btn-warning" id="adjust-time-btn">
                  <svg viewBox="0 0 24 24" width="12" height="12" style="margin-right:4px;">
                    <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" fill="currentColor"/>
                  </svg>
                  คำนวณเวลาใหม่
                </button>
                <span id="adjust-time-result" class="ms-2" style="font-size:11px;"></span>
              </div>
            </div>
          </div>

          <div class="fw-bold" style="font-size:13px;">1) กำหนดคิวเตะ (เรียงตามที่คลิก)</div>
          <div class="text-muted" style="font-size:12px;margin-top:4px;">คลิกคู่ด้านล่างเพื่อเพิ่มเข้าคิว หากต้องการตั้งเวลาต่างกันในแต่ละชุด ให้กดปุ่ม "เพิ่มชุดนี้ & ตั้งค่าชุดถัดไป"</div>

          <div id="bulk-schedule-root" data-preselected-ids="">
            <div class="d-flex align-items-center justify-content-between" style="gap:10px;">
              <div class="fw-bold" style="font-size:12px;">คิวชุดปัจจุบัน</div>
              <button type="button" class="btn btn-sm btn-outline-danger" id="bulk-schedule-clear">Clear</button>
            </div>

            <div id="bulk-schedule-queue" style="margin-top:8px;border:1px solid #e5e7eb;border-radius:10px;padding:8px;min-height:52px;background:#fafafa;"></div>
            <div id="bulk-schedule-hidden-inputs"></div>

            <div class="mt-3 fw-bold" style="font-size:12px;">2) รายการคู่ทั้งหมด (คลิกเพื่อเพิ่มเข้าคิว)</div>
            <div style="max-height:38vh;overflow:auto;border:1px solid #e5e7eb;border-radius:10px;padding:10px;margin-top:8px;">
              <% matches_by_division = @all_matches.group_by { |m| m.tournament_division } %>
              <% matches_by_division.each do |division, div_matches| %>
                <div class="mb-3">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="fw-bold" style="font-size:12px;color:#1976d2;"><%= division&.name || 'ไม่ระบุรุ่น' %></div>
                    <button type="button" class="btn btn-xs btn-outline-primary js-select-all-division" data-division-id="<%= division&.id %>" style="font-size:10px;padding:2px 6px;">
                      เลือกทั้งหมด
                    </button>
                  </div>
                  <% # Group by stage: group matches first, then knockout %>
                  <% group_matches = div_matches.select { |m| m.group_stage? }.sort_by { |m| [m.group&.name || '', m.position || 0] } %>
                  <% knockout_matches = div_matches.select { |m| m.knockout? }.sort_by { |m| m.position || 0 } %>
                  
                  <% if group_matches.any? %>
                    <div class="mb-2">
                      <div class="text-muted" style="font-size:10px;margin-bottom:4px;">รอบแบ่งกลุ่ม</div>
                      <% group_matches.group_by { |m| m.group&.name }.each do |group_name, gmatches| %>
                        <div class="mb-1">
                          <span class="badge bg-secondary" style="font-size:9px;">สาย <%= group_name || '-' %></span>
                          <% gmatches.each do |match| %>
                            <% label = "สาย#{group_name} · #{match.home_name} vs #{match.away_name}" %>
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary mb-1 js-bulk-match-btn"
                                    data-bulk-match="1"
                                    data-match-id="<%= match.id %>"
                                    data-division-id="<%= division&.id %>"
                                    data-label="<%= division&.name %> · <%= label %>"
                                    data-kickoff-at="<%= match.kickoff_at&.iso8601 %>"
                                    style="font-size:10px;padding:2px 6px;">
                              <%= match.home_name %> vs <%= match.away_name %>
                            </button>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                  
                  <% if knockout_matches.any? %>
                    <div>
                      <div class="text-muted" style="font-size:10px;margin-bottom:4px;">รอบน็อคเอาท์</div>
                      <% knockout_matches.each do |match| %>
                        <% label = "#{match.round_label || 'KO'} · #{match.home_name} vs #{match.away_name}" %>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary mb-1 js-bulk-match-btn"
                                data-bulk-match="1"
                                data-match-id="<%= match.id %>"
                                data-division-id="<%= division&.id %>"
                                data-label="<%= division&.name %> · <%= label %>"
                                data-kickoff-at="<%= match.kickoff_at&.iso8601 %>"
                                style="font-size:10px;padding:2px 6px;">
                          <%= match.round_label || 'KO' %>: <%= match.home_name %> vs <%= match.away_name %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <hr style="margin:8px 0;border-color:#e0e0e0;">
              <% end %>
            </div>
          </div>

          <div class="d-flex justify-content-end" style="gap:8px;margin-top:16px;">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">ปิด</button>
            <button type="submit" class="btn btn-sm btn-primary">บันทึกเวลาแข่ง</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    function initBulkScheduleQueue() {
      var root = document.getElementById('bulk-schedule-root');
      if (!root || root.getAttribute('data-queue-init') === '1') return;
      root.setAttribute('data-queue-init', '1');

      var modal = document.getElementById('bulkScheduleModal');
      var form = modal ? modal.querySelector('form') : null;
      var queueEl = document.getElementById('bulk-schedule-queue');
      var hiddenEl = document.getElementById('bulk-schedule-hidden-inputs');
      var clearBtn = document.getElementById('bulk-schedule-clear');
      var addBatchBtn = document.getElementById('bulk-add-batch-btn');
      var batchesContainer = document.getElementById('bulk-batches-container');
      var batchesList = document.getElementById('bulk-batches-list');
      if (!form || !queueEl || !hiddenEl) return;

      var scheduleDateInput = document.getElementById('bulk-schedule-date');
      var startTimeInput = document.getElementById('bulk-start-time');
      var pitchNoInput = document.getElementById('bulk-pitch-no');
      var minutesPerHalfInput = document.getElementById('bulk-minutes-per-half');
      var halvesCountInput = document.getElementById('bulk-halves-count');
      var breakHalvesInput = document.getElementById('bulk-break-halves');
      var breakMatchesInput = document.getElementById('bulk-break-matches');

      var queue = [];
      var batches = [];

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function getCurrentSettings() {
        return {
          schedule_date: scheduleDateInput ? scheduleDateInput.value : '',
          start_time: startTimeInput ? startTimeInput.value : '09:00',
          pitch_no: pitchNoInput ? pitchNoInput.value : '1',
          minutes_per_half: minutesPerHalfInput ? minutesPerHalfInput.value : '20',
          halves_count: halvesCountInput ? halvesCountInput.value : '2',
          break_between_halves: breakHalvesInput ? breakHalvesInput.value : '5',
          break_between_matches: breakMatchesInput ? breakMatchesInput.value : '5'
        };
      }

      function calculateEndTime(settings, matchCount) {
        if (!settings.start_time || matchCount <= 0) return null;
        var mins = parseInt(settings.minutes_per_half, 10) || 20;
        var halves = parseInt(settings.halves_count, 10) || 2;
        var breakHalves = parseInt(settings.break_between_halves, 10) || 5;
        var breakMatches = parseInt(settings.break_between_matches, 10) || 5;
        var matchDuration = (mins * halves) + ((halves - 1) * breakHalves);
        var totalMins = (matchDuration * matchCount) + (breakMatches * (matchCount - 1));
        var parts = settings.start_time.split(':');
        var startMins = (parseInt(parts[0], 10) || 0) * 60 + (parseInt(parts[1], 10) || 0);
        var endMins = startMins + totalMins;
        var endH = Math.floor(endMins / 60) % 24;
        var endM = endMins % 60;
        return String(endH).padStart(2, '0') + ':' + String(endM).padStart(2, '0');
      }

      function getAllQueuedIds() {
        var ids = new Set();
        batches.forEach(function(b) {
          b.matches.forEach(function(m) { ids.add(String(m.id)); });
        });
        queue.forEach(function(m) { ids.add(String(m.id)); });
        return ids;
      }

      function renderBatches() {
        if (!batchesContainer || !batchesList) return;
        if (batches.length === 0) {
          batchesContainer.style.display = 'none';
          return;
        }
        batchesContainer.style.display = 'block';
        batchesList.innerHTML = batches.map(function(batch, batchIdx) {
          var endTime = calculateEndTime(batch.settings, batch.matches.length);
          var timeRange = batch.settings.start_time + (endTime ? ' - ' + endTime : '');
          return '' +
            '<div style="border:1px solid #d1fae5;border-radius:10px;padding:10px;margin-bottom:8px;background:#ecfdf5;">' +
            '  <div class="d-flex align-items-center justify-content-between" style="gap:8px;">' +
            '    <div>' +
            '      <span class="badge bg-success" style="font-size:11px;">ชุดที่ ' + (batchIdx + 1) + '</span>' +
            '      <span style="font-size:12px;margin-left:6px;">' + batch.settings.schedule_date + ' ' + timeRange + '</span>' +
            '      <span style="font-size:11px;color:#6b7280;margin-left:6px;">สนาม ' + batch.settings.pitch_no + ' · ' + batch.settings.minutes_per_half + ' นาที/ครึ่ง</span>' +
            '    </div>' +
            '    <button type="button" class="btn btn-sm btn-outline-danger" data-remove-batch="' + batchIdx + '" style="padding:2px 8px;font-size:11px;">ลบชุด</button>' +
            '  </div>' +
            '  <div style="font-size:11px;color:#374151;margin-top:6px;">' +
            batch.matches.map(function(m, mIdx) {
              var parts = m.label.split(' · ');
              var short = parts.length ? parts[parts.length - 1] : m.label;
              return '<span style="display:inline-block;background:#fff;border:1px solid #d1d5db;border-radius:4px;padding:2px 6px;margin:2px;">' + (mIdx + 1) + '. ' + escapeHtml(short) + '</span>';
            }).join('') +
            '  </div>' +
            '</div>';
        }).join('');
      }

      function renderHiddenInputs() {
        hiddenEl.innerHTML = '';
        if (batches.length > 0) {
          batches.forEach(function(batch, batchIdx) {
            batch.matches.forEach(function(m) {
              var input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'batches[' + batchIdx + '][match_ids][]';
              input.value = String(m.id);
              hiddenEl.appendChild(input);
            });
            Object.keys(batch.settings).forEach(function(key) {
              var input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'batches[' + batchIdx + '][' + key + ']';
              input.value = batch.settings[key];
              hiddenEl.appendChild(input);
            });
          });
          if (queue.length > 0) {
            var currentBatchIdx = batches.length;
            var settings = getCurrentSettings();
            queue.forEach(function(m) {
              var input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'batches[' + currentBatchIdx + '][match_ids][]';
              input.value = String(m.id);
              hiddenEl.appendChild(input);
            });
            Object.keys(settings).forEach(function(key) {
              var input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'batches[' + currentBatchIdx + '][' + key + ']';
              input.value = settings[key];
              hiddenEl.appendChild(input);
            });
          }
        } else {
          queue.forEach(function(item) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'match_ids[]';
            input.value = String(item.id);
            hiddenEl.appendChild(input);
          });
        }
      }

      function render() {
        renderBatches();
        renderHiddenInputs();

        if (addBatchBtn) {
          addBatchBtn.style.display = queue.length > 0 ? 'inline-flex' : 'none';
        }

        if (!queue.length) {
          queueEl.innerHTML = '<div class="text-muted" style="font-size:12px;">ยังไม่ได้เลือกคู่ (คลิกจากรายการด้านล่างเพื่อเพิ่ม)</div>';
          syncAvailableMatchButtons();
          return;
        }

        queueEl.innerHTML = queue.map(function(item, idx) {
          var safeLabel = escapeHtml(item.label);
          var parts = safeLabel.split(' · ');
          var opponent = parts.length ? parts[parts.length - 1] : safeLabel;
          var prefix = parts.length > 1 ? parts.slice(0, -1).join(' · ') : '';
          return '' +
            '<div draggable="true" data-queue-item="1" data-queue-id="' + item.id + '" class="d-flex align-items-center justify-content-between" style="gap:10px;padding:6px 6px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);background:#ffffff;margin-bottom:6px;cursor:grab;">' +
            '  <div style="font-size:12px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' +
            '    <span style="font-weight:700;">' + (idx + 1) + '.</span> ' +
            (prefix ? ('<span class="text-muted">' + prefix + ' · </span>') : '') +
            '<strong>' + opponent + '</strong>' +
            '  </div>' +
            '  <button type="button" class="btn btn-sm btn-outline-secondary" data-queue-remove="' + item.id + '">ลบ</button>' +
            '</div>';
        }).join('');

        syncAvailableMatchButtons();
      }

      function syncAvailableMatchButtons() {
        var queued = getAllQueuedIds();
        document.querySelectorAll('[data-bulk-match="1"]').forEach(function(btn) {
          var id = btn.getAttribute('data-match-id');
          if (!id) return;
          btn.style.display = queued.has(String(id)) ? 'none' : '';
        });
      }

      function addToQueue(matchId, label) {
        matchId = parseInt(matchId, 10);
        if (!matchId) return;
        var allIds = getAllQueuedIds();
        if (allIds.has(String(matchId))) return;
        queue.push({ id: matchId, label: label || ('#' + matchId) });
        render();
      }

      function removeFromQueue(matchId) {
        matchId = parseInt(matchId, 10);
        if (!matchId) return;
        queue = queue.filter(function(x) { return x.id !== matchId; });
        render();
      }

      function clearQueue() {
        queue = [];
        render();
      }

      function addBatch() {
        if (queue.length === 0) return;
        var settings = getCurrentSettings();
        batches.push({
          settings: settings,
          matches: queue.slice()
        });
        queue = [];
        var endTime = calculateEndTime(settings, batches[batches.length - 1].matches.length);
        if (endTime && startTimeInput) {
          startTimeInput.value = endTime;
        }
        render();
      }

      function removeBatch(batchIdx) {
        batchIdx = parseInt(batchIdx, 10);
        if (batchIdx < 0 || batchIdx >= batches.length) return;
        batches.splice(batchIdx, 1);
        render();
      }

      document.addEventListener('click', function(e) {
        var btn = e.target.closest && e.target.closest('[data-bulk-match="1"]');
        if (btn) {
          e.preventDefault();
          var id = btn.getAttribute('data-match-id');
          var label = btn.getAttribute('data-label') || btn.innerText;
          addToQueue(id, label);
        }

        var removeBtn = e.target.closest && e.target.closest('[data-queue-remove]');
        if (removeBtn) {
          e.preventDefault();
          removeFromQueue(removeBtn.getAttribute('data-queue-remove'));
        }

        var removeBatchBtn = e.target.closest && e.target.closest('[data-remove-batch]');
        if (removeBatchBtn) {
          e.preventDefault();
          removeBatch(removeBatchBtn.getAttribute('data-remove-batch'));
        }
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', function(e) {
          e.preventDefault();
          clearQueue();
        });
      }

      if (addBatchBtn) {
        addBatchBtn.addEventListener('click', function(e) {
          e.preventDefault();
          addBatch();
        });
      }

      render();
    }

    document.addEventListener('turbo:load', initBulkScheduleQueue);
    document.addEventListener('DOMContentLoaded', initBulkScheduleQueue);
  })();

  // ฟีเจอร์เลือกทั้งหมดตามรุ่น
  document.addEventListener('click', function(e) {
    var selectAllBtn = e.target.closest('.js-select-all-division');
    if (selectAllBtn) {
      e.preventDefault();
      var divisionId = selectAllBtn.getAttribute('data-division-id');
      var matchBtns = document.querySelectorAll('.js-bulk-match-btn[data-division-id="' + divisionId + '"]');
      matchBtns.forEach(function(btn) {
        if (btn.style.display !== 'none') {
          btn.click();
        }
      });
    }
  });

  // ฟีเจอร์ปรับเวลาจากคู่ที่เลือกไป
  (function() {
    var adjustBtn = document.getElementById('adjust-time-btn');
    var adjustFromMatch = document.getElementById('adjust-from-match');
    var adjustResult = document.getElementById('adjust-time-result');
    
    if (!adjustBtn || !adjustFromMatch) return;
    
    adjustBtn.addEventListener('click', function(e) {
      e.preventDefault();
      
      var fromMatchId = adjustFromMatch.value;
      if (!fromMatchId) {
        adjustResult.innerHTML = '<span class="text-danger">กรุณาเลือกคู่เริ่มต้น</span>';
        return;
      }
      
      var minsPerHalfVal = document.getElementById('adjust-minutes-per-half').value;
      var halvesCountVal = document.getElementById('adjust-halves-count').value;
      var breakHalvesVal = document.getElementById('adjust-break-halves').value;
      var breakMatchesVal = document.getElementById('adjust-break-matches').value;
      
      var minsPerHalf = minsPerHalfVal !== '' ? parseInt(minsPerHalfVal, 10) : 20;
      var halvesCount = halvesCountVal !== '' ? parseInt(halvesCountVal, 10) : 2;
      var breakHalves = breakHalvesVal !== '' ? parseInt(breakHalvesVal, 10) : 5;
      var breakMatches = breakMatchesVal !== '' ? parseInt(breakMatchesVal, 10) : 5;
      
      var matchDuration = (minsPerHalf * halvesCount) + ((halvesCount - 1) * breakHalves);
      
      // ส่ง AJAX request ไปยัง server เพื่อปรับเวลา
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = '<%= adjust_times_tournament_path(@tournament) %>';
      form.style.display = 'none';
      
      var csrfToken = document.querySelector('meta[name="csrf-token"]');
      if (csrfToken) {
        var tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = 'authenticity_token';
        tokenInput.value = csrfToken.content;
        form.appendChild(tokenInput);
      }
      
      var methodInput = document.createElement('input');
      methodInput.type = 'hidden';
      methodInput.name = '_method';
      methodInput.value = 'patch';
      form.appendChild(methodInput);
      
      var fields = [
        ['from_match_id', fromMatchId],
        ['minutes_per_half', minsPerHalf],
        ['halves_count', halvesCount],
        ['break_between_halves', breakHalves],
        ['break_between_matches', breakMatches]
      ];
      
      fields.forEach(function(f) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = f[0];
        input.value = f[1];
        form.appendChild(input);
      });
      
      document.body.appendChild(form);
      form.submit();
    });
  })();
</script>

