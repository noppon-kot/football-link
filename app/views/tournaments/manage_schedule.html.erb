<script>
(function() {
  var divisionsData = <%= raw @divisions.map { |d| 
    # Get teams by group from team_registrations AND matches
    teams_by_group = {}
    d.groups.each do |g|
      # Get teams from team_registrations with this group
      reg_team_ids = d.team_registrations.confirmed_for_competition.where(group_id: g.id).pluck(:team_id).compact
      # Also get teams from matches in this group (for backward compatibility)
      match_team_ids = d.matches.group_stage.where(group_id: g.id).pluck(:home_team_id, :away_team_id).flatten.compact.uniq
      # Combine both
      all_team_ids = (reg_team_ids + match_team_ids).uniq
      teams = Team.where(id: all_team_ids).pluck(:id, :name).map { |id, name| { id: id, name: name } }
      teams_by_group[g.id] = teams
    end
    
    { 
      id: d.id, 
      name: d.name,
      groups: d.groups.order(:name).map { |g| { id: g.id, name: g.name } },
      teams: d.team_registrations.confirmed_for_competition.includes(:team).map { |r| { id: r.team_id, name: r.team&.name || r.team_name } },
      teams_by_group: teams_by_group
    } 
  }.to_json %>;

  function initAddMatchModal() {
    var divSelect = document.getElementById('addMatch_division');
    var stageSelect = document.getElementById('addMatch_stage');
    var groupSelect = document.getElementById('addMatch_group');
    var groupContainer = document.getElementById('addMatch_groupContainer');
    var roundContainer = document.getElementById('addMatch_roundContainer');
    var homeTeamSelect = document.getElementById('addMatch_homeTeam');
    var awayTeamSelect = document.getElementById('addMatch_awayTeam');

    if (!divSelect) return;

    function updateGroups() {
      var divId = parseInt(divSelect.value, 10);
      var div = divisionsData.find(function(d) { return d.id === divId; });
      
      groupSelect.innerHTML = '<option value="">-- เลือกสาย --</option>';
      if (div && div.groups) {
        div.groups.forEach(function(g) {
          var opt = document.createElement('option');
          opt.value = g.id;
          opt.textContent = 'สาย ' + g.name;
          groupSelect.appendChild(opt);
        });
      }
    }

    function updateTeams() {
      var divId = parseInt(divSelect.value, 10);
      var div = divisionsData.find(function(d) { return d.id === divId; });
      var groupId = parseInt(groupSelect.value, 10);
      var stage = stageSelect.value;
      
      homeTeamSelect.innerHTML = '<option value="">-- เลือกทีม --</option>';
      awayTeamSelect.innerHTML = '<option value="">-- เลือกทีม --</option>';
      
      if (!div) return;
      
      var teams = [];
      
      // If group stage and group selected, filter by group
      if (stage === 'group_stage' && groupId && div.teams_by_group && div.teams_by_group[groupId]) {
        teams = div.teams_by_group[groupId];
      } else {
        // Otherwise show all teams in division
        teams = div.teams || [];
      }
      
      teams.forEach(function(t) {
        var opt1 = document.createElement('option');
        opt1.value = t.id;
        opt1.textContent = t.name;
        homeTeamSelect.appendChild(opt1);
        
        var opt2 = document.createElement('option');
        opt2.value = t.id;
        opt2.textContent = t.name;
        awayTeamSelect.appendChild(opt2);
      });
    }

    function updateStageUI() {
      var stage = stageSelect.value;
      if (stage === 'knockout') {
        groupContainer.style.display = 'none';
        roundContainer.style.display = 'block';
      } else {
        groupContainer.style.display = 'block';
        roundContainer.style.display = 'none';
      }
    }

    divSelect.addEventListener('change', function() {
      updateGroups();
      updateTeams();
    });

    groupSelect.addEventListener('change', function() {
      updateTeams();
    });

    stageSelect.addEventListener('change', function() {
      updateStageUI();
      updateTeams();
    });

    // Auto-shift checkbox toggle
    var autoShiftCheckbox = document.getElementById('addMatch_autoShift');
    var shiftOptions = document.getElementById('addMatch_shiftOptions');
    if (autoShiftCheckbox && shiftOptions) {
      autoShiftCheckbox.addEventListener('change', function() {
        shiftOptions.style.display = this.checked ? 'block' : 'none';
      });
    }

    // Initialize
    updateGroups();
    updateTeams();
    updateStageUI();
  }

  document.addEventListener('turbo:load', initAddMatchModal);
  document.addEventListener('DOMContentLoaded', initAddMatchModal);
})();

// Filter scheduled/unscheduled matches
(function() {
  function initScheduleFilter() {
    var filterRadios = document.querySelectorAll('input[name="filter-schedule"]');
    var matchRows = document.querySelectorAll('.match-row');
    
    if (!filterRadios.length || !matchRows.length) return;
    
    filterRadios.forEach(function(radio) {
      radio.addEventListener('change', function() {
        var filterValue = this.value;
        
        matchRows.forEach(function(row) {
          if (filterValue === 'all') {
            row.style.display = '';
          } else if (filterValue === 'scheduled') {
            row.style.display = row.classList.contains('scheduled') ? '' : 'none';
          } else if (filterValue === 'unscheduled') {
            row.style.display = row.classList.contains('unscheduled') ? '' : 'none';
          }
        });
      });
    });
  }
  
  document.addEventListener('turbo:load', initScheduleFilter);
  document.addEventListener('DOMContentLoaded', initScheduleFilter);
})();

// Show/hide penalty dropdown when score is a draw
(function() {
  function initPenaltyToggle() {
    var scoreSelects = document.querySelectorAll('.js-score-select');
    
    scoreSelects.forEach(function(select) {
      select.addEventListener('change', function() {
        var matchId = this.dataset.matchId;
        var penaltyContainer = document.getElementById('penalty-container-' + matchId);
        if (!penaltyContainer) return;
        
        // Find both score selects for this match
        var homeSelect = document.querySelector('.js-score-select[data-match-id="' + matchId + '"][data-side="home"]');
        var awaySelect = document.querySelector('.js-score-select[data-match-id="' + matchId + '"][data-side="away"]');
        
        if (!homeSelect || !awaySelect) return;
        
        var homeScore = homeSelect.value;
        var awayScore = awaySelect.value;
        
        // Show penalty dropdown only if both scores are filled and equal
        if (homeScore !== '' && awayScore !== '' && homeScore === awayScore) {
          penaltyContainer.style.display = 'block';
        } else {
          penaltyContainer.style.display = 'none';
        }
      });
    });
  }
  
  document.addEventListener('turbo:load', initPenaltyToggle);
  document.addEventListener('DOMContentLoaded', initPenaltyToggle);
  
  // Disable hidden fields before form submit to prevent duplicate field names
  function initFormSubmitHandler() {
    document.querySelectorAll('form').forEach(function(form) {
      form.addEventListener('submit', function() {
        var isMobile = window.innerWidth < 768;
        
        // Disable fields in the hidden layout
        if (isMobile) {
          // On mobile, disable desktop fields
          form.querySelectorAll('.d-none.d-md-block input, .d-none.d-md-block select').forEach(function(el) {
            el.disabled = true;
          });
        } else {
          // On desktop, disable mobile fields
          form.querySelectorAll('.d-md-none input, .d-md-none select').forEach(function(el) {
            el.disabled = true;
          });
        }
      });
    });
  }
  
  document.addEventListener('turbo:load', initFormSubmitHandler);
  document.addEventListener('DOMContentLoaded', initFormSubmitHandler);
})();
</script>

