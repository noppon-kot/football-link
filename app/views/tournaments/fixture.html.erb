                          <% if home_clickable %>
                            <%= link_to my_entry_lineup_tournament_path(@tournament, team_registration_id: home_entry_id, match_id: match.id),
                                  title: "เหย้า Line Up: #{home_lineup_ok ? 'ส่งแล้ว' : 'ยังไม่ส่ง'}",
                                  style: "color:#{home_lineup_ok ? '#16a34a' : '#9ca3af'};display:inline-flex;align-items:center;text-decoration:none;" do %>
                              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-5.33 0-8 2.67-8 5v1h16v-1c0-2.33-2.67-5-8-5Z"/>
                              </svg>
                            <% end %>
                          <% else %>
                            <span title="เหย้า Line Up: <%= home_lineup_ok ? 'ส่งแล้ว' : 'ยังไม่ส่ง' %>" style="color:<%= home_lineup_ok ? '#16a34a' : '#9ca3af' %>;display:inline-flex;align-items:center;">
                              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-5.33 0-8 2.67-8 5v1h16v-1c0-2.33-2.67-5-8-5Z"/>
                              </svg>
                            </span>
                          <% end %>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center" style="gap:6px;">
                          <% if match.away_team&.logo&.attached? %>
