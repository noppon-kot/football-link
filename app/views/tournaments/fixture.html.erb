                              <td style="white-space:nowrap;padding:8px 4px;font-size:11px;"><%= match.tournament_division&.name || "-" %></td>
                              <td style="white-space:nowrap;padding:8px 4px;font-size:11px;"><%= round_title %></td>
                              <td style="padding:8px 8px;">
                                <div class="d-flex align-items-center" style="gap:6px;">
                                  <% if match.home_team&.logo&.attached? %>
                                    <%= image_tag match.home_team.logo, style: "width:22px;height:22px;border-radius:50%;object-fit:cover;flex-shrink:0;", crossorigin: "anonymous" %>
                                  <% else %>
                                    <div style="width:22px;height:22px;border-radius:50%;background:#e2e8f0;flex-shrink:0;"></div>
                                  <% end %>
                                  <span style="color:#16a34a;"><%= match.home_name %></span>
                                </div>
                              </td>
                              <td style="padding:8px 8px;">
                                <div class="d-flex align-items-center" style="gap:6px;">
                                  <% if match.away_team&.logo&.attached? %>
                                    <%= image_tag match.away_team.logo, style: "width:22px;height:22px;border-radius:50%;object-fit:cover;flex-shrink:0;", crossorigin: "anonymous" %>
                                  <% else %>
                                    <div style="width:22px;height:22px;border-radius:50%;background:#e2e8f0;flex-shrink:0;"></div>
                                  <% end %>
                                  <span style="color:#16a34a;"><%= match.away_name %></span>
                                </div>
                              </td>
                              <td style="text-align:center;white-space:nowrap;padding:8px 4px;font-size:12px;">
                                <% if match.home_score.present? && match.away_score.present? %>
