                          <span style="font-weight:600;"><%= match.away_name %></span>
                          <% away_lineup_ok = (@lineup_submitted_by_match_and_side && @lineup_submitted_by_match_and_side[[match.id, "away"]]) %>
                          <% away_entry_id = (@entry_id_by_match_and_side && @entry_id_by_match_and_side[[match.id, "away"]]) %>
                          <% away_clickable = current_user.present? && away_entry_id.present? && @manageable_entry_ids&.include?(away_entry_id) %>
                          <% if away_clickable %>
                            <%= link_to my_entry_lineup_tournament_path(@tournament, team_registration_id: away_entry_id, match_id: match.id),
                                  title: "เยือน Line Up: #{away_lineup_ok ? 'ส่งแล้ว' : 'ยังไม่ส่ง'}",
                                  style: "color:#{away_lineup_ok ? '#16a34a' : '#9ca3af'};display:inline-flex;align-items:center;text-decoration:none;" do %>
                              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-5.33 0-8 2.67-8 5v1h16v-1c0-2.33-2.67-5-8-5Z"/>
                              </svg>
                            <% end %>
                          <% else %>
                            <span title="เยือน Line Up: <%= away_lineup_ok ? 'ส่งแล้ว' : 'ยังไม่ส่ง' %>" style="color:<%= away_lineup_ok ? '#16a34a' : '#9ca3af' %>;display:inline-flex;align-items:center;">
                              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
                                <path fill="currentColor" d="M12 12a5 5 0 1 0-5-5 5 5 0 0 0 5 5Zm0 2c-5.33 0-8 2.67-8 5v1h16v-1c0-2.33-2.67-5-8-5Z"/>
