<% content_for :og_title do %>
  <%= "โปรแกรม · #{@tournament.title}" %>
<% end %>
<% content_for :og_description do %>
  <%= [(@selected_day.present? ? "Match Day #{@selected_day.strftime('%d/%m/%Y')}" : "Match Day"), tournament_competition_date_label(@tournament), @tournament.location_name.presence].compact.join(" · ") %>
<% end %>
<% content_for :og_url do %>
  <%= request.original_url %>
<% end %>
<% content_for :og_image do %>
  <%= begin
        if @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>
<% end %>

<div class="app-shell">
  <% day_has_result = @next_day_matches_page.any? { |m| m.home_score.present? && m.away_score.present? } %>
  <% share_title = day_has_result ? "ผลการแข่งขัน" : "MATCH DAY" %>
  <% theme_primary = day_has_result ? "#0a1b3a" : "#063a2a" %>
  <% theme_secondary = day_has_result ? "#0b2a4f" : "#0b4a33" %>
  <% title_accent = day_has_result ? "#8ecbff" : "#d7ff59" %>
  <% label_accent = day_has_result ? "rgba(142,203,255,0.95)" : "rgba(215,255,89,0.95)" %>

  <% share_count = (@next_day_matches_page || []).size %>
  <% share_base_height = 1350 %>
  <% share_extra_matches = share_count > 6 ? (share_count - 6) : 0 %>
  <% share_footer_buffer = 180 %>
  <% share_card_height = share_base_height + (share_extra_matches * 220) + share_footer_buffer %>

  <div id="fixture-share-card" style="position:fixed;left:-10000px;top:0;width:1080px;height:<%= share_card_height %>px;overflow:hidden;">
    <div data-theme-root style="position:relative;width:1080px;height:<%= share_card_height %>px;background:#071b14;">
      <div style="position:absolute;inset:0;background-image:url('<%= asset_path("banner2.png") %>');background-size:cover;background-position:center;filter:brightness(0.45);"></div>
      <div data-theme-gradient style="position:absolute;inset:0;background:linear-gradient(135deg, <%= theme_primary %>e0 0%, <%= theme_secondary %>c7 45%, <%= theme_primary %>e0 100%);"></div>

      <div style="position:absolute;left:80px;right:80px;top:48px;display:flex;justify-content:space-between;align-items:flex-start;gap:18px;">
        <div>
          <div data-theme-title style="font-size:50px;font-weight:900;letter-spacing:0.4px;line-height:1.05;color:<%= title_accent %>;text-transform:uppercase;">
            <%= @tournament.title %>
          </div>
          <div style="margin-top:12px;font-size:30px;font-weight:900;color:rgba(255,255,255,0.92);letter-spacing:0.8px;">
            <%= share_title %>
          </div>
          <div style="margin-top:8px;font-size:18px;color:rgba(255,255,255,0.88);">
            <%= @selected_day.present? ? @selected_day.strftime("%d/%m/%Y") : "-" %>
            <% if @tournament.location_name.present? %>
              · <%= @tournament.location_name %>
            <% end %>
            <% if @next_day_matches_total_pages > 1 %>
              · หน้า <%= @day_page %>/<%= @next_day_matches_total_pages %>
            <% end %>
          </div>
        </div>
      </div>

      <div style="position:absolute;left:80px;right:80px;top:250px;bottom:170px;background:rgba(10,18,36,0.70);border:1px solid rgba(255,255,255,0.14);border-radius:18px;overflow:hidden;">
        <div style="padding:14px 16px;">
          <% if @next_day_matches_page.any? %>
            <% @next_day_matches_page.each do |match| %>
              <div style="padding:16px 24px 14px 24px;border:1px solid rgba(255,255,255,0.16);border-radius:16px;background:rgba(0,0,0,0.18);margin-bottom:10px;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                  <div style="font-size:21px;font-weight:900;color:#ffffff;">
                    <%= match.kickoff_at.present? ? match.kickoff_at.strftime("%H:%M") : "-" %>
                  </div>
                  <div style="font-size:15px;font-weight:800;color:rgba(255,255,255,0.88);">
                    <% if match.tournament_division&.name.present? %>
                      รุ่น <%= match.tournament_division.name %><% if match.group&.name.present? %>/สาย<%= match.group.name %><% end %>
                    <% end %>
                  </div>
                </div>

                <div style="margin-top:10px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 10px;">
                  <div style="flex:1;min-width:0;">
                    <div data-theme-label style="font-size:16px;font-weight:900;color:<%= label_accent %>;margin-bottom:6px;">ทีมเหย้า</div>
                    <div style="display:flex;align-items:center;gap:10px;">
                      <% if match.home_team&.logo&.attached? %>
                        <%= image_tag match.home_team.logo, style: "width:56px;height:56px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,0.12);", crossorigin: "anonymous" %>
                      <% else %>
                        <div style="width:56px;height:56px;border-radius:999px;background:rgba(255,255,255,0.12);"></div>
                      <% end %>
                      <div style="font-size:32px;font-weight:900;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        <%= match.home_name %>
                      </div>
                    </div>
                  </div>

                  <div style="flex:0 0 auto;text-align:center;">
                    <div style="font-size:26px;font-weight:900;color:rgba(255,255,255,0.86);letter-spacing:1.2px;">VS</div>
                    <% if match.home_score.present? && match.away_score.present? %>
                      <div style="margin-top:4px;font-size:20px;font-weight:900;color:#ffffff;letter-spacing:0.4px;">
                        <%= match.home_score %> - <%= match.away_score %>
                      </div>
                    <% end %>
                  </div>

                  <div style="flex:1;min-width:0;">
                    <div data-theme-label style="font-size:16px;font-weight:900;color:<%= label_accent %>;margin-bottom:6px;text-align:right;">ทีมเยือน</div>
                    <div style="display:flex;align-items:center;gap:10px;justify-content:flex-end;">
                      <div style="font-size:32px;font-weight:900;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        <%= match.away_name %>
                      </div>
                      <% if match.away_team&.logo&.attached? %>
                        <%= image_tag match.away_team.logo, style: "width:56px;height:56px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,0.12);", crossorigin: "anonymous" %>
                      <% else %>
                        <div style="width:56px;height:56px;border-radius:999px;background:rgba(255,255,255,0.12);"></div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div style="padding:26px 0;color:rgba(255,255,255,0.85);font-size:18px;font-weight:700;">ยังไม่มีข้อมูลสำหรับวันที่นี้</div>
          <% end %>
        </div>
      </div>

      <div style="position:absolute;left:80px;right:80px;bottom:48px;display:flex;justify-content:flex-end;">
        <div style="display:flex;align-items:center;gap:10px;color:rgba(255,255,255,0.92);border:1px solid rgba(255,255,255,0.18);background:rgba(255,255,255,0.08);padding:10px 14px;border-radius:14px;white-space:nowrap;">
          <%= image_tag "dernsai_icon.png", alt: "DERNSAI", style: "width:28px;height:28px;border-radius:8px;object-fit:contain;background:rgba(255,255,255,0.08);padding:4px;", crossorigin: "anonymous" %>
          <span style="font-size:14px;font-weight:800;letter-spacing:0.6px;">DERNSAI.com</span>
        </div>
      </div>

    </div>
  </div>

  <div class="tournament-show-body">
    <div class="container py-2 fixture-page-wrap">
      <style>
        .fixture-page-wrap {
          background: #f6f7f9;
          border-radius: 14px;
          padding: 10px 10px 14px 10px;
        }

        @media (min-width: 768px) {
          [data-fixture-scores-mobile] {
            display: none !important;
          }

          .fixture-mobile-only {
            display: none !important;
          }
        }

        @media (max-width: 767.98px) {
          [data-fixture-scores-desktop] {
            display: none !important;
          }

          .fixture-desktop-only {
            display: none !important;
          }
        }

        .fixture-match-card {
          border: 1px solid rgba(15, 23, 42, 0.10);
          border-radius: 14px;
          background: #ffffff;
          overflow: hidden;
          position: relative;
          box-shadow: 0 1px 0 rgba(15, 23, 42, 0.04);
          width: 100%;
        }

        .fixture-match-card:before {
          content: "";
          position: absolute;
          left: 0;
          top: 0;
          bottom: 0;
          width: 4px;
          background: rgba(22, 163, 74, 0.18);
        }

        .fixture-match-list > *:nth-child(even) .fixture-match-card {
          background: #f3f4f6;
        }

        .fixture-match-link {
          display: block;
          width: 100%;
        }

        .fixture-match-list > * {
          display: block;
          width: 100%;
        }

        .fixture-match-list > * + * {
          margin-top: 10px;
        }

        .fixture-match-card-header {
          padding: 10px 12px;
          background: #f3f5f7;
          border-bottom: 1px solid rgba(15, 23, 42, 0.07);
          font-size: 12px;
          color: #64748b;
          display: flex;
          justify-content: space-between;
          gap: 10px;
        }

        .fixture-match-list > *:nth-child(odd) .fixture-match-card-header {
          background: rgba(22, 163, 74, 0.10);
        }

        .fixture-match-list > *:nth-child(even) .fixture-match-card-header {
          background: rgba(59, 130, 246, 0.10);
        }

        .fixture-match-card-body {
          padding: 12px;
          min-height: 70px;
        }

        /* LiveScore style - teams stacked vertically */
        .fixture-teams-row {
          display: flex;
          flex-direction: column;
          gap: 0;
        }

        .fixture-team-row {
          display: flex;
          align-items: center;
          padding: 8px 0;
          border-bottom: 1px solid rgba(0,0,0,0.04);
        }

        .fixture-team-row:last-child {
          border-bottom: none;
        }

        .fixture-team-logo {
          width: 28px;
          height: 28px;
          border-radius: 999px;
          object-fit: cover;
          background: rgba(0,0,0,0.06);
          flex: 0 0 28px;
          margin-right: 10px;
        }

        .fixture-team-name {
          flex: 1;
          font-weight: 500;
          font-size: 14px;
          line-height: 1.2;
          color: #1e293b;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .fixture-team-score {
          font-weight: 700;
          font-size: 16px;
          color: #1e293b;
          min-width: 24px;
          text-align: right;
        }

        .fixture-team-score--winner {
          color: #16a34a;
        }

        .fixture-team-score-link {
          display: block;
        }

        .fixture-team-score-link:hover .fixture-team-score {
          background: #e2e8f0;
          border-radius: 4px;
        }

        /* Legacy styles for desktop */
        .fixture-team {
          min-width: 0;
          display: flex;
          align-items: center;
          gap: 8px;
        }

        .fixture-team--away {
          justify-content: flex-end;
          text-align: right;
        }

        .fixture-logo {
          width: 34px;
          height: 34px;
          border-radius: 999px;
          object-fit: cover;
          background: rgba(0,0,0,0.06);
          flex: 0 0 auto;
        }

        .fixture-score {
          text-align: center;
        }

        .fixture-score-main {
          font-weight: 400;
          font-size: 15px;
          letter-spacing: 0;
        }

        .fixture-score-sub {
          font-size: 12px;
          color: #78909c;
          margin-top: 2px;
        }

        /* Date navigation arrows */
        .fixture-date-nav {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 12px;
          padding: 8px 0;
        }

        .fixture-date-nav-btn {
          width: 36px;
          height: 36px;
          border-radius: 50%;
          border: 1px solid #e2e8f0;
          background: #fff;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #64748b;
          cursor: pointer;
          transition: all 0.15s;
        }

        .fixture-date-nav-btn:hover {
          background: #f1f5f9;
          color: #1e293b;
        }

        .fixture-date-nav-btn:disabled {
          opacity: 0.4;
          cursor: not-allowed;
        }

        .fixture-date-label {
          font-weight: 600;
          font-size: 15px;
          color: #1e293b;
          min-width: 120px;
          text-align: center;
        }

        .fixture-meta {
          margin-top: 10px;
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
          font-size: 12px;
          color: #546e7a;
        }

        .fixture-pill {
          padding: 4px 8px;
          border-radius: 999px;
          background: rgba(0,0,0,0.04);
          border: 1px solid rgba(0,0,0,0.05);
          white-space: nowrap;
        }

        .fixture-admin-controls {
          margin-top: 10px;
          display: grid;
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .fixture-admin-score {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 6px;
        }

        .fixture-filter-row {
          display: flex;
          align-items: flex-end;
          gap: 8px;
          flex-wrap: wrap;
          width: 100%;
        }

        @media (min-width: 768px) {
          .fixture-filter-row {
            width: auto;
            flex: 1 1 auto;
          }

          .fixture-export-wrap {
            flex: 0 0 auto;
          }
        }
      </style>

      <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center justify-content-between" style="gap:10px;">
          <div class="fw-bold">Match Day</div>
          <div class="d-flex align-items-center" style="gap:8px;">
            <span title="เลือกวันแข่งขัน" data-bs-toggle="tooltip" data-bs-placement="top" style="display:inline-block;">
              <button type="button"
                      class="btn btn-sm btn-outline-secondary"
                      data-bs-toggle="modal"
                      data-bs-target="#fixtureDayModal"
                      aria-label="เลือกวันแข่งขัน"
                      style="line-height:1;padding:6px 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm0 4H5a1 1 0 0 0-1 1v2h16V7a1 1 0 0 0-1-1h-2v1a1 1 0 1 1-2 0V6H8v1a1 1 0 1 1-2 0V6Zm13 5H4v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8Z" fill="currentColor"/>
                </svg>
              </button>
            </span>

            <% if can_manage_registrations?(@tournament) %>
              <%= link_to manage_schedule_tournament_path(@tournament), class: "btn btn-sm btn-outline-primary", title: "จัดการตารางแข่ง", style: "line-height:1;padding:6px 10px;" do %>
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false" style="margin-right:4px;">
                  <path d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.06 7.06 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 13.9 1h-3.8a.5.5 0 0 0-.49.42l-.36 2.54c-.58.23-1.12.54-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 7.48a.5.5 0 0 0 .12.64l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L2.83 14.52a.5.5 0 0 0-.12.64l1.92 3.32c.13.22.39.3.6.22l2.39-.96c.5.4 1.05.71 1.63.94l.36 2.54c.04.24.25.42.49.42h3.8c.24 0 .45-.18.49-.42l.36-2.54c.58-.23 1.12-.54 1.63-.94l2.39.96c.22.09.47 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"/>
                </svg>
                จัดโปรแกรม/ใส่สกอร์
              <% end %>
            <% end %>

            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#fixtureDownloadModal" title="ดาวน์โหลดรูปแข่ง" aria-label="ดาวน์โหลดรูปแข่ง" style="line-height:1;padding:6px 8px;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="card-body" style="background:#f3f4f6;">
          <% days = (@available_days || []).sort %>
          
          <div class="mb-2" style="font-size:12px;color:#78909c;">
            <% if @selected_day.present? %>
              วันที่: <%= @selected_day.strftime("%d/%m/%Y") %><%= "(#{@next_day_matches_total}คู่)" if @next_day_matches_total > 0 %>
              <% if days.size > 1 %>
                <button type="button" class="btn btn-sm btn-outline-secondary ms-2" data-bs-toggle="modal" data-bs-target="#fixtureDayModal" style="font-size:11px;padding:2px 8px;">
                  เปลี่ยนวัน
                </button>
              <% end %>
            <% else %>
              -
            <% end %>
          </div>

          <% pitches = Array(@available_pitches).map(&:to_i).uniq.select { |p| p >= 1 && p <= 6 }.sort %>
          <% if pitches.size > 1 %>
            <div class="mb-2" style="display:flex;gap:6px;flex-wrap:wrap;">
              <% selected_pitch = (@selected_pitch.presence || pitches.first).to_i %>
              <% pitches.each do |p| %>
                <% active = p == selected_pitch %>
                <%= link_to "สนาม #{p}",
                            fixture_tournament_path(@tournament,
                              day: (@selected_day&.strftime('%Y-%m-%d') || params[:day]),
                              pitch: p,
                              mine: (params[:mine].presence)),
                            class: "btn btn-sm #{active ? 'btn-success' : 'btn-outline-success'}",
                            style: "line-height:1;padding:6px 10px;" %>
              <% end %>
            </div>
          <% end %>

          <div class="modal fade" id="fixtureDayModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <div class="fw-bold">เลือกวันที่</div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height:60vh;overflow:auto;">
                  <% days = (@available_days || []) %>
                  <% if days.any? %>
                    <div class="list-group">
                      <% days.each do |d| %>
                        <% is_active = @selected_day.present? && d == @selected_day %>
                        <%= link_to fixture_tournament_path(@tournament, day: d.strftime("%Y-%m-%d"), pitch: (@selected_pitch.presence || Array(@available_pitches).first || 1)),
                                    class: "list-group-item list-group-item-action #{'active' if is_active}",
                                    style: "font-size:14px;" do %>
                          <%= d.strftime("%d/%m/%Y") %>
                        <% end %>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-muted" style="font-size:13px;">ยังไม่มีวันแข่งขันในระบบ</div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="fixtureDownloadModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                  <div class="fw-bold">ดาวน์โหลดรูปตารางแข่ง</div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding:0;">
                  <div class="p-3 border-bottom" style="background:#f8f9fa;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap" style="gap:12px;">
                      <div class="d-flex align-items-center" style="gap:12px;">
                        <div>
                          <label class="form-label mb-1" style="font-size:11px;color:#6b7280;">คู่/หน้า</label>
                          <select id="download-per-page" class="form-select form-select-sm" style="width:auto;min-width:80px;">
                            <% [5, 10, 15, 20, 25, 30].each do |n| %>
                              <option value="<%= n %>" <%= 'selected' if n == 10 %>><%= n %></option>
                            <% end %>
                            <option value="<%= @next_day_matches_total %>">ทั้งหมด</option>
                          </select>
                        </div>
                        <div id="download-page-selector">
                          <label class="form-label mb-1" style="font-size:11px;color:#6b7280;">หน้า</label>
                          <div id="download-page-buttons" style="display:flex;gap:4px;flex-wrap:wrap;"></div>
                        </div>
                      </div>
                      <div class="text-muted" style="font-size:12px;">
                        <%= @selected_day&.strftime("%d/%m/%Y") %> · ทั้งหมด <%= @next_day_matches_total %> คู่
                      </div>
                    </div>
                  </div>
                  
                  <div id="download-preview-container" style="max-height:50vh;overflow:auto;">
                    <div id="download-preview-capture" style="background:#fff;padding:16px;width:700px;min-width:700px;border:2px solid #e2e8f0;border-radius:8px;">
                      <table class="table table-sm align-middle mb-0" style="font-size:14px;width:100%;">
                        <thead style="background:#f1f5f9;">
                          <tr>
                            <th style="white-space:nowrap;padding:8px 4px;width:30px;font-size:11px;">คู่ที่</th>
                            <th style="white-space:nowrap;padding:8px 4px;width:50px;font-size:11px;">วัน/เวลา</th>
                            <th style="white-space:nowrap;padding:8px 4px;width:30px;font-size:11px;">รุ่น</th>
                            <th style="white-space:nowrap;padding:8px 4px;width:50px;font-size:11px;">สาย/รอบ</th>
                            <th style="padding:8px 8px;min-width:140px;">ทีมเหย้า</th>
                            <th style="padding:8px 8px;min-width:140px;">ทีมเยือน</th>
                            <th style="white-space:nowrap;text-align:center;padding:8px 4px;width:45px;font-size:11px;">สกอร์</th>
                          </tr>
                        </thead>
                        <tbody id="download-preview-body">
                          <% @next_day_matches_page.each_with_index do |match, idx| %>
                            <% group_name = match.group&.name.to_s.presence %>
                            <% round_title = if match.knockout?
                                               case match.round_label
                                               when "SF" then "รอบ 4 ทีม"
                                               when "QF" then "รอบ 8 ทีม"
                                               when "R16" then "รอบ 16 ทีม"
                                               when "FINAL" then "ชิงชนะเลิศ"
                                               when "3RD" then "ชิงที่ 3"
                                               else match.round_label
