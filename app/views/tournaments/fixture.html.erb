                                                .map(&:id) %>

                  <div class="fw-bold" style="font-size:13px;">1) กำหนดคิวเตะ (เรียงตามที่คลิก)</div>
                  <div class="text-muted" style="font-size:12px;margin-top:4px;">คลิกคู่ด้านล่างเพื่อเพิ่มเข้าคิว หากต้องการตั้งเวลาต่างกันในแต่ละชุด ให้กดปุ่ม "เพิ่มชุดนี้ & ตั้งค่าชุดถัดไป"</div>

                  <div id="bulk-schedule-root" data-preselected-ids="<%= preselected_ids.join(',') %>">
                    <div class="d-flex align-items-center justify-content-between" style="gap:10px;">
                      <div class="fw-bold" style="font-size:12px;">คิวชุดปัจจุบัน</div>
                      <button type="button" class="btn btn-sm btn-outline-danger" id="bulk-schedule-clear">Clear</button>
                    </div>

                    <div id="bulk-schedule-queue" style="margin-top:8px;border:1px solid #e5e7eb;border-radius:10px;padding:8px;min-height:52px;background:#fafafa;"></div>
                    <div id="bulk-schedule-hidden-inputs"></div>

                    <div class="mt-3 fw-bold" style="font-size:12px;">2) รายการคู่ทั้งหมด (คลิกเพื่อเพิ่มเข้าคิว)</div>
                    <div style="max-height:38vh;overflow:auto;border:1px solid #e5e7eb;border-radius:10px;padding:10px;margin-top:8px;">
                      <% divisions.each do |div| %>
                        <% div_matches = all_matches.select { |m| m.tournament_division_id == div.id } %>
                        <% next if div_matches.empty? %>
                        <div class="fw-bold" style="font-size:12px;margin:8px 0 6px 0;">รุ่น <%= div.name %></div>
                        <% div_matches.each do |m| %>
                          <% label_time = m.kickoff_at.present? ? m.kickoff_at.strftime("%d/%m %H:%M") : "ยังไม่ได้กำหนด" %>
                          <% kickoff_iso = m.kickoff_at&.iso8601 %>
                          <% group_name = m.group&.name.to_s.presence %>
                          <% if group_name.blank? && !m.knockout? %>
                            <% slot = m.home_slot_label.to_s.presence || m.away_slot_label.to_s.presence || "" %>
                            <% inferred = if slot.match?(/\A\d+[A-Za-z]\z/)
                                           slot[-1]
                                         elsif slot.match?(/\A[A-Za-z]\d+\z/)
                                           slot[0]
                                         end %>
                            <% group_name = inferred.to_s.upcase.presence %>
                          <% end %>
                          <% round_code = m.round_label.to_s.presence %>
                          <% round_title = if round_code.present? && m.knockout?
                                             case round_code
                                             when "SF" then "รอบ 4 ทีม"
                                             when "QF" then "รอบ 8 ทีม"
                                             when "R16" then "รอบ 16 ทีม"
                                             when "R32" then "รอบ 32 ทีม"
                                             when "R64" then "รอบ 64 ทีม"
                                             when "FINAL" then "รอบชิงชนะเลิศ"
                                             when "3RD" then "ชิงอันดับ 3"
                                             else "รอบน็อคเอาท์"
                                             end
                                           else
                                             nil
                                           end %>
                          <% group_label = m.knockout? ? round_title : (group_name.present? ? "สาย #{group_name}" : nil) %>
                          <% division_label = div.name.to_s.presence ? "รุ่น #{div.name}" : nil %>
                          <% data_label = [division_label, group_label, [m.home_name, "vs", m.away_name].join(' ')].compact.join(" · ") %>
                          <% team_text = [m.home_name, m.away_name].join(" ") %>
                          <button type="button"
                                  class="btn btn-sm w-100 text-start"
                                  data-bulk-match="1"
                                  data-match-id="<%= m.id %>"
                                  data-kickoff-at="<%= kickoff_iso %>"
                                  data-label="<%= data_label %>"
                                  data-fixture-team-text="<%= team_text.downcase %>"
                                  style="border:1px solid #e5e7eb;border-radius:10px;padding:8px 10px;margin-bottom:8px;background:#ffffff;">
                            <div class="d-flex justify-content-between" style="gap:10px;">
                              <div style="font-size:12px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                <span class="text-muted">(<%= label_time %>)</span>
                              </div>
                              <div class="text-muted" style="font-size:12px;white-space:nowrap;">+ เพิ่ม</div>
                            </div>
                            <div style="font-size:12px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                              <span class="text-muted">(รุ่น <%= div.name %>)</span>
                              <% if group_label.present? %>
                                <span class="text-muted">(<%= group_label %>)</span>
                              <% end %>
                              <%= m.home_name %> vs <%= m.away_name %>
                            </div>
                          </button>
                        <% end %>
                      <% end %>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end" style="gap:8px;margin-top:12px;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <%= submit_tag "บันทึกเวลา", class: "btn btn-primary" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  (function() {
    function normalizeText(v) {
      return (v || "").toString().trim().toLowerCase();
    }

    function applyFixtureTeamFilter() {
      var input = document.getElementById("fixture-team-search");
      if (!input) return;
      var q = normalizeText(input.value);

      var mobileLinks = document.querySelectorAll("a.fixture-match-link[data-fixture-team-text]");
      var desktopRows = document.querySelectorAll("tr[data-fixture-team-text]");

      var total = mobileLinks.length + desktopRows.length;
      var visible = 0;

      mobileLinks.forEach(function(a) {
        var t = normalizeText(a.getAttribute("data-fixture-team-text"));
        var show = !q || (t && t.indexOf(q) !== -1);
        a.style.display = show ? "block" : "none";
        if (show) visible += 1;
      });

      desktopRows.forEach(function(tr) {
        var t = normalizeText(tr.getAttribute("data-fixture-team-text"));
        var show = !q || (t && t.indexOf(q) !== -1);
        tr.style.display = show ? "" : "none";
        if (show) visible += 1;
      });

      var counter = document.getElementById("fixture-search-count");
      if (counter) {
        if (!q) {
          counter.textContent = "";
        } else {
          counter.textContent = visible + "/" + total;
        }
      }
    }

    function bindFixtureTeamSearch() {
      var input = document.getElementById("fixture-team-search");
      if (!input) return;
      if (input.dataset.bound === "1") return;
      input.dataset.bound = "1";
      input.addEventListener("input", applyFixtureTeamFilter);
      applyFixtureTeamFilter();
    }

    document.addEventListener("turbo:load", bindFixtureTeamSearch);
    document.addEventListener("DOMContentLoaded", bindFixtureTeamSearch);
  })();
</script>
