                              <div class="fixture-match-card" data-match-href="<%= match_tournament_path(@tournament, match_id: match.id) %>">
                                <div class="fixture-match-card-header">
                                  <div>คู่ที่ <%= (match.position.presence || (idx + 1)) %></div>
                                  <div style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
                                    <span><%= match.kickoff_at.present? ? match.kickoff_at.strftime("%d/%m/%Y %H:%M") : "ยังไม่ได้กำหนด" %></span>
                                  </div>
                                </div>
                                <div class="fixture-match-card-body">
                                  <div class="fixture-teams-row">
                                    <div class="fixture-team">
                                      <% if match.home_team&.logo&.attached? %>
                                        <%= image_tag match.home_team.logo, class: "fixture-logo" %>
                                      <% else %>
                                        <div class="fixture-logo"></div>
                                      <% end %>
                                      <div class="fixture-team-name"><%= match.home_name %></div>
                                    </div>

                                    <div class="fixture-score">
                                      <% if match.home_score.present? && match.away_score.present? %>
                                        <div class="fixture-score-main"><%= match.home_score %> - <%= match.away_score %></div>
                                      <% else %>
                                        <div class="fixture-score-main">VS</div>
                                      <% end %>
                                    </div>

                                    <div class="fixture-team fixture-team--away">
                                      <div class="fixture-team-name"><%= match.away_name %></div>
                                      <% if match.away_team&.logo&.attached? %>
                                        <%= image_tag match.away_team.logo, class: "fixture-logo" %>
                                      <% else %>
                                        <div class="fixture-logo"></div>
                                      <% end %>
                                    </div>
                                  </div>

                                  <div class="fixture-admin-controls">
                                    <div>
                                      <label class="form-label" style="font-size:12px;margin-bottom:4px;">วันเวลา</label>
                                      <%= datetime_field_tag "matches[#{match.id}][kickoff_at]",
                                            (match.kickoff_at&.strftime("%Y-%m-%dT%H:%M")),
                                            class: "form-control form-control-sm",
                                            placeholder: "ยังไม่ได้กำหนด" %>
                                    </div>

                                    <div>
                                      <label class="form-label" style="font-size:12px;margin-bottom:4px;">สกอร์</label>
                                      <div class="fixture-admin-score">
                                        <%= select_tag "matches[#{match.id}][home_score]",
