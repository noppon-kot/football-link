                                    <strong><%= match.penalty_winner_side == "home" ? "*#{hs}" : hs %> - <%= match.penalty_winner_side == "away" ? "*#{as}" : as %></strong>
                                  <% else %>
                                    <strong><%= hs %> - <%= as %></strong>
                                  <% end %>
                                <% else %>
                                  -
