                                           when "R16" then "รอบ 16 ทีม"
                                           when "R32" then "รอบ 32 ทีม"
                                           when "R64" then "รอบ 64 ทีม"
                                           when "FINAL" then "รอบชิงชนะเลิศ"
                                           when "3RD" then "ชิงอันดับ 3"
