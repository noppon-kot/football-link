                            <div class="fixture-team-logo"></div>
                          <% end %>
                          <div class="fixture-team-name"><%= match.away_name %></div>
                          <%= link_to match_tournament_path(@tournament, match_id: match.id), class: "fixture-team-score-link", style: "text-decoration:none;" do %>
                            <div class="fixture-team-score <%= 'fixture-team-score--winner' if away_winner || pk_away_win %>">
                              <%= pk_away_win ? "*#{away_score}" : (has_score ? away_score : "-") %>
                            </div>
                          <% end %>
                        </div>
                      </div>

                    </div>
                  </div>
              <% end %>
            </div>

            <div class="table-responsive d-none d-md-block fixture-desktop-only">
