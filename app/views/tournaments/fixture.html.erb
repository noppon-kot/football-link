<div class="app-shell">
  <% day_has_result = @next_day_matches_page.any? { |m| m.home_score.present? && m.away_score.present? } %>
  <% share_title = day_has_result ? "ผลการแข่งขัน" : "MATCH DAY" %>
  <% theme_primary = day_has_result ? "#0a1b3a" : "#063a2a" %>
  <% theme_secondary = day_has_result ? "#0b2a4f" : "#0b4a33" %>
  <% title_accent = day_has_result ? "#8ecbff" : "#d7ff59" %>
  <% label_accent = day_has_result ? "rgba(142,203,255,0.95)" : "rgba(215,255,89,0.95)" %>

  <% share_count = (@next_day_matches_page || []).size %>
  <% share_base_height = 1350 %>
  <% share_extra_matches = share_count > 6 ? (share_count - 6) : 0 %>
  <% share_footer_buffer = 180 %>
  <% share_card_height = share_base_height + (share_extra_matches * 220) + share_footer_buffer %>

  <div id="fixture-share-card" style="position:fixed;left:-10000px;top:0;width:1080px;height:<%= share_card_height %>px;overflow:hidden;">
    <div data-theme-root style="position:relative;width:1080px;height:<%= share_card_height %>px;background:#071b14;">
      <div style="position:absolute;inset:0;background-image:url('<%= asset_path("banner2.png") %>');background-size:cover;background-position:center;filter:brightness(0.45);"></div>
      <div data-theme-gradient style="position:absolute;inset:0;background:linear-gradient(135deg, <%= theme_primary %>e0 0%, <%= theme_secondary %>c7 45%, <%= theme_primary %>e0 100%);"></div>

      <div style="position:absolute;left:80px;right:80px;top:48px;display:flex;justify-content:space-between;align-items:flex-start;gap:18px;">
        <div>
          <div data-theme-title style="font-size:50px;font-weight:900;letter-spacing:0.4px;line-height:1.05;color:<%= title_accent %>;text-transform:uppercase;">
            <%= @tournament.title %>
          </div>
          <div style="margin-top:12px;font-size:30px;font-weight:900;color:rgba(255,255,255,0.92);letter-spacing:0.8px;">
            <%= share_title %>
          </div>
          <div style="margin-top:8px;font-size:18px;color:rgba(255,255,255,0.88);">
            <%= @selected_day.present? ? @selected_day.strftime("%d/%m/%Y") : "-" %>
            <% if @tournament.location_name.present? %>
              · <%= @tournament.location_name %>
            <% end %>
          </div>
        </div>
      </div>

      <div style="position:absolute;left:80px;right:80px;top:250px;bottom:170px;background:rgba(10,18,36,0.70);border:1px solid rgba(255,255,255,0.14);border-radius:18px;overflow:hidden;">
        <div style="padding:14px 16px;">
          <% if @next_day_matches_page.any? %>
            <% @next_day_matches_page.each do |match| %>
              <div style="padding:16px 24px 14px 24px;border:1px solid rgba(255,255,255,0.16);border-radius:16px;background:rgba(0,0,0,0.18);margin-bottom:10px;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                  <div style="font-size:21px;font-weight:900;color:#ffffff;">
                    <%= match.kickoff_at.present? ? match.kickoff_at.strftime("%H:%M") : "-" %>
                  </div>
                  <div style="font-size:15px;font-weight:800;color:rgba(255,255,255,0.88);">
                    <% if match.tournament_division&.name.present? %>
                      รุ่น <%= match.tournament_division.name %>
                    <% end %>
                  </div>
                </div>

                <div style="margin-top:10px;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 10px;">
                  <div style="flex:1;min-width:0;">
                    <div data-theme-label style="font-size:16px;font-weight:900;color:<%= label_accent %>;margin-bottom:6px;">ทีมเหย้า</div>
                    <div style="display:flex;align-items:center;gap:10px;">
                      <% if match.home_team&.logo&.attached? %>
                        <%= image_tag match.home_team.logo, style: "width:56px;height:56px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,0.12);", crossorigin: "anonymous" %>
                      <% else %>
                        <div style="width:56px;height:56px;border-radius:999px;background:rgba(255,255,255,0.12);"></div>
                      <% end %>
                      <div style="font-size:32px;font-weight:900;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        <%= match.home_name %>
                      </div>
                    </div>
                  </div>

                  <div style="flex:0 0 auto;text-align:center;">
                    <div style="font-size:26px;font-weight:900;color:rgba(255,255,255,0.86);letter-spacing:1.2px;">VS</div>
                    <% if match.home_score.present? && match.away_score.present? %>
                      <div style="margin-top:4px;font-size:20px;font-weight:900;color:#ffffff;letter-spacing:0.4px;">
                        <%= match.home_score %> - <%= match.away_score %>
                      </div>
                    <% end %>
                  </div>

                  <div style="flex:1;min-width:0;">
                    <div data-theme-label style="font-size:16px;font-weight:900;color:<%= label_accent %>;margin-bottom:6px;text-align:right;">ทีมเยือน</div>
                    <div style="display:flex;align-items:center;gap:10px;justify-content:flex-end;">
                      <div style="font-size:32px;font-weight:900;color:#ffffff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                        <%= match.away_name %>
                      </div>
                      <% if match.away_team&.logo&.attached? %>
                        <%= image_tag match.away_team.logo, style: "width:56px;height:56px;border-radius:999px;object-fit:cover;background:rgba(255,255,255,0.12);", crossorigin: "anonymous" %>
                      <% else %>
                        <div style="width:56px;height:56px;border-radius:999px;background:rgba(255,255,255,0.12);"></div>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div style="padding:26px 0;color:rgba(255,255,255,0.85);font-size:18px;font-weight:700;">ยังไม่มีข้อมูลสำหรับวันที่นี้</div>
          <% end %>
        </div>
      </div>

      <div style="position:absolute;left:80px;right:80px;bottom:48px;display:flex;justify-content:flex-end;">
        <div style="display:flex;align-items:center;gap:10px;color:rgba(255,255,255,0.92);border:1px solid rgba(255,255,255,0.18);background:rgba(255,255,255,0.08);padding:10px 14px;border-radius:14px;white-space:nowrap;">
          <%= image_tag "dernsai_icon.png", alt: "DERNSAI", style: "width:28px;height:28px;border-radius:8px;object-fit:contain;background:rgba(255,255,255,0.08);padding:4px;", crossorigin: "anonymous" %>
          <span style="font-size:14px;font-weight:800;letter-spacing:0.6px;">DERNSAI.com</span>
        </div>
      </div>

    </div>
  </div>

  <div class="tournament-show-body">
    <div class="container py-2 fixture-page-wrap">
      <style>
        .fixture-page-wrap {
          background: #f6f7f9;
          border-radius: 14px;
          padding: 10px 10px 14px 10px;
        }

        @media (min-width: 768px) {
          [data-fixture-scores-mobile] {
            display: none !important;
          }

          .fixture-mobile-only {
            display: none !important;
          }
        }

        @media (max-width: 767.98px) {
          [data-fixture-scores-desktop] {
            display: none !important;
          }

          .fixture-desktop-only {
            display: none !important;
          }
        }

        .fixture-match-card {
          border: 1px solid rgba(15, 23, 42, 0.10);
          border-radius: 14px;
          background: #ffffff;
          overflow: hidden;
          position: relative;
          box-shadow: 0 1px 0 rgba(15, 23, 42, 0.04);
          width: 100%;
        }

        .fixture-match-card:before {
          content: "";
          position: absolute;
          left: 0;
          top: 0;
          bottom: 0;
          width: 4px;
          background: rgba(22, 163, 74, 0.18);
        }

        .fixture-match-list > *:nth-child(even) .fixture-match-card {
          background: #f3f4f6;
        }

        .fixture-match-link {
          display: block;
          width: 100%;
        }

        .fixture-match-list > * {
          display: block;
          width: 100%;
        }

        .fixture-match-list > * + * {
          margin-top: 10px;
        }

        .fixture-match-card-header {
          padding: 10px 12px;
          background: #f3f5f7;
          border-bottom: 1px solid rgba(15, 23, 42, 0.07);
          font-size: 12px;
          color: #64748b;
          display: flex;
          justify-content: space-between;
          gap: 10px;
        }

        .fixture-match-list > *:nth-child(odd) .fixture-match-card-header {
          background: rgba(22, 163, 74, 0.10);
        }

        .fixture-match-list > *:nth-child(even) .fixture-match-card-header {
          background: rgba(59, 130, 246, 0.10);
        }

        .fixture-match-card-body {
          padding: 12px;
          min-height: 70px;
        }

        .fixture-teams-row {
          display: grid;
          grid-template-columns: 1fr 72px 1fr;
          align-items: center;
          gap: 10px;
          min-height: 44px;
        }

        .fixture-team {
          min-width: 0;
          display: flex;
          align-items: center;
          gap: 8px;
        }

        .fixture-team--away {
          justify-content: flex-end;
          text-align: right;
        }

        .fixture-team-name {
          font-weight: 400;
          font-size: 15px;
          line-height: 1.15;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
        }

        .fixture-logo {
          width: 34px;
          height: 34px;
          border-radius: 999px;
          object-fit: cover;
          background: rgba(0,0,0,0.06);
          flex: 0 0 auto;
        }

        .fixture-score {
          text-align: center;
        }

        .fixture-score-main {
          font-weight: 400;
          font-size: 15px;
          letter-spacing: 0;
        }

        .fixture-score-sub {
          font-size: 12px;
          color: #78909c;
          margin-top: 2px;
        }

        .fixture-meta {
          margin-top: 10px;
          display: flex;
          flex-wrap: wrap;
          gap: 6px;
          font-size: 12px;
          color: #546e7a;
        }

        .fixture-pill {
          padding: 4px 8px;
          border-radius: 999px;
          background: rgba(0,0,0,0.04);
          border: 1px solid rgba(0,0,0,0.05);
          white-space: nowrap;
        }

        .fixture-admin-controls {
          margin-top: 10px;
          display: grid;
          grid-template-columns: 1fr;
          gap: 8px;
        }

        .fixture-admin-score {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 6px;
        }

        .fixture-filter-row {
          display: flex;
          align-items: flex-end;
          gap: 8px;
          flex-wrap: wrap;
          width: 100%;
        }

        @media (min-width: 768px) {
          .fixture-filter-row {
            width: auto;
            flex: 1 1 auto;
          }

          .fixture-export-wrap {
            flex: 0 0 auto;
          }
        }
      </style>

      <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center justify-content-between" style="gap:10px;">
          <div class="fw-bold">Match Day</div>
          <div class="d-flex align-items-center" style="gap:8px;">
            <span title="เลือกวันแข่งขัน" data-bs-toggle="tooltip" data-bs-placement="top" style="display:inline-block;">
              <button type="button"
                      class="btn btn-sm btn-outline-secondary"
                      data-bs-toggle="modal"
                      data-bs-target="#fixtureDayModal"
                      aria-label="เลือกวันแข่งขัน"
                      style="line-height:1;padding:6px 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H5a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm0 4H5a1 1 0 0 0-1 1v2h16V7a1 1 0 0 0-1-1h-2v1a1 1 0 1 1-2 0V6H8v1a1 1 0 1 1-2 0V6Zm13 5H4v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-8Z" fill="currentColor"/>
                </svg>
              </button>
            </span>

            <button type="button" id="fixture-export" class="btn btn-sm btn-success" title="ดาวน์โหลดรูปแข่งหน้านี้" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="ดาวน์โหลดรูปแข่งหน้านี้" style="line-height:1;padding:6px 8px;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="card-body">
          <div class="mb-2" style="font-size:12px;color:#78909c;">
            วันที่: <%= @selected_day.present? ? @selected_day.strftime("%d/%m/%Y") : "-" %>
          </div>

          <div class="modal fade" id="fixtureDayModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <div class="fw-bold">เลือกวันที่</div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="max-height:60vh;overflow:auto;">
                  <% days = (@available_days || []) %>
                  <% if days.any? %>
                    <div class="list-group">
                      <% days.each do |d| %>
                        <% is_active = @selected_day.present? && d == @selected_day %>
                        <%= link_to fixture_tournament_path(@tournament, day: d.strftime("%Y-%m-%d")),
                                    class: "list-group-item list-group-item-action #{'active' if is_active}",
                                    style: "font-size:14px;" do %>
                          <%= d.strftime("%d/%m/%Y") %>
                        <% end %>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-muted" style="font-size:13px;">ยังไม่มีวันแข่งขันในระบบ</div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <div id="next-match-capture">
            <% if @next_match_day.present? && @next_day_matches_total.positive? %>
            <div class="d-block d-md-none fixture-match-list fixture-mobile-only">
              <% @next_day_matches_page.each_with_index do |match, idx| %>
                <% match_no = ((@day_page - 1) * @day_per_page) + idx + 1 %>
                <% group_name = match.group&.name.to_s.presence %>
                <% if group_name.blank? && !match.knockout? %>
                  <% slot = match.home_slot_label.to_s.presence || match.away_slot_label.to_s.presence || "" %>
                  <% inferred = if slot.match?(/\A\d+[A-Za-z]\z/)
                                 slot[-1]
                               elsif slot.match?(/\A[A-Za-z]\d+\z/)
                                 slot[0]
                               end %>
                  <% group_name = inferred.to_s.upcase.presence %>
                <% end %>
                <% round_code = match.round_label.to_s.presence %>
                <% round_title = if round_code.present? && match.knockout?
                                   case round_code
                                   when "SF" then "รอบ 4 ทีม"
                                   when "QF" then "รอบ 8 ทีม"
                                   when "R16" then "รอบ 16 ทีม"
                                   when "R32" then "รอบ 32 ทีม"
                                   when "R64" then "รอบ 64 ทีม"
                                   when "FINAL" then "รอบชิงชนะเลิศ"
                                   when "3RD" then "ชิงอันดับ 3"
                                   else "รอบน็อคเอาท์"
                                   end
                                 else
                                   round_code
                                 end %>
                <% group_or_round = group_name.presence || round_title.presence || "-" %>

                <%= link_to match_tournament_path(@tournament, match_id: match.id), class: "fixture-match-link", style: "text-decoration:none;color:inherit;" do %>
                  <div class="fixture-match-card">
                    <div class="fixture-match-card-header">
                      <div style="min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">คู่ที่ <%= match_no %> · <%= match.tournament_division&.name || "-" %></div>
                      <div style="white-space:nowrap;">
                        <%= match.kickoff_at.present? ? match.kickoff_at.strftime("%H:%M") : "-" %>
                        <span style="color:#78909c;">· <%= group_or_round %></span>
                      </div>
                    </div>
                    <div class="fixture-match-card-body">
                      <div class="fixture-teams-row">
                        <div class="fixture-team">
                          <% if match.home_team&.logo&.attached? %>
                            <%= image_tag match.home_team.logo, class: "fixture-logo" %>
                          <% else %>
                            <div class="fixture-logo"></div>
                          <% end %>
                          <div class="fixture-team-name"><%= match.home_name %></div>
                        </div>

                        <div class="fixture-score">
                          <% if match.home_score.present? && match.away_score.present? %>
                            <div class="fixture-score-main"><%= match.home_score %> - <%= match.away_score %></div>
                          <% else %>
                            <div class="fixture-score-main">VS</div>
                          <% end %>
                        </div>

                        <div class="fixture-team fixture-team--away">
                          <div class="fixture-team-name"><%= match.away_name %></div>
                          <% if match.away_team&.logo&.attached? %>
                            <%= image_tag match.away_team.logo, class: "fixture-logo" %>
                          <% else %>
                            <div class="fixture-logo"></div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>

            <div class="table-responsive d-none d-md-block fixture-desktop-only">
              <table class="table table-sm align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th scope="col" class="text-center" style="width:60px;">คู่ที่</th>
                    <th scope="col" style="width:80px;">เวลา</th>
                    <th scope="col" style="width:120px;">รุ่น</th>
                    <th scope="col" class="text-start" style="width:90px;">สาย/รอบ</th>
                    <th scope="col" style="min-width:220px;">ทีมเหย้า</th>
                    <th scope="col" style="min-width:220px;">ทีมเยือน</th>
                    <th scope="col" class="text-end" style="width:120px;">สกอร์</th>
                  </tr>
                </thead>
                <tbody>
                  <% @next_day_matches_page.each_with_index do |match, idx| %>
                    <tr>
                      <td class="text-center" style="font-size:12px;white-space:nowrap;">
                        <%= link_to "คู่ที่ #{((@day_page - 1) * @day_per_page) + idx + 1}", match_tournament_path(@tournament, match_id: match.id), class: "text-decoration-none" %>
                      </td>
                      <td style="font-size:12px;white-space:nowrap;">
                        <%= match.kickoff_at.present? ? match.kickoff_at.strftime("%H:%M") : "-" %>
                      </td>
                      <td style="font-size:12px;white-space:nowrap;">
                        <%= match.tournament_division&.name || "-" %>
                      </td>
                      <td class="text-start" style="font-size:12px;white-space:nowrap;">
                        <% group_name = match.group&.name.to_s.presence %>
                        <% if group_name.blank? && !match.knockout? %>
                          <% slot = match.home_slot_label.to_s.presence || match.away_slot_label.to_s.presence || "" %>
                          <% inferred = if slot.match?(/\A\d+[A-Za-z]\z/)
                                         slot[-1]
                                       elsif slot.match?(/\A[A-Za-z]\d+\z/)
                                         slot[0]
                                       end %>
                          <% group_name = inferred.to_s.upcase.presence %>
                        <% end %>
                        <% round_code = match.round_label.to_s.presence %>
                        <% round_title = if round_code.present? && match.knockout?
                                           case round_code
                                           when "SF" then "รอบ 4 ทีม"
                                           when "QF" then "รอบ 8 ทีม"
                                           when "R16" then "รอบ 16 ทีม"
                                           when "R32" then "รอบ 32 ทีม"
                                           when "R64" then "รอบ 64 ทีม"
                                           when "FINAL" then "รอบชิงชนะเลิศ"
                                           when "3RD" then "ชิงอันดับ 3"
                                           else "รอบน็อคเอาท์"
                                           end
                                         else
                                           round_code
                                         end %>
                        <%= group_name.presence || round_title.presence || "-" %>
                      </td>
                      <td>
                        <div class="d-flex align-items-center" style="gap:6px;">
                          <% if match.home_team&.logo&.attached? %>
                            <%= image_tag match.home_team.logo,
                                          class: "rounded-circle",
                                          style: "width:24px;height:24px;object-fit:cover;" %>
                          <% end %>
                          <span style="font-weight:600;"><%= match.home_name %></span>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center" style="gap:6px;">
                          <% if match.away_team&.logo&.attached? %>
                            <%= image_tag match.away_team.logo,
                                          class: "rounded-circle",
                                          style: "width:24px;height:24px;object-fit:cover;" %>
                          <% end %>
                          <span style="font-weight:600;"><%= match.away_name %></span>
                        </div>
                      </td>
                      <td class="text-end" style="font-size:12px;white-space:nowrap;">
                        <% if match.home_score.present? && match.away_score.present? %>
                          <%= match.home_score %> - <%= match.away_score %>
                        <% else %>
                          <span class="text-muted" style="font-size:12px;">-</span>
                        <% end %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            <% else %>
            <div class="text-muted" style="font-size:13px;">ยังไม่มีโปรแกรมการแข่งขันถัดไป (ตั้งแต่วันนี้เป็นต้นไป)</div>
            <% end %>
          </div>
        </div>
      </div>

      <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
      <script>
        (function() {
          function ensureModal() {
            var existing = document.getElementById('fixture-export-modal');
            if (existing) return existing;

            var modal = document.createElement('div');
            modal.id = 'fixture-export-modal';
            modal.style.display = 'none';
            modal.style.position = 'fixed';
            modal.style.inset = '0';
            modal.style.zIndex = '1055';
            modal.style.background = 'rgba(0,0,0,0.72)';
            modal.style.padding = '16px';
            modal.style.overflow = 'auto';

            modal.innerHTML = '' +
              '<div style="min-height:100%;display:flex;align-items:center;justify-content:center;">' +
              '  <div style="position:relative;max-width:min(1080px, 96vw);width:100%;">' +
              '    <div style="position:absolute;top:-10px;right:-10px;display:flex;gap:8px;">' +
              '      <button type="button" data-fixture-export-download title="Save" aria-label="Save" style="width:44px;height:44px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.55);color:#fff;line-height:1;display:flex;align-items:center;justify-content:center;">' +
              '        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">' +
              '          <path d="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7l-4-4Zm-5 18a3 3 0 1 1 0-6 3 3 0 0 1 0 6ZM6 8V5h9v3H6Z" fill="currentColor"/>' +
              '        </svg>' +
              '      </button>' +
              '      <button type="button" data-fixture-export-close style="width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.55);color:#fff;font-size:22px;line-height:1;">×</button>' +
              '    </div>' +
              '    <img data-fixture-export-modal-img alt="Matchday" style="width:100%;height:auto;border-radius:14px;display:block;background:#fff;" />' +
              '  </div>' +
              '</div>';

            document.body.appendChild(modal);

            modal.addEventListener('click', function(e) {
              if (e.target === modal) {
                modal.style.display = 'none';
              }
            });
            modal.querySelector('[data-fixture-export-close]').addEventListener('click', function() {
              modal.style.display = 'none';
            });

            modal.querySelector('[data-fixture-export-download]').addEventListener('click', function() {
              var img = modal.querySelector('[data-fixture-export-modal-img]');
              if (!img || !img.src) return;

              var filename = modal.getAttribute('data-filename') || 'fixture.png';
              if (img.src.indexOf('data:image') === 0) {
                var a = document.createElement('a');
                a.href = img.src;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
              } else {
                window.open(img.src, '_blank');
              }
            });

            document.addEventListener('keydown', function(e) {
              if (e.key === 'Escape') {
                modal.style.display = 'none';
              }
            });

            return modal;
          }

          function setModalImage(src) {
            var modal = ensureModal();
            var img = modal.querySelector('[data-fixture-export-modal-img]');
            img.src = src;
            var day = '<%= j(@selected_day&.strftime("%Y-%m-%d") || "") %>';
            var title = '<%= j(@tournament.title.to_s.gsub(" ", "_")) %>';
            var page = '<%= j(@day_page.to_s) %>';
            var filename = (title ? title : 'fixture') + (day ? ('_' + day) : '') + (page ? ('_p' + page) : '') + '.png';
            modal.setAttribute('data-filename', filename);
            modal.style.display = 'block';
          }

          function randomExportTheme() {
            var themes = [
              { name: 'green', primary: '#063a2a', secondary: '#0b4a33', title: '#d7ff59', label: 'rgba(215,255,89,0.95)' },
              { name: 'blue', primary: '#0a1b3a', secondary: '#0b2a4f', title: '#8ecbff', label: 'rgba(142,203,255,0.95)' },
              { name: 'purple', primary: '#2a1247', secondary: '#3b1a63', title: '#e0b3ff', label: 'rgba(224,179,255,0.95)' },
              { name: 'yellow', primary: '#3a2f00', secondary: '#5a4800', title: '#ffe066', label: 'rgba(255,224,102,0.95)' },
              { name: 'orange', primary: '#3a1f00', secondary: '#5a2e00', title: '#ffb347', label: 'rgba(255,179,71,0.95)' },
              { name: 'red', primary: '#3a0a12', secondary: '#5a1220', title: '#ff7b7b', label: 'rgba(255,123,123,0.95)' },
              { name: 'navy', primary: '#061226', secondary: '#0b1f3d', title: '#7fb3ff', label: 'rgba(127,179,255,0.95)' }
            ];
            return themes[Math.floor(Math.random() * themes.length)];
          }

          function applyExportTheme(targetEl) {
            if (!targetEl) return;
            var theme = randomExportTheme();
            var root = targetEl.querySelector('[data-theme-root]');
            var gradient = targetEl.querySelector('[data-theme-gradient]');
            var title = targetEl.querySelector('[data-theme-title]');
            var labels = targetEl.querySelectorAll('[data-theme-label]');

            if (root) root.style.background = theme.primary;
            if (gradient) gradient.style.background = 'linear-gradient(135deg, ' + theme.primary + 'e0 0%, ' + theme.secondary + 'c7 45%, ' + theme.primary + 'e0 100%)';
            if (title) title.style.color = theme.title;
            labels.forEach(function(el) { el.style.color = theme.label; });
          }

          async function exportCard(buttonEl, targetEl, filePrefix) {
            var oldText = buttonEl.innerText;
            try {
              buttonEl.disabled = true;
              showWaitOverlay();

              applyExportTheme(targetEl);

              var canvas = await html2canvas(targetEl, {
                backgroundColor: '#ffffff',
                scale: 2,
                useCORS: true
              });

              var dataUrl = canvas.toDataURL('image/png');
              setModalImage(dataUrl);
            } catch (err) {
              console.error(err);
              alert('สร้างรูปไม่สำเร็จ');
            } finally {
              buttonEl.disabled = false;
              if (oldText) buttonEl.innerText = oldText;
              hideWaitOverlay();
            }
          }

          function ensureWaitOverlay() {
            var el = document.getElementById('global-wait-overlay');
            if (el) return el;
            el = document.createElement('div');
            el.id = 'global-wait-overlay';
            el.style.display = 'none';
            el.style.position = 'fixed';
            el.style.inset = '0';
            el.style.zIndex = '2000';
            el.style.background = 'rgba(0,0,0,0.55)';
            el.style.alignItems = 'center';
            el.style.justifyContent = 'center';
            el.style.padding = '16px';
            el.innerHTML = '' +
              '<div style="background:#ffffff;border-radius:14px;padding:16px 18px;min-width:220px;max-width:92vw;box-shadow:0 12px 30px rgba(0,0,0,0.25);">' +
              '  <div class="d-flex align-items-center" style="gap:10px;">' +
              '    <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>' +
              '    <div style="font-weight:700;">กำลังประมวลผล...</div>' +
              '  </div>' +
              '  <div class="text-muted" style="font-size:12px;margin-top:6px;">กรุณารอสักครู่</div>' +
              '</div>';
            document.body.appendChild(el);
            return el;
          }

          function showWaitOverlay() {
            var el = ensureWaitOverlay();
            el.style.display = 'flex';
          }

          function hideWaitOverlay() {
            var el = document.getElementById('global-wait-overlay');
            if (el) el.style.display = 'none';
          }

          var btn = document.getElementById('fixture-export');
          var card = document.getElementById('fixture-share-card');
          if (btn && card) {
            btn.addEventListener('click', function() {
              var prefix = '<%= day_has_result ? "result" : "matchday" %>';
              exportCard(btn, card, prefix);
            });
          }

          function bindBulkScheduleWait() {
            var form = document.querySelector('#bulkScheduleModal form');
            if (!form || form.getAttribute('data-wait-bound') === '1') return;
            form.setAttribute('data-wait-bound', '1');
            form.addEventListener('submit', function() {
              showWaitOverlay();
            });
          }

          function initBulkScheduleQueue() {
            var root = document.getElementById('bulk-schedule-root');
            if (!root || root.getAttribute('data-queue-init') === '1') return;
            root.setAttribute('data-queue-init', '1');

            var modal = document.getElementById('bulkScheduleModal');
            var form = modal ? modal.querySelector('form') : null;
            var queueEl = document.getElementById('bulk-schedule-queue');
            var hiddenEl = document.getElementById('bulk-schedule-hidden-inputs');
            var clearBtn = document.getElementById('bulk-schedule-clear');
            if (!form || !queueEl || !hiddenEl) return;

            var scheduleDateInput = form.querySelector('input[name="schedule_date"]');
            var queue = [];

            function escapeHtml(str) {
              return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
            }

            function parseIsoDate(iso) {
              if (!iso) return null;
              var d = new Date(iso);
              return isNaN(d.getTime()) ? null : d;
            }

            function toYmd(dateObj) {
              if (!dateObj) return '';
              var y = dateObj.getFullYear();
              var m = String(dateObj.getMonth() + 1).padStart(2, '0');
              var d = String(dateObj.getDate()).padStart(2, '0');
              return y + '-' + m + '-' + d;
            }

            function render() {
              hiddenEl.innerHTML = '';
              if (!queue.length) {
                queueEl.innerHTML = '<div class="text-muted" style="font-size:12px;">ยังไม่ได้เลือกคู่ (คลิกจากรายการด้านล่างเพื่อเพิ่ม)</div>';
                syncAvailableMatchButtons();
                return;
              }

              queueEl.innerHTML = queue.map(function(item, idx) {
                var label = escapeHtml(item.label);
                return '' +
                  '<div draggable="true" data-queue-item="1" data-queue-id="' + item.id + '" class="d-flex align-items-center justify-content-between" style="gap:10px;padding:6px 6px;border-radius:8px;border:1px solid rgba(0,0,0,0.06);background:#ffffff;margin-bottom:6px;cursor:grab;">' +
                  '  <div style="font-size:12px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' +
                  '    <span style="font-weight:700;">' + (idx + 1) + '.</span> ' + label +
                  '  </div>' +
                  '  <button type="button" class="btn btn-sm btn-outline-secondary" data-queue-remove="' + item.id + '">ลบ</button>' +
                  '</div>';
              }).join('');

              queue.forEach(function(item) {
                var input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'match_ids[]';
                input.value = String(item.id);
                hiddenEl.appendChild(input);
              });

              syncAvailableMatchButtons();
            }

            function syncAvailableMatchButtons() {
              var queued = new Set(queue.map(function(x) { return String(x.id); }));
              document.querySelectorAll('[data-bulk-match="1"]').forEach(function(btn) {
                var id = btn.getAttribute('data-match-id');
                if (!id) return;
                btn.style.display = queued.has(String(id)) ? 'none' : '';
              });
            }

            function addToQueue(matchId, label) {
              matchId = parseInt(matchId, 10);
              if (!matchId) return;
              if (queue.some(function(x) { return x.id === matchId; })) return;
              queue.push({ id: matchId, label: label || ('#' + matchId) });
              render();
            }

            function removeFromQueue(matchId) {
              matchId = parseInt(matchId, 10);
              if (!matchId) return;
              queue = queue.filter(function(x) { return x.id !== matchId; });
              render();
            }

            function clearQueue() {
              queue = [];
              render();
            }

            var draggedId = null;

            function findQueueIndexById(id) {
              id = parseInt(id, 10);
              return queue.findIndex(function(x) { return x.id === id; });
            }

            function buildDefaultQueueForSelectedDate() {
              var selectedYmd = scheduleDateInput ? String(scheduleDateInput.value || '').trim() : '';
              if (!selectedYmd) {
                queue = [];
                render();
                return;
              }

              var matches = Array.prototype.slice.call(document.querySelectorAll('[data-bulk-match="1"]'));
              var dated = matches.map(function(btn) {
                var id = btn.getAttribute('data-match-id');
                var label = btn.getAttribute('data-label') || btn.innerText || ('#' + id);
                var kickoffIso = btn.getAttribute('data-kickoff-at');
                var kickoffDate = parseIsoDate(kickoffIso);
                return { id: parseInt(id, 10), label: label, kickoff: kickoffDate, kickoffYmd: toYmd(kickoffDate) };
              }).filter(function(m) {
                return m.id && m.kickoff && m.kickoffYmd === selectedYmd;
              });

              if (!dated.length) {
                queue = [];
                render();
                return;
              }
              dated.sort(function(a, b) {
                if (a.kickoff.getTime() !== b.kickoff.getTime()) return a.kickoff.getTime() - b.kickoff.getTime();
                return a.id - b.id;
              });

              queue = dated.map(function(m) {
                return { id: m.id, label: m.label };
              });
              render();
            }

            queueEl.addEventListener('dragstart', function(e) {
              var item = e.target.closest && e.target.closest('[data-queue-item="1"]');
              if (!item) return;
              draggedId = item.getAttribute('data-queue-id');
              try {
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', draggedId);
              } catch (err) {}
            });

            queueEl.addEventListener('dragover', function(e) {
              var item = e.target.closest && e.target.closest('[data-queue-item="1"]');
              if (!item) return;
              e.preventDefault();
              try { e.dataTransfer.dropEffect = 'move'; } catch (err) {}
            });

            queueEl.addEventListener('drop', function(e) {
              var item = e.target.closest && e.target.closest('[data-queue-item="1"]');
              if (!item) return;
              e.preventDefault();

              var targetId = item.getAttribute('data-queue-id');
              var fromId = draggedId;
              if (!fromId) {
                try { fromId = e.dataTransfer.getData('text/plain'); } catch (err) {}
              }
              if (!fromId || !targetId || fromId === targetId) return;

              var fromIdx = findQueueIndexById(fromId);
              var toIdx = findQueueIndexById(targetId);
              if (fromIdx < 0 || toIdx < 0) return;

              var moved = queue.splice(fromIdx, 1)[0];
              queue.splice(toIdx, 0, moved);
              draggedId = null;
              render();
            });

            document.addEventListener('click', function(e) {
              var btn = e.target.closest && e.target.closest('[data-bulk-match="1"]');
              if (btn) {
                addToQueue(btn.getAttribute('data-match-id'), btn.getAttribute('data-label'));
                return;
              }

              var removeBtn = e.target.closest && e.target.closest('[data-queue-remove]');
              if (removeBtn) {
                removeFromQueue(removeBtn.getAttribute('data-queue-remove'));
                return;
              }
            });

            if (clearBtn) {
              clearBtn.addEventListener('click', function() {
                clearQueue();
              });
            }

            if (scheduleDateInput) {
              var onScheduleDateChange = function() {
                buildDefaultQueueForSelectedDate();
              };
              scheduleDateInput.addEventListener('change', onScheduleDateChange);
              scheduleDateInput.addEventListener('input', onScheduleDateChange);
              scheduleDateInput.addEventListener('blur', onScheduleDateChange);
            }

            if (modal) {
              modal.addEventListener('shown.bs.modal', function() {
                buildDefaultQueueForSelectedDate();
              });
            }

            render();
          }

          document.addEventListener('turbo:load', bindBulkScheduleWait);
          document.addEventListener('DOMContentLoaded', bindBulkScheduleWait);
          document.addEventListener('turbo:load', initBulkScheduleQueue);
          document.addEventListener('DOMContentLoaded', initBulkScheduleQueue);
        })();
      </script>

      <script>
        (function() {
          if (window.__fixtureMatchCardNavInitialized) return;
          document.addEventListener('click', function(e) {
            var card = e.target.closest && e.target.closest('[data-match-href]');
            if (!card) return;
            if (e.target.closest('a, button, input, select, textarea, label')) return;
            var href = card.getAttribute('data-match-href');
            if (href) window.location.href = href;
          });
          window.__fixtureMatchCardNavInitialized = true;
        })();
      </script>

      <div class="card shadow-sm mb-3">
        <div class="card-header d-flex align-items-center justify-content-between" style="gap:10px;">
          <div class="fw-bold">All Match</div>
          <% if can_manage_registrations?(@tournament) %>
            <span title="ตั้งค่าเวลาแข่งแบบชุด" data-bs-toggle="tooltip" data-bs-placement="top" style="display:inline-block;">
              <button type="button"
                      class="btn btn-sm btn-outline-secondary"
                      data-bs-toggle="modal"
                      data-bs-target="#bulkScheduleModal"
                      aria-label="ตั้งค่าเวลาแข่งแบบชุด"
                      style="line-height:1;padding:6px 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
                  <path d="M19.14 12.94c.04-.31.06-.63.06-.94s-.02-.63-.06-.94l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.6-.22l-2.39.96a7.06 7.06 0 0 0-1.63-.94l-.36-2.54A.5.5 0 0 0 13.9 1h-3.8a.5.5 0 0 0-.49.42l-.36 2.54c-.58.23-1.12.54-1.63.94l-2.39-.96a.5.5 0 0 0-.6.22L2.71 7.48a.5.5 0 0 0 .12.64l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94L2.83 14.52a.5.5 0 0 0-.12.64l1.92 3.32c.13.22.39.3.6.22l2.39-.96c.5.4 1.05.71 1.63.94l.36 2.54c.04.24.25.42.49.42h3.8c.24 0 .45-.18.49-.42l.36-2.54c.58-.23 1.12-.54 1.63-.94l2.39.96c.22.09.47 0 .6-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58ZM12 15.5A3.5 3.5 0 1 1 12 8a3.5 3.5 0 0 1 0 7.5Z" fill="currentColor"/>
                </svg>
              </button>
            </span>
          <% end %>
        </div>
        <div class="card-body">
          <% divisions = @tournament.tournament_divisions.order(:position, :id) %>

          <% all_matches = @all_matches_for_all_match || [] %>

          <% if divisions.any? && all_matches.any? %>
            <% color_classes = ["border-primary", "border-success", "border-warning", "border-info", "border-danger"] %>

              <% divisions.each_with_index do |div, idx| %>
                <% div_matches = all_matches.select { |m| m.tournament_division_id == div.id } %>
                <% next if div_matches.empty? %>

                <% color_class = color_classes[idx % color_classes.size] %>
                <% division_teams = div.team_registrations.confirmed_for_competition.includes(:team).map(&:team).compact.uniq %>
                <% teams_by_group = {} %>
                <% div.groups.order(:name).each do |g| %>
                  <% ids = div.matches.group_stage.where(group_id: g.id).pluck(:home_team_id, :away_team_id).flatten.compact.uniq %>
                  <% teams_by_group[g.name.to_s] = division_teams.select { |t| ids.include?(t.id) } %>
                <% end %>

                <div class="mb-3 p-2 p-md-3 rounded" style="background-color:#f8f9fa;">
                  <div class="d-flex align-items-center mb-2" style="gap:8px;">
                    <div class="border-start border-4 <%= color_class %>" style="height:20px;"></div>
                    <div>
                      <div class="fw-bold" style="font-size:13px;">รุ่น <%= div.name %></div>
                      <% if can_manage_registrations?(@tournament) %>
                        <div style="font-size:11px;color:#78909c;">ตารางแข่งขันแบบ mock ตามสายในรุ่นนี้</div>
                      <% end %>
                    </div>
                  </div>

                  <% matches_by_group = div_matches.group_by do |m| %>
                    <% if m.knockout? %>
                      <% "KO_#{m.round_label}" %>
                    <% else %>
                      <% "GROUP_#{m.group&.name || "-"}" %>
                    <% end %>
                  <% end %>

                  <% sorted_group_keys = matches_by_group.keys.sort_by do |group_key| %>
                    <% if group_key.start_with?("KO_") %>
                      <% round_code = group_key.sub("KO_", "") %>
                      <% case round_code
                         when "R64" then 1
                         when "R32" then 2
                         when "R16" then 3
                         when "QF"  then 4
                         when "SF"  then 5
                         when "3RD" then 6
                         when "FINAL" then 7
                         else 999
                         end %>
                    <% else %>
                      <% 0 %>
                    <% end %>
                  <% end %>

                  <% sorted_group_keys.each do |group_key| %>
                    <% matches = matches_by_group[group_key] %>
                    <% dated_matches, undated_matches = matches.partition { |m| m.kickoff_at.present? } %>
                    <% dated_matches = dated_matches.sort_by(&:kickoff_at) %>
                    <% played_undated, unplayed_undated = undated_matches.partition { |m| m.home_score.present? || m.away_score.present? } %>

                    <% match_team_keys = lambda do |m|
                         home_key = m.home_team_id.presence || m.home_slot_label.presence || "H#{m.id}"
                         away_key = m.away_team_id.presence || m.away_slot_label.presence || "A#{m.id}"
                         [home_key.to_s, away_key.to_s]
                       end %>

                    <% reordered_unplayed = [] %>
                    <% remaining = unplayed_undated.dup %>
                    <% last_teams = [] %>

                    <% while remaining.any? %>
                      <% pick = remaining.find do |m|
                           teams = match_team_keys.call(m)
                           (teams & last_teams).empty?
                         end %>

                      <% pick ||= remaining.first %>
                      <% reordered_unplayed << pick %>
                      <% last_teams = match_team_keys.call(pick) %>
                      <% remaining.delete(pick) %>
                    <% end %>

                    <% matches = dated_matches + played_undated + reordered_unplayed %>
                    <% if group_key.start_with?("KO_") %>
                      <% round_code = group_key.sub("KO_", "") %>
                      <% group_title = case round_code
                                       when "SF" then "รอบ 4 ทีม"
                                       when "QF" then "รอบ 8 ทีม"
                                       when "R16" then "รอบ 16 ทีม"
                                       when "R32" then "รอบ 32 ทีม"
                                       when "R64" then "รอบ 64 ทีม"
                                       when "FINAL" then "รอบชิงชนะเลิศ"
                                       when "3RD" then "ชิงอันดับ 3"
                                       else "รอบน็อคเอาท์"
                                       end %>
                      <% submit_suffix = group_title %>
                    <% else %>
                      <% group_name = group_key.sub("GROUP_", "") %>
                      <% group_title = "สาย #{group_name}" %>
                      <% submit_suffix = group_title %>
                    <% end %>

                    <div class="mb-2">
                      <div class="mb-1" style="font-size:12px;color:#546e7a;"><%= group_title %></div>

                      <% if can_manage_registrations?(@tournament) %>
                        <%= form_with url: update_scores_tournament_path(@tournament), method: :patch, local: true do |f| %>
                          <% submitted_day = params[:day].presence || (@selected_day&.strftime("%Y-%m-%d")) %>
                          <%= hidden_field_tag :day, submitted_day %>
                          <%= hidden_field_tag :page, (params[:page].presence || @day_page) %>

                          <div class="d-block d-md-none fixture-match-list fixture-mobile-only" data-fixture-scores-mobile>
                            <% matches.each_with_index do |match, idx| %>
                              <div class="fixture-match-card" data-match-href="<%= match_tournament_path(@tournament, match_id: match.id) %>">
                                <div class="fixture-match-card-header">
                                  <div>คู่ที่ <%= (match.position.presence || (idx + 1)) %></div>
                                  <div style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
                                    <span><%= match.kickoff_at.present? ? match.kickoff_at.strftime("%d/%m/%Y %H:%M") : "ยังไม่ได้กำหนด" %></span>
                                  </div>
                                </div>
                                <div class="fixture-match-card-body">
                                  <div class="fixture-teams-row">
                                    <div class="fixture-team">
                                      <% if match.home_team&.logo&.attached? %>
                                        <%= image_tag match.home_team.logo, class: "fixture-logo" %>
                                      <% else %>
                                        <div class="fixture-logo"></div>
                                      <% end %>
                                      <div class="fixture-team-name"><%= match.home_name %></div>
                                    </div>

                                    <div class="fixture-score">
                                      <% if match.home_score.present? && match.away_score.present? %>
                                        <div class="fixture-score-main"><%= match.home_score %> - <%= match.away_score %></div>
                                      <% else %>
                                        <div class="fixture-score-main">VS</div>
                                      <% end %>
                                    </div>

                                    <div class="fixture-team fixture-team--away">
                                      <div class="fixture-team-name"><%= match.away_name %></div>
                                      <% if match.away_team&.logo&.attached? %>
                                        <%= image_tag match.away_team.logo, class: "fixture-logo" %>
                                      <% else %>
                                        <div class="fixture-logo"></div>
                                      <% end %>
                                    </div>
                                  </div>

                                  <div class="fixture-admin-controls">
                                    <div>
                                      <label class="form-label" style="font-size:12px;margin-bottom:4px;">วันเวลา</label>
                                      <%= datetime_field_tag "matches[#{match.id}][kickoff_at]",
                                            (match.kickoff_at&.strftime("%Y-%m-%dT%H:%M")),
                                            class: "form-control form-control-sm",
                                            placeholder: "ยังไม่ได้กำหนด" %>
                                    </div>

                                    <div>
                                      <label class="form-label" style="font-size:12px;margin-bottom:4px;">สกอร์</label>
                                      <div class="fixture-admin-score">
                                        <%= select_tag "matches[#{match.id}][home_score]",
                                              options_for_select((0..15).to_a, match.home_score),
                                              include_blank: "-",
                                              class: "form-select form-select-sm",
                                              style: "width:auto;display:inline-block;" %>
                                        <span>-</span>
                                        <%= select_tag "matches[#{match.id}][away_score]",
                                              options_for_select((0..15).to_a, match.away_score),
                                              include_blank: "-",
                                              class: "form-select form-select-sm",
                                              style: "width:auto;display:inline-block;" %>
                                      </div>

                                      <% if div.respond_to?(:draw_mode) && div.draw_mode == "pk" && match.home_score.present? && match.away_score.present? && match.home_score == match.away_score %>
                                        <div class="mt-2" style="font-size:11px;">
                                          <%= select_tag "matches[#{match.id}][penalty_winner_side]",
                                                options_for_select([
                                                  ["ไม่มียิงจุดโทษ", ""],
                                                  ["เหย้าชนะจุดโทษ", "home"],
                                                  ["เยือนชนะจุดโทษ", "away"]
                                                ], match.penalty_winner_side),
                                                class: "form-select form-select-sm",
                                                style: "max-width:220px;" %>
                                        </div>
                                      <% end %>
                                    </div>
                                  </div>
                                </div>
                              </div>
                            <% end %>
                          </div>

                          <div class="table-responsive d-none d-md-block fixture-desktop-only" data-fixture-scores-desktop>
                            <table class="table table-sm align-middle mb-0">
                              <thead class="table-light">
                                <tr>
                                  <th scope="col" class="text-center" style="width:60px;">คู่ที่</th>
                                  <th scope="col" style="width:160px;">วันเวลา</th>
                                  <th scope="col">ทีมเหย้า</th>
                                  <th scope="col">ทีมเยือน</th>
                                  <th scope="col" class="text-end">สกอร์</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% matches.each_with_index do |match, idx| %>
                                  <% played = match.home_score.present? && match.away_score.present? %>
                                  <tr>
                                    <td class="text-center" style="font-size:12px;white-space:nowrap;">
                                      <%= link_to "คู่ที่ #{(match.position.presence || (idx + 1))}", match_tournament_path(@tournament, match_id: match.id), class: "text-decoration-none" %>
                                    </td>
                                    <td>
                                      <%= datetime_field_tag "matches[#{match.id}][kickoff_at]",
                                            (match.kickoff_at&.strftime("%Y-%m-%dT%H:%M")),
                                            class: "form-control form-control-sm",
                                            placeholder: "ยังไม่ได้กำหนด" %>
                                    </td>
                                    <td>
                                      <div class="d-flex align-items-center" style="gap:6px;">
                                        <% if match.home_team&.logo&.attached? %>
                                          <%= image_tag match.home_team.logo,
                                                        class: "rounded-circle",
                                                        style: "width:24px;height:24px;object-fit:cover;" %>
                                        <% end %>
                                        <span><%= match.home_name %></span>
                                      </div>
                                    </td>
                                    <td>
                                      <div class="d-flex align-items-center" style="gap:6px;">
                                        <% if match.away_team&.logo&.attached? %>
                                          <%= image_tag match.away_team.logo,
                                                        class: "rounded-circle",
                                                        style: "width:24px;height:24px;object-fit:cover;" %>
                                        <% end %>
                                        <span><%= match.away_name %></span>
                                      </div>
                                    </td>
                                    <td class="text-end">
                                      <div class="d-flex justify-content-end align-items-center" style="gap:4px;">
                                        <%= select_tag "matches[#{match.id}][home_score]",
                                              options_for_select((0..15).to_a, match.home_score),
                                              include_blank: "-",
                                              class: "form-select form-select-sm",
                                              style: "width:auto;display:inline-block;" %>
                                        <span>-</span>
                                        <%= select_tag "matches[#{match.id}][away_score]",
                                              options_for_select((0..15).to_a, match.away_score),
                                              include_blank: "-",
                                              class: "form-select form-select-sm",
                                              style: "width:auto;display:inline-block;" %>
                                      </div>
                                      <% if div.respond_to?(:draw_mode) && div.draw_mode == "pk" && match.home_score.present? && match.away_score.present? && match.home_score == match.away_score %>
                                        <div class="mt-1 text-end" style="font-size:11px;">
                                          <%= select_tag "matches[#{match.id}][penalty_winner_side]",
                                                options_for_select([
                                                  ["ไม่มียิงจุดโทษ", ""],
                                                  ["เหย้าชนะจุดโทษ", "home"],
                                                  ["เยือนชนะจุดโทษ", "away"]
                                                ], match.penalty_winner_side),
                                                class: "form-select form-select-sm d-inline-block",
                                                style: "max-width:180px;" %>
                                        </div>
                                      <% end %>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>

                          <script>
                            (function() {
                              function setDisabled(container, disabled) {
                                if (!container) return;
                                container.querySelectorAll('input, select, textarea, button').forEach(function(el) {
                                  if (el.type === 'hidden') return;
                                  el.disabled = disabled;
                                });
                              }

                              function syncFixtureScoreInputs() {
                                var isDesktop = window.matchMedia('(min-width: 768px)').matches;
                                document.querySelectorAll('[data-fixture-scores-mobile]').forEach(function(el) {
                                  setDisabled(el, isDesktop);
                                });
                                document.querySelectorAll('[data-fixture-scores-desktop]').forEach(function(el) {
                                  setDisabled(el, !isDesktop);
                                });
                              }

                              document.addEventListener('turbo:load', syncFixtureScoreInputs);
                              document.addEventListener('DOMContentLoaded', syncFixtureScoreInputs);
                              window.addEventListener('resize', syncFixtureScoreInputs);
                            })();
                          </script>
                          <div class="mt-2 text-end">
                            <button type="submit" class="btn btn-sm btn-outline-primary">บันทึกสกอร์<%= submit_suffix %></button>
                          </div>
                        <% end %>
                      <% else %>
                        <div class="d-block d-md-none fixture-match-list fixture-mobile-only">
                          <% matches.each_with_index do |match, idx| %>
                            <% hs = match.home_score; as = match.away_score %>
                            <div class="fixture-match-card" data-match-href="<%= match_tournament_path(@tournament, match_id: match.id) %>">
                              <div class="fixture-match-card-header">
                                <div>คู่ที่ <%= (match.position.presence || (idx + 1)) %></div>
                                <div style="display:flex;align-items:center;gap:8px;white-space:nowrap;">
                                  <span><%= match.kickoff_at.present? ? match.kickoff_at.strftime("%d/%m/%Y %H:%M") : "ยังไม่ได้กำหนด" %></span>
                                </div>
                              </div>
                              <div class="fixture-match-card-body">
                                <div class="fixture-teams-row">
                                  <div class="fixture-team">
                                    <% if match.home_team&.logo&.attached? %>
                                      <%= image_tag match.home_team.logo, class: "fixture-logo" %>
                                    <% else %>
                                      <div class="fixture-logo"></div>
                                    <% end %>
                                    <div class="fixture-team-name"><%= match.home_name %></div>
                                  </div>

                                  <div class="fixture-score">
                                    <% if match.home_score.present? && match.away_score.present? %>
                                      <% if div.respond_to?(:draw_mode) && div.draw_mode == "pk" && match.decided_by_penalty && hs == as && match.penalty_winner_side.present? %>
                                        <% if match.penalty_winner_side == "home" %>
                                          <div class="fixture-score-main">*<%= hs %> - <%= as %></div>
                                        <% else %>
                                          <div class="fixture-score-main"><%= hs %> - *<%= as %></div>
                                        <% end %>
                                      <% else %>
                                        <div class="fixture-score-main"><%= hs %> - <%= as %></div>
                                      <% end %>
                                    <% else %>
                                      <div class="fixture-score-main">VS</div>
                                    <% end %>
                                  </div>

                                  <div class="fixture-team fixture-team--away">
                                    <div class="fixture-team-name"><%= match.away_name %></div>
                                    <% if match.away_team&.logo&.attached? %>
                                      <%= image_tag match.away_team.logo, class: "fixture-logo" %>
                                    <% else %>
                                      <div class="fixture-logo"></div>
                                    <% end %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          <% end %>
                        </div>

                        <div class="table-responsive d-none d-md-block fixture-desktop-only">
                            <table class="table table-sm align-middle mb-0">
                              <thead class="table-light">
                                <tr>
                                  <th scope="col" class="text-center" style="width:60px;">คู่ที่</th>
                                  <th scope="col" style="width:160px;">วันเวลา</th>
                                  <th scope="col">ทีมเหย้า</th>
                                  <th scope="col">ทีมเยือน</th>
                                  <th scope="col" class="text-end">สกอร์</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% matches.each_with_index do |match, idx| %>
                                  <% played = match.home_score.present? && match.away_score.present? %>
                                  <tr>
                                    <td class="text-center" style="font-size:12px;white-space:nowrap;">
                                      <%= link_to "คู่ที่ #{(match.position.presence || (idx + 1))}", match_tournament_path(@tournament, match_id: match.id), class: "text-decoration-none" %>
                                    </td>
                                    <td>
                                      <% if match.kickoff_at.present? %>
                                        <%= match.kickoff_at.strftime("%d/%m/%Y %H:%M") %>
                                      <% else %>
                                        <span class="text-muted" style="font-size:12px;">ยังไม่ได้กำหนด</span>
                                      <% end %>
                                    </td>
                                    <td>
                                      <div class="d-flex align-items-center" style="gap:6px;">
                                        <% if match.home_team&.logo&.attached? %>
                                          <%= image_tag match.home_team.logo,
                                                        class: "rounded-circle",
                                                        style: "width:24px;height:24px;object-fit:cover;" %>
                                        <% end %>
                                        <span><%= match.home_name %></span>
                                      </div>
                                    </td>
                                    <td>
                                      <div class="d-flex align-items-center" style="gap:6px;">
                                        <% if match.away_team&.logo&.attached? %>
                                          <%= image_tag match.away_team.logo,
                                                        class: "rounded-circle",
                                                        style: "width:24px;height:24px;object-fit:cover;" %>
                                        <% end %>
                                        <span><%= match.away_name %></span>
                                      </div>
                                    </td>
                                    <td class="text-end">
                                      <% if match.home_score.present? && match.away_score.present? %>
                                        <% hs = match.home_score; as = match.away_score %>
                                        <% if div.respond_to?(:draw_mode) && div.draw_mode == "pk" && match.decided_by_penalty && hs == as && match.penalty_winner_side.present? %>
                                          <% if match.penalty_winner_side == "home" %>
                                            *<%= hs %> - <%= as %>
                                          <% else %>
                                            <%= hs %> - *<%= as %>
                                          <% end %>
                                        <% else %>
                                          <%= hs %> - <%= as %>
                                        <% end %>
                                      <% else %>
                                        <span class="text-muted" style="font-size:12px;">-</span>
                                      <% end %>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                          </div>
                      <% end %>
                    <% end %>

                  <% end %>
                </div>


          <% elsif divisions.any? %>
            <div class="alert alert-info" role="alert">
              <p class="mb-0 text-muted" style="font-size:13px;">ยังไม่มีการสร้างโปรแกรมแข่งขันสำหรับรุ่นใดเลย</p>
            </div>
          <% else %>
            <p class="mb-0 text-muted" style="font-size:13px;">ยังไม่มีการกำหนดรุ่นการแข่งขันสำหรับรายการนี้</p>
          <% end %>
        </div>
      </div>

      <% if can_manage_registrations?(@tournament) %>
        <div class="modal fade" id="bulkScheduleModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
              <div class="modal-header">
                <div class="fw-bold">ตั้งเวลาแข่งแบบชุด</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <%= form_with url: bulk_schedule_tournament_path(@tournament), method: :patch, local: true do %>
                  <div class="row g-2">
                    <div class="col-12 col-md-6">
                      <label class="form-label" style="font-size:12px;">วันที่แข่ง</label>
                      <%= date_field_tag :schedule_date,
                            (@selected_day&.strftime("%Y-%m-%d") || Time.zone.today.strftime("%Y-%m-%d")),
                            class: "form-control" %>
                    </div>
                    <div class="col-12 col-md-6">
                      <label class="form-label" style="font-size:12px;">เวลาเริ่มแข่ง (คู่แรก)</label>
                      <%= time_field_tag :start_time, "09:00", class: "form-control" %>
                    </div>

                    <div class="col-6 col-md-3">
                      <label class="form-label" style="font-size:12px;">แข่งกี่นาที/ครึ่ง</label>
                      <%= number_field_tag :minutes_per_half, 20, class: "form-control", min: 1 %>
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label" style="font-size:12px;">มีกี่ครึ่ง</label>
                      <%= number_field_tag :halves_count, 2, class: "form-control", min: 1 %>
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label" style="font-size:12px;">พักครึ่ง (นาที)</label>
                      <%= number_field_tag :break_between_halves, 5, class: "form-control", min: 0 %>
                    </div>
                    <div class="col-6 col-md-3">
                      <label class="form-label" style="font-size:12px;">พักระหว่างคู่ (นาที)</label>
                      <%= number_field_tag :break_between_matches, 5, class: "form-control", min: 0 %>
                    </div>
                  </div>

                  <hr />
                  <% divisions = @tournament.tournament_divisions.order(:position, :id).to_a %>
                  <% all_matches = @all_matches_for_all_match || [] %>
                  <% default_date = (@selected_day || Time.zone.today).to_date %>
                  <% preselected_ids = all_matches.select { |m| m.kickoff_at.present? && m.kickoff_at.to_date == default_date }
                                                .sort_by { |m| [m.kickoff_at, m.id] }
                                                .map(&:id) %>

                  <div class="fw-bold" style="font-size:13px;">1) กำหนดคิวเตะ (เรียงตามที่คลิก)</div>
                  <div class="text-muted" style="font-size:12px;margin-top:4px;">คลิกคู่ด้านล่างเพื่อเพิ่มเข้าคิว สามารถลบ/ล้างได้ และระบบจะคำนวณเวลาเรียงตามคิวนี้</div>

                  <div id="bulk-schedule-root" data-preselected-ids="<%= preselected_ids.join(',') %>">
                    <div class="d-flex align-items-center justify-content-between" style="gap:10px;">
                      <div class="fw-bold" style="font-size:12px;">คิวที่เลือก</div>
                      <button type="button" class="btn btn-sm btn-outline-danger" id="bulk-schedule-clear">Clear</button>
                    </div>

                    <div id="bulk-schedule-queue" style="margin-top:8px;border:1px solid #e5e7eb;border-radius:10px;padding:8px;min-height:52px;background:#fafafa;"></div>
                    <div id="bulk-schedule-hidden-inputs"></div>

                    <div class="mt-3 fw-bold" style="font-size:12px;">2) รายการคู่ทั้งหมด (คลิกเพื่อเพิ่มเข้าคิว)</div>
                    <div style="max-height:38vh;overflow:auto;border:1px solid #e5e7eb;border-radius:10px;padding:10px;margin-top:8px;">
                      <% divisions.each do |div| %>
                        <% div_matches = all_matches.select { |m| m.tournament_division_id == div.id } %>
                        <% next if div_matches.empty? %>
                        <div class="fw-bold" style="font-size:12px;margin:8px 0 6px 0;">รุ่น <%= div.name %></div>
                        <% div_matches.each do |m| %>
                          <% label_time = m.kickoff_at.present? ? m.kickoff_at.strftime("%d/%m %H:%M") : "ยังไม่ได้กำหนด" %>
                          <% kickoff_iso = m.kickoff_at&.iso8601 %>
                          <button type="button"
                                  class="btn btn-sm w-100 text-start"
                                  data-bulk-match="1"
                                  data-match-id="<%= m.id %>"
                                  data-kickoff-at="<%= kickoff_iso %>"
                                  data-label="<%= [m.home_name, "vs", m.away_name].join(' ') %>"
                                  style="border:1px solid #e5e7eb;border-radius:10px;padding:8px 10px;margin-bottom:8px;background:#ffffff;">
                            <div class="d-flex justify-content-between" style="gap:10px;">
                              <div style="font-size:12px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                <span class="text-muted">(<%= label_time %>)</span>
                              </div>
                              <div class="text-muted" style="font-size:12px;white-space:nowrap;">+ เพิ่ม</div>
                            </div>
                            <div style="font-size:12px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                              <%= m.home_name %> vs <%= m.away_name %>
                            </div>
                          </button>
                        <% end %>
                      <% end %>
                    </div>
                  </div>

                  <div class="d-flex justify-content-end" style="gap:8px;margin-top:12px;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <%= submit_tag "บันทึกเวลา", class: "btn btn-primary" %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
