<div class="app-shell">
  <% bg_image = "banner2.png" %>
  <div class="tournament-show-header">
    <div style="position:absolute;inset:0;background-image:url('<%= asset_path(bg_image) %>');background-size:cover;background-position:center;filter:brightness(0.8);"></div>
    <div style="position:relative;">
      <div class="tournament-show-title"><%= @tournament.title %></div>
      <div class="tournament-show-subtitle">
        <%= tournament_competition_date_label(@tournament) %> · <%= @tournament.location_name %>
      </div>
    </div>
  </div>

  <div class="tournament-show-body">
    <div class="container py-3">
      <%# Header with back button %>
      <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="d-flex align-items-center" style="gap:12px;">
          <svg viewBox="0 0 24 24" width="24" height="24" style="color:#1976d2;">
            <path d="M3 3h8v8H3V3zm0 10h8v8H3v-8zm10 0h8v8h-8v-8zm0-10h8v8h-8V3z" fill="currentColor"/>
          </svg>
          <h5 class="mb-0 fw-bold" style="color:#1976d2;">สายการแข่งขันรอบน็อคเอาท์</h5>
        </div>
        <%= link_to fixture_tournament_path(@tournament), class: "btn btn-outline-primary btn-sm" do %>
          <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="currentColor"/>
          </svg>
          กลับไปโปรแกรมแข่ง
        <% end %>
      </div>

      <% if @divisions_with_knockout.any? %>
        <%# Dropdown เลือกรุ่น %>
        <div class="mb-3 d-flex align-items-center" style="gap:12px;">
          <label style="font-size:13px;font-weight:600;color:#546e7a;">เลือกรุ่น:</label>
          <select id="bracketDivisionSelect" class="form-select form-select-sm" style="max-width:200px;" onchange="showSelectedDivisionBracket()">
            <% @divisions_with_knockout.each_with_index do |div, idx| %>
              <option value="bracket-div-<%= div.id %>" <%= 'selected' if idx == 0 %>><%= div.name %></option>
            <% end %>
          </select>
        </div>

        <% @divisions_with_knockout.each_with_index do |div, div_idx| %>
          <% knockout_matches = div.matches.knockout.order(:round_number, :position, :id).to_a %>
          <% next if knockout_matches.empty? %>
          
          <% rounds_grouped = knockout_matches.group_by(&:round_number) %>
          <% sorted_rounds = rounds_grouped.keys.compact.sort %>
          
          <div class="bracket-division-content" id="bracket-div-<%= div.id %>" style="<%= 'display:none;' unless div_idx == 0 %>">
            <h6 class="fw-bold mb-3" style="color:#1976d2;">รุ่น <%= div.name %></h6>
            
            <div class="card" style="overflow:hidden;">
              <div class="card-body" style="overflow-x:auto;background:#f8f9fa;padding:20px;">
                <div class="knockout-bracket" style="display:flex;align-items:stretch;min-width:max-content;padding:8px 0;">
                  <% sorted_rounds.each_with_index do |round_num, round_idx| %>
                    <% round_matches = rounds_grouped[round_num].sort_by { |m| [m.position || 0, m.id] } %>
                    <% round_label = round_matches.first&.round_label || "R#{round_num}" %>
                    <% round_title = case round_label
                                     when "SF" then "รอบ 4 ทีม"
                                     when "QF" then "รอบ 8 ทีม"
                                     when "R16" then "รอบ 16 ทีม"
                                     when "R32" then "รอบ 32 ทีม"
                                     when "FINAL" then "ชิงชนะเลิศ"
                                     when "3RD" then "ชิงอันดับ 3"
                                     else round_label
                                     end %>
                    
                    <div class="bracket-round" style="display:flex;flex-direction:column;min-width:240px;">
                      <div style="text-align:center;font-weight:bold;font-size:12px;color:#546e7a;padding:6px;background:#e3f2fd;border-radius:6px;margin-bottom:12px;">
                        <%= round_title %>
                      </div>
                      
                      <div style="display:flex;flex-direction:column;justify-content:space-around;flex:1;">
                        <% round_matches.each_with_index do |match, match_idx| %>
                          <% has_result = match.home_score.present? && match.away_score.present? %>
                          <% home_won = has_result && match.home_score.to_i > match.away_score.to_i %>
                          <% away_won = has_result && match.away_score.to_i > match.home_score.to_i %>
                          <% if has_result && match.home_score == match.away_score && match.penalty_winner_side.present? %>
                            <% home_won = match.penalty_winner_side == "home" %>
                            <% away_won = match.penalty_winner_side == "away" %>
                          <% end %>
                          
                          <div class="bracket-match" style="background:#fff;border:1px solid #e0e0e0;border-radius:6px;overflow:hidden;box-shadow:0 1px 2px rgba(0,0,0,0.06);margin:8px 0;">
                            <div style="background:#f5f5f5;padding:4px 8px;font-size:10px;color:#78909c;border-bottom:1px solid #e0e0e0;">
                              <% if match.kickoff_at.present? %>
                                Date <%= match.kickoff_at.strftime("%d/%m/%Y") %> Time <%= match.kickoff_at.strftime("%H:%M") %>
                              <% else %>
                                ยังไม่กำหนดเวลา
                              <% end %>
                            </div>
                            
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border-bottom:1px solid #f0f0f0;<%= home_won ? 'background:#e8f5e9;' : '' %>">
                              <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                                <% if match.home_team&.logo&.attached? %>
                                  <%= image_tag match.home_team.logo, style: "width:24px;height:24px;border-radius:50%;object-fit:cover;" %>
                                <% else %>
                                  <div style="width:24px;height:24px;border-radius:50%;background:#e0e0e0;"></div>
                                <% end %>
                                <span style="font-size:13px;font-weight:<%= home_won ? '700' : '500' %>;color:<%= home_won ? '#2e7d32' : '#333' %>;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                  <%= match.home_name %>
                                </span>
                              </div>
                              <span style="font-size:15px;font-weight:700;color:<%= home_won ? '#2e7d32' : '#666' %>;min-width:24px;text-align:right;">
                                <%= match.home_score.present? ? match.home_score : '' %>
                              </span>
                            </div>
                            
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;<%= away_won ? 'background:#e8f5e9;' : '' %>">
                              <div style="display:flex;align-items:center;gap:8px;flex:1;min-width:0;">
                                <% if match.away_team&.logo&.attached? %>
                                  <%= image_tag match.away_team.logo, style: "width:24px;height:24px;border-radius:50%;object-fit:cover;" %>
                                <% else %>
                                  <div style="width:24px;height:24px;border-radius:50%;background:#e0e0e0;"></div>
                                <% end %>
                                <span style="font-size:13px;font-weight:<%= away_won ? '700' : '500' %>;color:<%= away_won ? '#2e7d32' : '#333' %>;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                  <%= match.away_name %>
                                </span>
                              </div>
                              <span style="font-size:15px;font-weight:700;color:<%= away_won ? '#2e7d32' : '#666' %>;min-width:24px;text-align:right;">
                                <%= match.away_score.present? ? match.away_score : '' %>
                              </span>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                    
                    <%# Connector lines %>
                    <% if round_idx < sorted_rounds.size - 1 && round_matches.size >= 2 %>
                      <div style="display:flex;flex-direction:column;justify-content:space-around;width:30px;padding:30px 0;">
                        <% (round_matches.size / 2).times do |pair_idx| %>
                          <div style="position:relative;flex:1;display:flex;flex-direction:column;justify-content:center;">
                            <div style="position:absolute;left:0;top:25%;bottom:25%;width:15px;border-top:2px solid #bdbdbd;border-right:2px solid #bdbdbd;border-bottom:2px solid #bdbdbd;border-radius:0 4px 4px 0;"></div>
                            <div style="position:absolute;right:0;top:50%;width:15px;height:2px;background:#bdbdbd;transform:translateY(-50%);"></div>
                          </div>
                        <% end %>
                      </div>
                    <% elsif round_idx < sorted_rounds.size - 1 %>
                      <div style="width:30px;"></div>
                    <% end %>
                  <% end %>
                </div>
              </div>
              
              <%# Footer with logo and download button %>
              <div class="card-footer" style="display:flex;justify-content:space-between;align-items:center;background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <%= image_tag "dernsai_icon.png", alt: "DERNSAI", style: "width:20px;height:20px;border-radius:4px;object-fit:contain;" %>
                  <span style="font-size:11px;color:#94a3b8;font-weight:600;">DERNSAI.COM</span>
                </div>
                <button type="button" class="btn btn-success btn-sm" onclick="downloadBracketImage('<%= div.id %>', '<%= div.name %>')">
                  <svg viewBox="0 0 24 24" width="14" height="14" style="margin-right:4px;">
                    <path d="M12 3a1 1 0 0 1 1 1v8.59l2.3-2.3a1 1 0 1 1 1.4 1.42l-4.01 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 1.4-1.42L11 12.59V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v1a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-1a1 1 0 0 1 1-1Z" fill="currentColor"/>
                  </svg>
                  ดาวน์โหลดรูป
                </button>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info" style="font-size:13px;">
          <svg viewBox="0 0 24 24" width="18" height="18" style="margin-right:8px;">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" fill="currentColor"/>
          </svg>
          ยังไม่มีรอบน็อคเอาท์สำหรับรายการนี้
        </div>
        
        <%= link_to fixture_tournament_path(@tournament), class: "btn btn-primary" do %>
          <svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:4px;">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" fill="currentColor"/>
          </svg>
          กลับไปโปรแกรมแข่ง
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
<script>
  function showSelectedDivisionBracket() {
    var select = document.getElementById('bracketDivisionSelect');
    var selectedId = select.value;
    
    // ซ่อนทุก division
    document.querySelectorAll('.bracket-division-content').forEach(function(el) {
      el.style.display = 'none';
    });
    
    // แสดง division ที่เลือก
    var selectedDiv = document.getElementById(selectedId);
    if (selectedDiv) {
      selectedDiv.style.display = 'block';
    }
  }

  function downloadBracketImage(divisionId, divisionName) {
    var bracketContent = document.getElementById('bracket-div-' + divisionId);
    
    if (!bracketContent) {
      alert('ไม่พบ bracket content');
      return;
    }

    // สร้าง container สำหรับ capture
    var captureContainer = document.createElement('div');
    captureContainer.style.cssText = 'position:fixed;left:-10000px;top:0;background:#fff;padding:20px;';
    
    // Clone bracket content
    var clonedContent = bracketContent.querySelector('.card').cloneNode(true);
    clonedContent.style.overflow = 'visible';
    clonedContent.style.maxHeight = 'none';
    
    // เพิ่ม header พร้อมชื่อรุ่น
    var header = document.createElement('div');
    header.style.cssText = 'text-align:center;margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid #e0e0e0;';
    header.innerHTML = '<div style="font-size:20px;font-weight:bold;color:#1976d2;">สายการแข่งขันรอบน็อคเอาท์</div><div style="font-size:14px;color:#1976d2;margin-top:4px;font-weight:600;">รุ่น ' + divisionName + '</div><div style="font-size:12px;color:#78909c;margin-top:4px;"><%= @tournament.title %></div>';
    
    captureContainer.appendChild(header);
    captureContainer.appendChild(clonedContent);
    document.body.appendChild(captureContainer);

    html2canvas(captureContainer, {
      backgroundColor: '#ffffff',
      scale: 2,
      useCORS: true,
      allowTaint: true,
      logging: false
    }).then(function(canvas) {
      var link = document.createElement('a');
      link.download = 'knockout-bracket-' + divisionName + '-<%= @tournament.id %>.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
      document.body.removeChild(captureContainer);
    }).catch(function(err) {
      console.error('Error capturing bracket:', err);
      alert('เกิดข้อผิดพลาดในการดาวน์โหลดรูป');
      document.body.removeChild(captureContainer);
    });
  }
</script>
