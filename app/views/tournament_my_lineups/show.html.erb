<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <div class="d-flex justify-content-between align-items-center mb-2" style="gap:8px;">
        <div>
          <div style="font-size:18px;font-weight:bold;">เลือกตัวจริง</div>
          <div class="text-muted" style="font-size:13px;">
            <%= @match.home_name %> vs <%= @match.away_name %>
            <% if @match.kickoff_at.present? %>
              · <%= @match.kickoff_at.strftime("%d/%m/%Y %H:%M") %>
            <% end %>
          </div>
          <div class="text-muted" style="font-size:12px;">
            ทีม: <%= @entry.team.name %> · ฝั่ง: <%= @side.to_s == "home" ? "เหย้า" : "เยือน" %>
          </div>
        </div>
        <div class="d-flex" style="gap:8px;">
          <%= link_to "กลับ", my_entry_lineups_tournament_path(@tournament, team_registration_id: @entry.id), class: "btn btn-sm btn-outline-secondary" %>
          <%= link_to "ดูหน้าแมตช์", match_tournament_path(@tournament, match_id: @match.id), class: "btn btn-sm btn-outline-primary" %>
        </div>
      </div>

      <% if !@entry.respond_to?(:roster_locked?) || !@entry.roster_locked? %>
        <div class="alert alert-warning" style="font-size:13px;">
          ต้องส่งรายชื่อนักกีฬาก่อน จึงจะส่งรายชื่อตัวจริงได้
        </div>
      <% end %>

      <% if @match.kickoff_at.present? && Time.zone.now >= @match.kickoff_at %>
        <div class="alert alert-secondary" style="font-size:13px;">
          เริ่มแข่งขันแล้ว ไม่สามารถแก้ไขรายชื่อตัวจริงได้
        </div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body">
          <div class="text-muted" style="font-size:12px; margin-bottom:8px;">
            หมายเหตุ: ติ๊กเฉพาะ "ตัวจริง" คนที่ไม่ติ๊กถือเป็นตัวสำรอง
          </div>

          <%= form_with url: match_lineup_tournament_path(@tournament, match_id: @match.id, side: @side), method: :patch, local: true do %>
            <div class="d-flex flex-column" style="gap:10px;">
              <% if @players.any? %>
                <% @players.each do |p| %>
                  <% y = (@yellow_count_by_player_id && @yellow_count_by_player_id[p.id]).to_i %>
                  <% age = if @competition_year.present? && p.birth_date.present?
                             @competition_year - p.birth_date.year
                           end %>

                  <label class="d-flex justify-content-between align-items-center" style="gap:10px; padding:10px; border:1px solid rgba(0,0,0,0.10); border-radius:12px;">
                    <div class="d-flex align-items-center" style="gap:10px; min-width:0;">
                      <%= check_box_tag "lineup[starter_ids][]", p.id, @starter_id_set.include?(p.id), class: "form-check-input", style: "margin-top:0;" %>
                      <div style="min-width:0;">
                        <div style="font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                          <%= p.full_name %>
                        </div>
                        <div class="text-muted" style="font-size:12px;">
                          (<%= p.jersey_number.presence || "-" %>/<%= age.present? ? age : "-" %>)
                        </div>
                        <% if y > 0 %>
                          <div class="d-flex align-items-center" style="gap:4px; margin-top:4px;">
                            <div class="text-muted" style="font-size:12px;">ใบเหลืองสะสม:</div>
                            <div class="d-flex align-items-center" style="gap:2px;">
                              <% y.times do %>
                                <span style="width:10px;height:14px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);display:inline-block;"></span>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  </label>
                <% end %>

                <div class="d-flex justify-content-end" style="gap:8px;">
                  <%= submit_tag "ส่งรายชื่อตัวจริง", class: "btn btn-sm btn-success" %>
                </div>
              <% else %>
                <div class="text-muted" style="font-size:13px;">ยังไม่มีนักกีฬาในทีมนี้</div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
