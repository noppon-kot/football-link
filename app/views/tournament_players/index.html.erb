<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <% public_view = !!@public_view %>
      <div class="d-flex justify-content-between align-items-center mb-2" style="gap:8px;">
        <div>
          <div style="font-size:18px;font-weight:bold;">นักกีฬา</div>
          <div class="text-muted" style="font-size:13px;"><%= @entry.team.name %> · รุ่น <%= @entry.tournament_division&.name || "-" %></div>
        </div>
        <div class="d-flex" style="gap:8px;">
          <%= link_to "กลับ",
                      my_entry_tournament_path(@tournament, team_registration_id: @entry.id),
                      class: "btn btn-sm btn-outline-secondary" %>
          <% can_edit_roster = !public_view && ((!@entry.respond_to?(:roster_locked?) || !@entry.roster_locked?) || can_manage_registrations?(@tournament)) %>
          <% can_submit_roster = (@entry.respond_to?(:roster_locked?) && !@entry.roster_locked?) %>
          <% if can_edit_roster %>
            <%= link_to "เพิ่มนักกีฬา",
                        new_my_entry_player_tournament_path(@tournament, team_registration_id: @entry.id),
                        class: "btn btn-sm btn-primary" %>
          <% end %>
          <% if can_submit_roster && !public_view %>
            <%= button_to "ส่งรายชื่อนักกีฬา",
                          my_entry_roster_submit_tournament_path(@tournament, team_registration_id: @entry.id),
                          method: :patch,
                          data: {
                              turbo_confirm: "ยืนยันส่งรายชื่อนักกีฬา?\n\nโปรดตรวจสอบว่ากรอกข้อมูลนักกีฬาครบแล้ว\nหลังส่งแล้วจะไม่สามารถแก้ไขได้\nหากต้องการแก้ไข ต้องให้ผู้จัด/แอดมินปลดล็อคให้"
                          },
                          class: "btn btn-sm btn-warning",
                          form_class: "inline-form" %>
          <% end %>
        </div>
      </div>

      <% if @entry.respond_to?(:roster_locked?) && @entry.roster_locked? %>
        <div class="alert alert-warning">
          ส่งรายชื่อนักกีฬาแล้ว (ล็อก)
          <% if !public_view && can_manage_registrations?(@tournament) %>
            <div class="mt-2">
              <%= button_to "ปลดล็อคเพื่อแก้ไข",
                          my_entry_roster_unlock_tournament_path(@tournament, team_registration_id: @entry.id),
                          method: :patch,
                          class: "btn btn-sm btn-outline-danger",
                          form_class: "inline-form" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if flash[:alert].present? %>
        <div class="alert alert-danger"><%= flash[:alert] %></div>
      <% end %>

      <div class="card shadow-sm">
        <div class="card-body">
          <% if @players.any? %>
            <div class="d-flex flex-column" style="gap:10px;">
              <% @players.each do |p| %>
                <% player_events = (@events_by_player && @events_by_player[p.id]) || [] %>
                <% goal_events = player_events.select { |e| e.event_type == "goal" } %>
                <% yellow_events = player_events.select { |e| e.event_type == "yellow_card" } %>
                <% red_events = player_events.select { |e| e.event_type == "red_card" } %>
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div class="d-flex align-items-center" style="gap:10px;min-width:0;">
                    <% if p.photo.attached? %>
                      <%= image_tag p.photo, class: "rounded-circle", style: "width:36px;height:36px;object-fit:cover;" %>
                    <% end %>
                    <div style="min-width:0;">
                      <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= p.full_name %></div>
                      <div class="text-muted" style="font-size:12px;">
                        วันเกิด: <%= p.birth_date&.strftime("%d/%m/%Y") || "-" %> · เบอร์: <%= p.jersey_number.presence || "-" %>
                      </div>

                      <div class="text-muted" style="font-size:12px;margin-top:4px;">
                        <span class="d-inline-flex align-items-center" style="gap:4px;">
                          <%= image_tag "football.png", alt: "goal", style: "width:14px;height:14px;object-fit:contain;display:block;" %>
                          <span>ประตู: <%= goal_events.size %></span>
                        </span>
                        <span style="margin:0 6px;">·</span>
                        <span class="d-inline-flex align-items-center" style="gap:4px;">
                          <span style="width:10px;height:14px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);display:inline-block;"></span>
                          <span>ใบเหลือง: <%= yellow_events.size %></span>
                        </span>
                        <span style="margin:0 6px;">·</span>
                        <span class="d-inline-flex align-items-center" style="gap:4px;">
                          <span style="width:10px;height:14px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);display:inline-block;"></span>
                          <span>ใบแดง: <%= red_events.size %></span>
                        </span>
                      </div>

                      <% if goal_events.any? || yellow_events.any? || red_events.any? %>
                        <div class="text-muted" style="font-size:12px;margin-top:2px;">
                          <% (goal_events + yellow_events + red_events).group_by(&:match_id).each do |mid, evs| %>
                            <% m = evs.first.match %>
                            <% g = evs.count { |e| e.event_type == "goal" } %>
                            <% y = evs.count { |e| e.event_type == "yellow_card" } %>
                            <% r = evs.count { |e| e.event_type == "red_card" } %>
                            <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                              <%= link_to(
                                    "นัด #{m&.kickoff_at&.strftime('%d/%m/%Y %H:%M') || m&.id}",
                                    match_tournament_path(@tournament, match_id: m.id),
                                    class: "text-decoration-none"
                                  ) %>
                              <% if g > 0 %>
                                · ประตู x<%= g %>
                              <% end %>
                              <% if y > 0 %>
                                · ใบเหลือง x<%= y %>
                              <% end %>
                              <% if r > 0 %>
                                · ใบแดง x<%= r %>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  </div>

                  <% if can_edit_roster %>
                    <div class="d-flex" style="gap:6px;flex:0 0 auto;">
                      <%= link_to "แก้ไข",
                                  edit_my_entry_player_tournament_path(@tournament, team_registration_id: @entry.id, id: p.id),
                                  class: "btn btn-sm btn-outline-secondary" %>
                      <%= button_to "ลบ",
                                    my_entry_player_tournament_path(@tournament, team_registration_id: @entry.id, id: p.id),
                                    method: :delete,
                                    data: { turbo_confirm: "ลบนักกีฬาคนนี้?" },
                                    class: "btn btn-sm btn-outline-danger",
                                    form_class: "inline-form" %>
                    </div>
                  <% end %>
                </div>

                <% if can_manage_registrations?(@tournament) %>
                  <div class="d-flex justify-content-end" style="gap:6px;margin-top:-4px;">
                    <%= button_to "ล้างใบเหลือง",
                                  team_player_clear_yellow_cards_tournament_path(@tournament, team_registration_id: @entry.id, id: p.id),
                                  method: :patch,
                                  data: { turbo_confirm: "ล้างใบเหลืองของนักเตะคนนี้?" },
                                  class: "btn btn-sm btn-outline-warning",
                                  form_class: "inline-form" %>
                    <%= button_to "ล้างใบแดง",
                                  team_player_clear_red_cards_tournament_path(@tournament, team_registration_id: @entry.id, id: p.id),
                                  method: :patch,
                                  data: { turbo_confirm: "ล้างใบแดงของนักเตะคนนี้?" },
                                  class: "btn btn-sm btn-outline-danger",
                                  form_class: "inline-form" %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-muted">ยังไม่มีนักกีฬาในทีมนี้</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
