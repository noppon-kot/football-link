<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <%= render "tournaments/nav_tabs", active: :fixture %>

      <div class="d-flex justify-content-between align-items-center mb-2" style="gap:8px;">
        <div>
          <div style="font-size:18px;font-weight:bold;">รายละเอียดการแข่งขัน</div>
          <div class="text-muted" style="font-size:13px;">
            <%= @match.tournament_division&.name.present? ? "รุ่น: #{@match.tournament_division.name}" : "-" %>
            <% if @match.kickoff_at.present? %>
              · <%= @match.kickoff_at.strftime("%d/%m/%Y %H:%M") %>
            <% end %>
          </div>
        </div>
        <div>
          <%= link_to "กลับ", fixture_tournament_path(@tournament), class: "btn btn-sm btn-outline-secondary" %>
        </div>
      </div>

      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <% home_team = @match.home_team %>
          <% away_team = @match.away_team %>
          <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
            <div style="min-width:0;">
              <div class="d-flex align-items-center" style="gap:8px;min-width:0;">
                <% if home_team&.logo&.attached? %>
                  <%= image_tag home_team.logo, style: "width:24px;height:24px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
                <% end %>
                <div class="fw-bold" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= @match.home_name %></div>
              </div>
              <div class="text-muted" style="font-size:12px;">ทีมเหย้า</div>
            </div>
            <div class="text-center" style="min-width:120px;">
              <div style="font-size:20px;font-weight:900;">
                <%= @match.home_score.presence || "-" %> - <%= @match.away_score.presence || "-" %>
              </div>
              <div class="text-muted" style="font-size:12px;">สกอร์</div>
            </div>
            <div class="text-end" style="min-width:0;">
              <div class="d-flex align-items-center justify-content-end" style="gap:8px;min-width:0;">
                <div class="fw-bold" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= @match.away_name %></div>
                <% if away_team&.logo&.attached? %>
                  <%= image_tag away_team.logo, style: "width:24px;height:24px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
                <% end %>
              </div>
              <div class="text-muted" style="font-size:12px;">ทีมเยือน</div>
            </div>
          </div>

		  <% home_entry_id = @home_entry&.id %>
		  <% away_entry_id = @away_entry&.id %>
		  <% home_events = (@match_events || []).select { |e| e.tournament_player&.team_registration_id == home_entry_id } %>
		  <% away_events = (@match_events || []).select { |e| e.tournament_player&.team_registration_id == away_entry_id } %>

		  <% if (@match_events || []).any? %>
			<hr />
			<div class="row g-2" style="font-size:12px;">
			  <div class="col-6" style="min-width:0;">
				<div class="d-flex flex-column" style="gap:6px;">
				  <% home_events.each do |e| %>
					<div class="d-flex align-items-center" style="gap:6px;min-width:0;">
					  <div style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;flex:0 0 auto;">
						<% if e.event_type == "goal" %>
						  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<circle cx="12" cy="12" r="10" fill="#ffffff" stroke="#111827" stroke-width="1.5"></circle>
							<path d="M12 6 L16 9 L14.5 14 L9.5 14 L8 9 Z" fill="#111827"></path>
						  </svg>
						<% elsif e.event_type == "yellow_card" %>
						  <div style="width:12px;height:16px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);"></div>
						<% elsif e.event_type == "red_card" %>
						  <div style="width:12px;height:16px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);"></div>
						<% end %>
					  </div>
					  <% if home_team&.logo&.attached? %>
						<%= image_tag home_team.logo, style: "width:14px;height:14px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
					  <% end %>
					  <span style="min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= e.tournament_player&.full_name %></span>
					</div>
				  <% end %>
				</div>
			  </div>
			  <div class="col-6" style="min-width:0;">
				<div class="d-flex flex-column" style="gap:6px;">
				  <% away_events.each do |e| %>
					<div class="d-flex align-items-center justify-content-end" style="gap:6px;min-width:0;">
					  <span style="min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= e.tournament_player&.full_name %></span>
					  <% if away_team&.logo&.attached? %>
						<%= image_tag away_team.logo, style: "width:14px;height:14px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
					  <% end %>
					  <div style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;flex:0 0 auto;">
						<% if e.event_type == "goal" %>
						  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
							<circle cx="12" cy="12" r="10" fill="#ffffff" stroke="#111827" stroke-width="1.5"></circle>
							<path d="M12 6 L16 9 L14.5 14 L9.5 14 L8 9 Z" fill="#111827"></path>
						  </svg>
						<% elsif e.event_type == "yellow_card" %>
						  <div style="width:12px;height:16px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);"></div>
						<% elsif e.event_type == "red_card" %>
						  <div style="width:12px;height:16px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);"></div>
						<% end %>
					  </div>
					</div>
				  <% end %>
				</div>
			  </div>
			</div>
		  <% end %>

          <% if can_manage_registrations?(@tournament) %>
            <hr />
            <%= form_with url: match_score_tournament_path(@tournament, match_id: @match.id), method: :patch, local: true do %>
              <div class="row g-2 align-items-end">
                <div class="col-6">
                  <label class="form-label" style="font-size:12px;">สกอร์เหย้า</label>
                  <%= select_tag "match[home_score]", options_for_select((0..30).to_a, @match.home_score), include_blank: "-", class: "form-select form-select-sm" %>
                </div>
                <div class="col-6">
                  <label class="form-label" style="font-size:12px;">สกอร์เยือน</label>
                  <%= select_tag "match[away_score]", options_for_select((0..30).to_a, @match.away_score), include_blank: "-", class: "form-select form-select-sm" %>
                </div>
                <div class="col-12 text-end">
                  <%= submit_tag "บันทึกสกอร์", class: "btn btn-sm btn-outline-primary" %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="row g-3">
        <% show_home_lineup = @home_lineup.locked? || (current_user && (can_manage_registrations?(@tournament) || (@home_entry && can_manage_entry?(@home_entry)))) %>
        <% if show_home_lineup %>
          <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div>
                    <div class="fw-bold">รายชื่อทีมเหย้า</div>
                    <div class="text-muted" style="font-size:12px;">
                      <% if @home_entry.present? %>
                        สถานะ: <%= @home_lineup.locked? ? "ส่งแล้ว" : "ยังไม่ส่ง" %>
                      <% else %>
                        ยังไม่สามารถส่งได้ (ยังไม่กำหนดทีม)
                      <% end %>
                    </div>
                  </div>
                  <% if can_manage_registrations?(@tournament) && @home_lineup.locked? %>
                    <%= button_to "ปลดล็อก",
                                  match_lineup_unlock_tournament_path(@tournament, match_id: @match.id, side: "home"),
                                  method: :patch,
                                  class: "btn btn-sm btn-outline-danger" %>
                  <% end %>
                </div>

                <% if @home_entry.present? %>
                  <hr />
                  <% if @home_players.any? %>
                    <div class="d-flex flex-column" style="gap:6px;">
                      <% @home_players.each do |p| %>
                        <div class="d-flex align-items-center" style="gap:8px;">
                          <span class="text-muted" style="min-width:28px;text-align:right;font-size:13px;"><%= p.jersey_number.presence || "-" %></span>
                          <span style="min-width:0;font-size:13px;"><%= p.full_name %></span>
                          <span class="text-muted" style="font-size:12px;">(<%= p.age || "-" %>)</span>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-muted" style="font-size:12px;">ยังไม่มีนักเตะในทีมนี้</div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>

        <% show_away_lineup = @away_lineup.locked? || (current_user && (can_manage_registrations?(@tournament) || (@away_entry && can_manage_entry?(@away_entry)))) %>
        <% if show_away_lineup %>
          <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div>
                    <div class="fw-bold">รายชื่อทีมเยือน</div>
                    <div class="text-muted" style="font-size:12px;">
                      <% if @away_entry.present? %>
                        สถานะ: <%= @away_lineup.locked? ? "ยืนยันแล้ว" : "ยังไม่ส่ง" %>
                      <% else %>
                        ยังไม่สามารถส่งได้ (ยังไม่กำหนดทีม)
                      <% end %>
                    </div>
                  </div>
                  <% if can_manage_registrations?(@tournament) && @away_lineup.locked? %>
                    <%= button_to "ปลดล็อก",
                                  match_lineup_unlock_tournament_path(@tournament, match_id: @match.id, side: "away"),
                                  method: :patch,
                                  class: "btn btn-sm btn-outline-danger" %>
                  <% end %>
                </div>

                <% if @away_entry.present? %>
                  <hr />
                  <% if @away_players.any? %>
                    <div class="d-flex flex-column" style="gap:6px;">
                      <% @away_players.each do |p| %>
                        <div class="d-flex align-items-center" style="gap:8px;">
                          <span class="text-muted" style="min-width:28px;text-align:right;font-size:13px;"><%= p.jersey_number.presence || "-" %></span>
                          <span style="min-width:0;font-size:13px;"><%= p.full_name %></span>
                          <span class="text-muted" style="font-size:12px;">(<%= p.age || "-" %>)</span>
                        </div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-muted" style="font-size:12px;">ยังไม่มีนักเตะในทีมนี้</div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if can_manage_registrations?(@tournament) %>
        <div class="card shadow-sm mt-3">
          <div class="card-body">
            <div class="fw-bold mb-1">เหตุการณ์ (Goals / Cards)</div>

            <% if can_manage_registrations?(@tournament) %>
              <%= form_with url: match_events_tournament_path(@tournament, match_id: @match.id), method: :post, local: true do %>
                <div class="row g-2 align-items-end">
                  <div class="col-12 col-md-4">
                    <label class="form-label" style="font-size:12px;">ประเภท</label>
                    <%= select_tag "match_event[event_type]",
                                options_for_select([
                                  ["ใบเหลือง", "yellow_card"],
                                  ["ใบแดง", "red_card"]
                                ]),
                                class: "form-select form-select-sm" %>
                  </div>
                  <div class="col-12 col-md-6">
                    <label class="form-label" style="font-size:12px;">นักเตะ</label>
                    <% home_team_name = @match.home_name %>
                    <% away_team_name = @match.away_name %>
                    <%= select_tag "match_event[tournament_player_id]",
                                grouped_options_for_select({
                                  "ทีมเหย้า (#{home_team_name})" => @home_players.map { |p| [p.full_name, p.id] },
                                  "ทีมเยือน (#{away_team_name})" => @away_players.map { |p| [p.full_name, p.id] }
                                }),
                                include_blank: "-",
                                class: "form-select form-select-sm" %>
                  </div>
                  <div class="col-12 col-md-2 text-end">
                    <%= submit_tag "เพิ่ม", class: "btn btn-sm btn-outline-primary" %>
                  </div>
                </div>
              <% end %>
            <% end %>

            <hr />

            <% visible_events = Array(@match_events).reject { |e| e.event_type == "goal" } %>
            <% if visible_events.any? %>
              <div class="d-flex flex-column" style="gap:8px;">
                <% visible_events.each do |e| %>
                  <% label = case e.event_type
                            when "goal" then "ประตู"
                            when "yellow_card" then "ใบเหลือง"
                            when "red_card" then "ใบแดง"
                            else e.event_type
                            end %>
                  <% team = e.tournament_player&.team_registration&.team %>
                  <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                    <div style="min-width:0;">
                      <div class="d-flex align-items-center" style="gap:8px;">
                        <div style="display:flex;align-items:center;justify-content:center;width:18px;height:18px;flex:0 0 auto;">
                          <% if e.event_type == "goal" %>
                            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                              <circle cx="12" cy="12" r="10" fill="#ffffff" stroke="#111827" stroke-width="1.5"></circle>
                              <path d="M12 6 L16 9 L14.5 14 L9.5 14 L8 9 Z" fill="#111827"></path>
                              <path d="M8 9 L6.5 12 L9.5 14" fill="none" stroke="#111827" stroke-width="1.2"></path>
                              <path d="M16 9 L17.5 12 L14.5 14" fill="none" stroke="#111827" stroke-width="1.2"></path>
                            </svg>
                          <% elsif e.event_type == "yellow_card" %>
                            <div style="width:14px;height:18px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);"></div>
                          <% elsif e.event_type == "red_card" %>
                            <div style="width:14px;height:18px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);"></div>
                          <% end %>
                        </div>
                        <div style="min-width:0;">
                          <div class="fw-bold" style="font-size:13px;"><%= label %></div>
                          <div class="d-flex align-items-center text-muted" style="gap:6px;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <% if team&.logo&.attached? %>
                              <%= image_tag team.logo, style: "width:16px;height:16px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
                            <% end %>
                            <span style="min-width:0;overflow:hidden;text-overflow:ellipsis;"><%= e.tournament_player&.full_name %></span>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div>
                      <% if can_manage_registrations?(@tournament) %>
                        <%= button_to "ลบ",
                                      match_event_tournament_path(@tournament, match_id: @match.id, event_id: e.id),
                                      method: :delete,
                                      class: "btn btn-sm btn-outline-danger" %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-muted" style="font-size:12px;">ยังไม่มีเหตุการณ์</div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
