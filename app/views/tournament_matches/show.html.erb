<% content_for :og_title do %>
  <%= [@match.home_name, "vs", @match.away_name, "·", @tournament.title].join(' ') %>
<% end %>
<% content_for :og_description do %>
  <%= begin
        parts = []
        parts << ("รุ่น #{@match.tournament_division.name}" if @match.tournament_division&.name.present?)
        if @match.group&.name.present?
          parts << "สาย #{@match.group.name}"
        else
          slot = @match.home_slot_label.to_s.presence || @match.away_slot_label.to_s.presence || ""
          inferred = if slot.match?(/\A\d+[A-Za-z]\z/)
                       slot[-1]
                     elsif slot.match?(/\A[A-Za-z]\d+\z/)
                       slot[0]
                     end
          parts << ("สาย #{inferred.to_s.upcase}" if inferred.to_s.present? && !@match.knockout?)
        end
        parts << (@match.kickoff_at.strftime("%d/%m/%Y %H:%M") if @match.kickoff_at.present?)
        if @match.home_score.present? && @match.away_score.present?
          parts << "สกอร์ #{@match.home_score}-#{@match.away_score}"
        end
        parts << @tournament.location_name.presence
        parts.compact.join(" · ")
      rescue
        @tournament.location_name.to_s
      end %>
<% end %>
<% content_for :og_url do %>
  <%= request.original_url %>
<% end %>
<% content_for :og_image do %>
  <%= begin
        if @match.respond_to?(:images) && @match.images.attached?
          rails_blob_url(@match.images.first, host: request.base_url)
        elsif @tournament.respond_to?(:images) && @tournament.images.attached?
          rails_blob_url(@tournament.images.first, host: request.base_url)
        else
          URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
        end
      rescue
        URI.join(request.base_url, asset_path("dernsai_icon.png")).to_s
      end %>
<% end %>

<div class="app-shell">
  <div class="tournament-show-body">
    <div class="container py-2">
      <div class="d-flex justify-content-between align-items-center mb-2" style="gap:8px;">
        <div>
          <div style="font-size:18px;font-weight:bold;">รายละเอียดการแข่งขัน</div>
          <div class="text-muted" style="font-size:13px;">
            <%= @match.tournament_division&.name.present? ? "รุ่น: #{@match.tournament_division.name}" : "-" %>
            <% group_name = @match.group&.name.to_s.presence %>
            <% if group_name.blank? && !@match.knockout? %>
              <% slot = @match.home_slot_label.to_s.presence || @match.away_slot_label.to_s.presence || "" %>
              <% inferred = if slot.match?(/\A\d+[A-Za-z]\z/)
                             slot[-1]
                           elsif slot.match?(/\A[A-Za-z]\d+\z/)
                             slot[0]
                           end %>
              <% group_name = inferred.to_s.upcase.presence %>
            <% end %>
            <% round_code = @match.round_label.to_s.presence %>
            <% round_title = if round_code.present? && @match.knockout?
                               case round_code
                               when "SF" then "รอบ 4 ทีม"
                               when "QF" then "รอบ 8 ทีม"
                               when "R16" then "รอบ 16 ทีม"
                               when "R32" then "รอบ 32 ทีม"
                               when "R64" then "รอบ 64 ทีม"
                               when "FINAL" then "รอบชิงชนะเลิศ"
                               when "3RD" then "ชิงอันดับ 3"
                               else "รอบน็อคเอาท์"
                               end
                             else
                               round_code
                             end %>
            <% group_or_round = group_name.presence || round_title.presence %>
            <% if group_or_round.present? %>
              · สาย: <%= group_or_round %>
            <% end %>
            <% if @match.kickoff_at.present? %>
              · <%= @match.kickoff_at.strftime("%d/%m/%Y %H:%M") %>
            <% end %>
          </div>
        </div>
        <div>
          <%= link_to "กลับ", fixture_tournament_path(@tournament), class: "btn btn-sm btn-outline-secondary" %>
        </div>
      </div>

      <div class="card shadow-sm mb-3">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
            <div style="min-width:0;">
              <div class="fw-bold" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= @match.home_name %></div>
              <div class="text-muted" style="font-size:12px;">ทีมเหย้า</div>
            </div>
            <div class="text-center" style="min-width:120px;">
              <div style="font-size:20px;font-weight:900;">
                <%= @match.home_score.presence || "-" %> - <%= @match.away_score.presence || "-" %>
              </div>
              <div class="text-muted" style="font-size:12px;">สกอร์</div>
            </div>
            <div class="text-end" style="min-width:0;">
              <div class="fw-bold" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= @match.away_name %></div>
              <div class="text-muted" style="font-size:12px;">ทีมเยือน</div>
            </div>
          </div>

          <% home_team = @match.home_team %>
          <% away_team = @match.away_team %>
          <% home_entry_id = @home_entry&.id %>
          <% away_entry_id = @away_entry&.id %>
          <% home_events = (@match_events || []).select { |e| e.tournament_player&.team_registration_id == home_entry_id } %>
          <% away_events = (@match_events || []).select { |e| e.tournament_player&.team_registration_id == away_entry_id } %>
          <% home_groups = home_events.group_by { |e| [e.event_type, e.tournament_player_id] } %>
          <% away_groups = away_events.group_by { |e| [e.event_type, e.tournament_player_id] } %>

          <% if (@match_events || []).any? %>
            <hr />
            <div class="row g-2" style="font-size:12px;">
              <div class="col-6" style="min-width:0;">
                <div class="d-flex flex-column" style="gap:6px;">
                  <% home_groups.each do |(_type, _pid), evs| %>
                    <% e = evs.first %>
                    <% count = evs.size %>
                    <div class="d-flex align-items-center" style="gap:6px;min-width:0;">
                      <div class="d-flex align-items-center" style="gap:2px;flex:0 0 auto;">
                        <% count.times do %>
                          <div style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;">
                            <% if e.event_type == "goal" %>
                              <%= image_tag "football.png", alt: "goal", style: "width:16px;height:16px;object-fit:contain;display:block;" %>
                            <% elsif e.event_type == "yellow_card" %>
                              <div style="width:12px;height:16px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);"></div>
                            <% elsif e.event_type == "red_card" %>
                              <div style="width:12px;height:16px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);"></div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                      <% if home_team&.logo&.attached? %>
                        <%= image_tag home_team.logo, style: "width:14px;height:14px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
                      <% end %>
                      <span style="min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= e.tournament_player&.full_name %></span>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="col-6" style="min-width:0;">
                <div class="d-flex flex-column" style="gap:6px;">
                  <% away_groups.each do |(_type, _pid), evs| %>
                    <% e = evs.first %>
                    <% count = evs.size %>
                    <div class="d-flex align-items-center justify-content-end" style="gap:6px;min-width:0;">
                      <span style="min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= e.tournament_player&.full_name %></span>
                      <% if away_team&.logo&.attached? %>
                        <%= image_tag away_team.logo, style: "width:14px;height:14px;border-radius:999px;object-fit:cover;background:rgba(0,0,0,0.06);flex:0 0 auto;" %>
                      <% end %>
                      <div class="d-flex align-items-center" style="gap:2px;flex:0 0 auto;">
                        <% count.times do %>
                          <div style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;">
                            <% if e.event_type == "goal" %>
                              <%= image_tag "football.png", alt: "goal", style: "width:16px;height:16px;object-fit:contain;display:block;" %>
                            <% elsif e.event_type == "yellow_card" %>
                              <div style="width:12px;height:16px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);"></div>
                            <% elsif e.event_type == "red_card" %>
                              <div style="width:12px;height:16px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);"></div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>

          <% if @match.images.attached? %>
            <hr />
            <div class="row row-cols-2 g-2">
              <% @match.images.first(2).each do |img| %>
                <div class="col">
                  <a href="#"
                     class="d-block js-match-image-lightbox"
                     data-full-url="<%= url_for(img) %>"
                     style="text-decoration:none;">
                    <%= image_tag url_for(img), style: "width:100%;aspect-ratio: 4 / 3;height:auto;object-fit:cover;display:block;border-radius:12px;border:1px solid rgba(0,0,0,0.12);background:rgba(0,0,0,0.04);" %>
                  </a>
                </div>
              <% end %>
            </div>

            <div id="match-image-lightbox" aria-hidden="true" style="position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,0.86);z-index:2000;padding:16px;">
              <button type="button" id="match-image-lightbox-close" aria-label="Close" style="position:absolute;top:12px;right:12px;width:40px;height:40px;border-radius:999px;border:1px solid rgba(255,255,255,0.25);background:rgba(0,0,0,0.35);color:#ffffff;font-size:26px;line-height:36px;display:flex;align-items:center;justify-content:center;">
                ×
              </button>
              <img id="match-image-lightbox-img" alt="match" style="max-width:min(980px, 100%);max-height:86vh;width:auto;height:auto;object-fit:contain;border-radius:14px;background:#000;" />
            </div>

            <script>
              function openMatchLightbox(url) {
                if (!url) return;
                var overlay = document.getElementById("match-image-lightbox");
                var overlayImg = document.getElementById("match-image-lightbox-img");
                if (!overlay || !overlayImg) return;

                overlayImg.src = url;
                overlay.style.display = "flex";
                overlay.setAttribute("aria-hidden", "false");
              }

              function closeMatchLightbox() {
                var overlay = document.getElementById("match-image-lightbox");
                var overlayImg = document.getElementById("match-image-lightbox-img");
                if (!overlay || !overlayImg) return;

                overlay.style.display = "none";
                overlay.setAttribute("aria-hidden", "true");
                overlayImg.removeAttribute("src");
              }

              function initMatchImageLightbox() {
                if (document.documentElement.dataset.matchLightboxBound === "1") return;

                document.addEventListener("click", function(e) {
                  var trigger = e.target.closest && e.target.closest(".js-match-image-lightbox");
                  if (trigger) {
                    e.preventDefault();
                    openMatchLightbox(trigger.getAttribute("data-full-url"));
                    return;
                  }

                  if (e.target && e.target.id === "match-image-lightbox-close") {
                    e.preventDefault();
                    closeMatchLightbox();
                    return;
                  }

                  var overlay = document.getElementById("match-image-lightbox");
                  if (overlay && e.target === overlay) {
                    closeMatchLightbox();
                  }
                });

                document.addEventListener("keydown", function(e) {
                  if (e.key === "Escape") closeMatchLightbox();
                });

                document.addEventListener("turbo:before-cache", function() {
                  closeMatchLightbox();
                });

                document.documentElement.dataset.matchLightboxBound = "1";
              }

              document.addEventListener("turbo:load", initMatchImageLightbox);
              document.addEventListener("DOMContentLoaded", initMatchImageLightbox);
            </script>
          <% end %>

          <% if can_manage_registrations?(@tournament) %>
            <hr />
            <%= form_with url: match_score_tournament_path(@tournament, match_id: @match.id), method: :patch, local: true do %>
              <div class="row g-2 align-items-end">
                <div class="col-6">
                  <label class="form-label" style="font-size:12px;">สกอร์เหย้า</label>
                  <%= select_tag "match[home_score]", options_for_select((0..30).to_a, @match.home_score), include_blank: "-", class: "form-select form-select-sm" %>
                </div>
                <div class="col-6">
                  <label class="form-label" style="font-size:12px;">สกอร์เยือน</label>
                  <%= select_tag "match[away_score]", options_for_select((0..30).to_a, @match.away_score), include_blank: "-", class: "form-select form-select-sm" %>
                </div>
                <div class="col-12 text-end">
                  <%= submit_tag "บันทึกสกอร์", class: "btn btn-sm btn-outline-primary" %>
                </div>
              </div>
            <% end %>

            <hr />
            <%= form_with url: match_images_tournament_path(@tournament, match_id: @match.id), method: :patch, local: true, multipart: true do %>
              <div class="row g-2 align-items-end">
                <div class="col-12">
                  <label class="form-label" style="font-size:12px;">อัปโหลดรูปแมตช์ (ได้สูงสุด 2 รูป)</label>
                  <%= file_field_tag "match[images][]", multiple: true, accept: "image/*", class: "form-control form-control-sm" %>
                  <div class="text-muted" style="font-size:12px;margin-top:4px;">อัปโหลดใหม่จะเป็นการแทนที่รูปเดิม</div>
                </div>
                <div class="col-12 text-end">
                  <%= submit_tag "อัปโหลดรูป", class: "btn btn-sm btn-outline-primary" %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if can_manage_registrations?(@tournament) %>
        <div class="row g-3">
          <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div>
                    <div class="fw-bold">รายชื่อทีมเหย้า</div>
                    <div class="text-muted" style="font-size:12px;">
                      <% if @home_entry.present? %>
                        สถานะ: <%= @home_roster_submitted ? "ส่งแล้ว" : "ยังไม่ส่ง" %>
                      <% else %>
                        ยังไม่สามารถส่งได้ (ยังไม่กำหนดทีม)
                      <% end %>
                    </div>
                  </div>
                </div>

                <% if @home_entry.present? %>
                  <hr />
                  <% if @home_players.any? %>
                    <div class="d-flex flex-column" style="gap:6px;">
                      <% @home_players.each do |p| %>
                        <div style="font-size:13px;"><%= p.full_name %></div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-muted" style="font-size:12px;">ยังไม่มีนักเตะในทีมนี้</div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div>
                    <div class="fw-bold">รายชื่อทีมเยือน</div>
                    <div class="text-muted" style="font-size:12px;">
                      <% if @away_entry.present? %>
                        สถานะ: <%= @away_roster_submitted ? "ส่งแล้ว" : "ยังไม่ส่ง" %>
                      <% else %>
                        ยังไม่สามารถส่งได้ (ยังไม่กำหนดทีม)
                      <% end %>
                    </div>
                  </div>
                </div>

                <% if @away_entry.present? %>
                  <hr />
                  <% if @away_players.any? %>
                    <div class="d-flex flex-column" style="gap:6px;">
                      <% @away_players.each do |p| %>
                        <div style="font-size:13px;"><%= p.full_name %></div>
                      <% end %>
                    </div>
                  <% else %>
                    <div class="text-muted" style="font-size:12px;">ยังไม่มีนักเตะในทีมนี้</div>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <% show_lineups = (@home_lineup&.submitted_at.present? || @away_lineup&.submitted_at.present?) %>
      <% if show_lineups %>
        <div class="row g-3 mt-1">
          <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div>
                    <div class="fw-bold">Line Up ทีมเหย้า</div>
                    <div class="text-muted" style="font-size:12px;">
                      สถานะ:
                      <%= @home_lineup&.submitted_at.present? ? "ส่งแล้ว" : "ยังไม่ส่ง" %>
                      <% if @home_lineup&.submitted_at.present? %>
                        · ส่งล่าสุด <%= @home_lineup.submitted_at.strftime("%d/%m/%Y %H:%M") %>
                      <% end %>
                    </div>
                  </div>
                </div>

                <hr />
                <% home_starters = (@home_lineup_players || []).select { |lp| lp.role == "starter" } %>
                <% if home_starters.any? %>
                  <div class="d-flex flex-column" style="gap:8px;">
                    <% home_starters.each do |lp| %>
                      <% p = lp.tournament_player %>
                      <% next unless p %>
                      <% y = (@yellow_count_by_player_id && @yellow_count_by_player_id[p.id]).to_i %>
                      <% age = if @competition_year.present? && p.birth_date.present?
                                 @competition_year - p.birth_date.year
                               end %>
                      <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                        <div style="min-width:0;">
                          <div style="font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <%= p.full_name %>
                          </div>
                          <div class="text-muted" style="font-size:12px;">
                            (<%= p.jersey_number.presence || "-" %>/<%= age.present? ? age : "-" %>)
                          </div>
                        </div>
                        <% if y > 0 %>
                          <div class="d-flex align-items-center" style="gap:2px;flex:0 0 auto;">
                            <% y.times do %>
                              <span style="width:10px;height:14px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);display:inline-block;"></span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-muted" style="font-size:12px;">ยังไม่มีรายชื่อตัวจริง</div>
                <% end %>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-6">
            <div class="card shadow-sm">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                  <div>
                    <div class="fw-bold">Line Up ทีมเยือน</div>
                    <div class="text-muted" style="font-size:12px;">
                      สถานะ:
                      <%= @away_lineup&.submitted_at.present? ? "ส่งแล้ว" : "ยังไม่ส่ง" %>
                      <% if @away_lineup&.submitted_at.present? %>
                        · ส่งล่าสุด <%= @away_lineup.submitted_at.strftime("%d/%m/%Y %H:%M") %>
                      <% end %>
                    </div>
                  </div>
                </div>

                <hr />
                <% away_starters = (@away_lineup_players || []).select { |lp| lp.role == "starter" } %>
                <% if away_starters.any? %>
                  <div class="d-flex flex-column" style="gap:8px;">
                    <% away_starters.each do |lp| %>
                      <% p = lp.tournament_player %>
                      <% next unless p %>
                      <% y = (@yellow_count_by_player_id && @yellow_count_by_player_id[p.id]).to_i %>
                      <% age = if @competition_year.present? && p.birth_date.present?
                                 @competition_year - p.birth_date.year
                               end %>
                      <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                        <div style="min-width:0;">
                          <div style="font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                            <%= p.full_name %>
                          </div>
                          <div class="text-muted" style="font-size:12px;">
                            (<%= p.jersey_number.presence || "-" %>/<%= age.present? ? age : "-" %>)
                          </div>
                        </div>
                        <% if y > 0 %>
                          <div class="d-flex align-items-center" style="gap:2px;flex:0 0 auto;">
                            <% y.times do %>
                              <span style="width:10px;height:14px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);display:inline-block;"></span>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="text-muted" style="font-size:12px;">ยังไม่มีรายชื่อตัวจริง</div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="card shadow-sm mt-3">
          <div class="card-body">
            <div class="fw-bold mb-1">เหตุการณ์ (Goals / Cards)</div>

            <%= form_with url: match_events_tournament_path(@tournament, match_id: @match.id), method: :post, local: true do %>
              <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                  <label class="form-label" style="font-size:12px;">ประเภท</label>
                  <%= select_tag "match_event[event_type]",
                              options_for_select([
                                ["ประตู", "goal"],
                                ["ใบเหลือง", "yellow_card"],
                                ["ใบแดง", "red_card"]
                              ]),
                              class: "form-select form-select-sm" %>
                </div>
                <div class="col-12 col-md-6">
                  <label class="form-label" style="font-size:12px;">นักเตะ</label>
                  <% home_team_name = @match.home_name %>
                  <% away_team_name = @match.away_name %>
                  <%= select_tag "match_event[tournament_player_id]",
                              grouped_options_for_select({
                                "ทีมเหย้า (#{home_team_name})" => @home_players.map { |p| [p.full_name, p.id] },
                                "ทีมเยือน (#{away_team_name})" => @away_players.map { |p| [p.full_name, p.id] }
                              }),
                              include_blank: "-",
                              class: "form-select form-select-sm" %>
                </div>
                <div class="col-12 col-md-2 text-end">
                  <%= submit_tag "เพิ่ม", class: "btn btn-sm btn-outline-primary" %>
                </div>
              </div>
            <% end %>
            <hr />

            <% if @match_events&.any? %>
              <div class="d-flex flex-column" style="gap:10px;">
                <% @match_events.each do |e| %>
                  <% label = case e.event_type
                            when "goal" then "ประตู"
                            when "yellow_card" then "ใบเหลือง"
                            when "red_card" then "ใบแดง"
                            else e.event_type
                            end %>
                  <% team = e.tournament_player&.team_registration&.team %>
                  <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
                    <div class="d-flex align-items-center" style="gap:8px;min-width:0;">
                      <div style="display:flex;align-items:center;justify-content:center;width:16px;height:16px;flex:0 0 auto;">
                        <% if e.event_type == "goal" %>
                          <%= image_tag "football.png", alt: "goal", style: "width:16px;height:16px;object-fit:contain;display:block;" %>
                        <% elsif e.event_type == "yellow_card" %>
                          <div style="width:12px;height:16px;border-radius:3px;background:#facc15;border:1px solid rgba(0,0,0,0.25);"></div>
                        <% elsif e.event_type == "red_card" %>
                          <div style="width:12px;height:16px;border-radius:3px;background:#ef4444;border:1px solid rgba(0,0,0,0.25);"></div>
                        <% else %>
                          <div style="width:12px;height:12px;border-radius:999px;background:rgba(0,0,0,0.18);"></div>
                        <% end %>
                      </div>

                      <div style="min-width:0;">
                        <div style="font-weight:600;"><%= label %></div>
                        <div class="text-muted" style="font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                          <%= e.tournament_player&.full_name || "-" %>
                          <% if team&.name.present? %>
                            · <%= team.name %>
                          <% end %>
                        </div>
                      </div>
                    </div>

                    <div style="flex:0 0 auto;">
                      <%= button_to "ลบ",
                                    match_event_tournament_path(@tournament, match_id: @match.id, event_id: e.id),
                                    method: :delete,
                                    data: { turbo_confirm: "ลบเหตุการณ์นี้?" },
                                    class: "btn btn-sm btn-outline-danger" %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="text-muted" style="font-size:12px;">ยังไม่มีเหตุการณ์</div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
