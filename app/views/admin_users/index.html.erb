<div class="container py-3">
  <div class="d-flex justify-content-between align-items-center" style="gap:10px;">
    <h1 class="h5 mb-0">จัดการผู้ใช้</h1>
    <%= link_to "กลับหน้าหลัก", root_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>

  <div class="card shadow-sm mt-3">
    <div class="card-body">
      <%= form_with url: admin_users_path, method: :get, local: true do |f| %>
        <div class="d-flex" style="gap:8px;">
          <%= f.select :package,
                options_for_select([["ทุกแพ็กเกจ", ""], ["free", "free"], ["pro", "pro"]], params[:package].to_s),
                {},
                class: "form-select",
                style: "max-width:170px;" %>
          <%= f.text_field :q, value: params[:q], placeholder: "ค้นหา: id / name / username / line_id", class: "form-control" %>
          <%= f.submit "ค้นหา", class: "btn btn-success" %>
        </div>
      <% end %>

      <div class="table-responsive mt-3">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width:70px;">ID</th>
              <th>ชื่อ</th>
              <th style="width:160px;">Username</th>
              <th style="width:160px;">Line ID</th>
              <th style="width:110px;">Package</th>
              <th style="width:120px;"></th>
            </tr>
          </thead>
          <tbody>
            <% @users.each do |u| %>
              <tr>
                <td><%= u.id %></td>
                <td><%= u.name %></td>
                <td><%= u.respond_to?(:username) ? u.username : "-" %></td>
                <td><%= u.respond_to?(:line_id) ? u.line_id : "-" %></td>
                <td><%= u.respond_to?(:package) ? u.package : "-" %></td>
                <td class="text-end">
                  <%= link_to "ตั้งค่า", edit_admin_user_path(u), class: "btn btn-sm btn-outline-primary" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="text-muted" style="font-size:12px;margin-top:8px;">แสดงสูงสุด 200 รายการ</div>
    </div>
  </div>
</div>
